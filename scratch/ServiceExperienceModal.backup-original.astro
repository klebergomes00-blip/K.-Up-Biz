    font-weight: 700;
    letter-spacing: 0.16em;
    cursor: pointer;
    transition: all 0.25s ease;
  }

  .service-close-btn:hover {
    background: rgba(212, 175, 55, 0.15);
    border-color: #D4AF37;
    color: #D4AF37;
    transform: translateY(-1px);
  }

  .service-close-btn:focus-visible {
    outline: 2px solid #D4AF37;
    outline-offset: 2px;
  }

  /* --------------------------------------------------------------------------
     ÁREA DE SCROLL PRÓPRIO
     -------------------------------------------------------------------------- */
  .service-scroll-container {
    flex: 1;
    overflow-y: auto;
    overflow-x: hidden;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    overscroll-behavior: contain;
  }

  /* Custom Scrollbar */
  .service-scroll-container::-webkit-scrollbar {
    width: 6px;
  }
  .service-scroll-container::-webkit-scrollbar-track {
    background: #030D0B;
  }
  .service-scroll-container::-webkit-scrollbar-thumb {
    background: rgba(4, 120, 87, 0.5);
    border-radius: 999px;
  }
  .service-scroll-container::-webkit-scrollbar-thumb:hover {
    background: #D4AF37;
  }

  /* Painéis de Serviço (Alternados via JS) */
  .service-experience-view {
    display: none;
    opacity: 0;
    max-width: 1160px;
    margin: 0 auto;
    padding: clamp(32px, 5vh, 64px) 24px clamp(48px, 6vh, 80px);
    transition: opacity 0.35s ease;
  }

  .service-experience-view.is-active {
    display: block;
    opacity: 1;
  }

  /* --------------------------------------------------------------------------
     ESTILOS DAS CENAS (COMUM A TODOS OS SERVIÇOS)
     -------------------------------------------------------------------------- */
  .svc-scene {
    position: relative;
    padding: clamp(40px, 6vh, 72px) 0;
    border-bottom: 1px solid rgba(245, 241, 232, 0.06);
  }

  .svc-scene:last-of-type {
    border-bottom: none;
  }

  /* Cena 1: Hero do Serviço */
  .svc-hero-scene {
    padding-top: clamp(20px, 3vh, 40px);
    padding-bottom: clamp(48px, 7vh, 84px);
    text-align: left;
  }

  .svc-hero-content {
    max-width: 860px;
  }

  .svc-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 20px;
  }

  .svc-eyebrow-line {
    width: 28px;
    height: 1px;
    background: #D4AF37;
  }

  .svc-eyebrow-text {
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.22em;
    color: #D4AF37;
    text-transform: uppercase;
  }

  .svc-headline {
    margin: 0 0 24px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-family: var(--font-sans);
    font-size: clamp(2.2rem, 4.4vw, 3.8rem);
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.025em;
    color: var(--color-marfim);
  }

  .svc-headline-gold {
    font-family: var(--font-serif);
    color: #D4AF37;
    font-size: 1.08em;
    font-style: italic;
    font-weight: 400;
  }

  .svc-lead {
    margin: 0 0 32px;
    font-family: var(--font-sans);
    font-size: clamp(1.05rem, 1.35vw, 1.25rem);
    line-height: 1.75;
    color: rgba(245, 241, 232, 0.78);
    max-width: 720px;
  }

  .svc-hero-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .svc-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 7px 16px;
    border-radius: 999px;
    background: rgba(4, 120, 87, 0.12);
    border: 1px solid rgba(4, 120, 87, 0.35);
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 600;
    color: var(--color-marfim);
    letter-spacing: 0.04em;
  }

  /* Cabeçalho de Cena */
  .svc-section-header {
    margin-bottom: clamp(32px, 5vh, 48px);
    max-width: 760px;
  }

  .svc-section-tag {
    display: inline-block;
    font-family: var(--font-sans);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.2em;
    color: #D4AF37;
    margin-bottom: 12px;
  }

  .svc-section-title {
    margin: 0 0 14px;
    font-family: var(--font-sans);
    font-size: clamp(1.6rem, 2.8vw, 2.4rem);
    font-weight: 600;
    line-height: 1.2;
    color: var(--color-marfim);
    letter-spacing: -0.015em;
  }

  .svc-section-desc {
    margin: 0;
    font-family: var(--font-sans);
    font-size: clamp(0.98rem, 1.15vw, 1.12rem);
    line-height: 1.7;
    color: rgba(245, 241, 232, 0.72);
  }

  /* --------------------------------------------------------------------------
     GRÁFICO EDITORIAL DE COMPARAÇÃO (WEB)
     -------------------------------------------------------------------------- */
  .web-evolution-graphic {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 24px;
    align-items: center;
    margin-top: 16px;
  }

  .graphic-comparison-card {
    background: rgba(245, 241, 232, 0.02);
    border: 1px solid rgba(245, 241, 232, 0.08);
    border-radius: 16px;
    padding: 24px;
    box-shadow: 0 16px 36px rgba(0, 0, 0, 0.5);
    position: relative;
    overflow: hidden;
  }

  .card-before {
    border-color: rgba(234, 67, 53, 0.2);
    background: linear-gradient(180deg, rgba(234, 67, 53, 0.04) 0%, rgba(3, 13, 11, 0.6) 100%);
  }

  .card-after {
    border-color: rgba(212, 175, 55, 0.35);
    background: linear-gradient(180deg, rgba(4, 120, 87, 0.12) 0%, rgba(3, 13, 11, 0.7) 100%);
    box-shadow: 0 20px 48px rgba(0, 0, 0, 0.6), 0 0 32px rgba(4, 120, 87, 0.15);
  }

  .graphic-card-header {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 20px;
  }

  .status-indicator {
    width: 8px;
    height: 8px;
    border-radius: 50%;
  }

  .status-warning {
    background: #EA4335;
    box-shadow: 0 0 8px rgba(234, 67, 53, 0.8);
  }

  .status-success {
    background: #2EE59D;
    box-shadow: 0 0 10px rgba(46, 229, 157, 0.8);
  }

  .graphic-card-label {
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.14em;
    color: var(--color-marfim);
  }

  .mockup-wireframe-bad {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .wireframe-bar {
    height: 8px;
    border-radius: 4px;
    background: rgba(245, 241, 232, 0.12);
  }
  .wireframe-w40 { width: 40%; }
  .wireframe-w50 { width: 50%; }
  .wireframe-w70 { width: 70%; }

  .wireframe-bad-hero {
    height: 100px;
    border-radius: 8px;
    background: rgba(245, 241, 232, 0.04);
    border: 1px dashed rgba(245, 241, 232, 0.15);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 12px;
    color: rgba(245, 241, 232, 0.4);
    font-family: var(--font-sans);
  }

  .wireframe-warning-note {
    margin-top: 8px;
    padding: 12px;
    border-radius: 8px;
    background: rgba(234, 67, 53, 0.08);
    border-left: 2px solid #EA4335;
    font-size: 11px;
    line-height: 1.5;
    color: rgba(245, 241, 232, 0.7);
    font-style: italic;
  }

  .mockup-wireframe-good {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .wireframe-good-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .dot-brand {
    width: 20px;
    height: 20px;
    border-radius: 4px;
    background: linear-gradient(135deg, #047857, #D4AF37);
  }

  .wireframe-nav-dots span {
    display: inline-block;
    width: 16px;
    height: 4px;
    border-radius: 2px;
    background: rgba(245, 241, 232, 0.2);
    margin-left: 4px;
  }

  .wireframe-good-hero {
    padding: 20px 16px;
    border-radius: 10px;
    background: linear-gradient(135deg, rgba(4, 120, 87, 0.25), rgba(3, 13, 11, 0.8));
    border: 1px solid rgba(212, 175, 55, 0.25);
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
  }

  .hero-tag-gold {
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.18em;
    color: #D4AF37;
  }

  .hero-good-title {
    font-size: 14px;
    font-weight: 600;
    color: var(--color-marfim);
  }

  .hero-good-cta {
    margin-top: 4px;
    padding: 5px 12px;
    border-radius: 999px;
    background: #D4AF37;
    color: #030D0B;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.1em;
  }

  .wireframe-good-features {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
  }

  .good-feat {
    padding: 4px 8px;
    border-radius: 4px;
    background: rgba(4, 120, 87, 0.2);
    font-size: 10px;
    color: #2EE59D;
    font-weight: 500;
  }

  .graphic-arrow-transition {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
  }

  .arrow-tag {
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.16em;
    color: #D4AF37;
  }

  /* --------------------------------------------------------------------------
     PILARES DA SOLUÇÃO (GRID EDITORIAL)
     -------------------------------------------------------------------------- */
  .svc-pillars-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
  }

  .pillar-card {
    background: rgba(245, 241, 232, 0.025);
    border: 1px solid rgba(245, 241, 232, 0.08);
    border-radius: 16px;
    padding: clamp(24px, 3.5vw, 32px);
    transition: all 0.3s ease;
    position: relative;
    overflow: hidden;
  }

  .pillar-card:hover {
    border-color: rgba(212, 175, 55, 0.35);
    background: rgba(245, 241, 232, 0.04);
    transform: translateY(-2px);
  }

  .pillar-wide {
    grid-column: 1 / -1;
  }

  .pillar-number {
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 700;
    color: #D4AF37;
    letter-spacing: 0.14em;
    margin-bottom: 14px;
  }

  .pillar-icon-wrap {
    width: 44px;
    height: 44px;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 18px;
  }

  .icon-cyan {
    background: rgba(0, 209, 255, 0.1);
    color: #00D1FF;
    border: 1px solid rgba(0, 209, 255, 0.25);
  }

  .icon-gold {
    background: rgba(212, 175, 55, 0.12);
    color: #D4AF37;
    border: 1px solid rgba(212, 175, 55, 0.3);
  }

  .icon-emerald {
    background: rgba(4, 120, 87, 0.2);
    color: #2EE59D;
    border: 1px solid rgba(4, 120, 87, 0.4);
  }

  .pillar-title {
    margin: 0 0 10px;
    font-family: var(--font-sans);
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--color-marfim);
  }

  .pillar-text {
    margin: 0;
    font-family: var(--font-sans);
    font-size: 0.95rem;
    line-height: 1.65;
    color: rgba(245, 241, 232, 0.7);
  }

  /* --------------------------------------------------------------------------
     PROJETOS REAIS (CONTEXTO WEB)
     -------------------------------------------------------------------------- */
  .projects-context-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }

  .context-project-card {
    background: rgba(245, 241, 232, 0.025);
    border: 1px solid rgba(245, 241, 232, 0.08);
    border-radius: 16px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: all 0.3s ease;
  }

  .context-project-card:hover {
    border-color: rgba(212, 175, 55, 0.4);
    transform: translateY(-4px);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.7);
  }

  .project-thumb-frame {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: #020807;
  }

  .project-thumb-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    transition: transform 0.6s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .context-project-card:hover .project-thumb-img {
    transform: scale(1.05);
  }

  .project-thumb-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 40%, rgba(3, 13, 11, 0.8) 100%);
  }

  .project-card-body {
    padding: 20px;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .project-tag {
    font-family: var(--font-sans);
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.16em;
    color: #D4AF37;
    margin-bottom: 8px;
  }

  .project-name {
    margin: 0 0 10px;
    font-family: var(--font-sans);
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--color-marfim);
  }

  .project-summary {
    margin: 0 0 20px;
    font-family: var(--font-sans);
    font-size: 0.88rem;
    line-height: 1.6;
    color: rgba(245, 241, 232, 0.68);
    flex: 1;
  }

  .project-ext-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: #D4AF37;
    text-decoration: none;
    transition: gap 0.2s ease, color 0.2s ease;
    align-self: flex-start;
  }

  .project-ext-link:hover {
    color: var(--color-marfim);
    gap: 9px;
  }

  /* --------------------------------------------------------------------------
     SIMULADOR DE BUSCA LOCAL (LOCAL)
     -------------------------------------------------------------------------- */
  .local-search-simulator {
    background: rgba(245, 241, 232, 0.025);
    border: 1px solid rgba(245, 241, 232, 0.09);
    border-radius: 20px;
    padding: clamp(20px, 3.5vw, 32px);
    box-shadow: 0 24px 48px rgba(0, 0, 0, 0.6);
  }

  .search-sim-bar {
    display: flex;
    align-items: center;
    gap: 14px;
    background: rgba(3, 13, 11, 0.8);
    border: 1px solid rgba(245, 241, 232, 0.14);
    border-radius: 999px;
    padding: 10px 18px;
    margin-bottom: 24px;
    flex-wrap: wrap;
  }

  .search-input-sim {
    flex: 1;
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 500;
    color: var(--color-marfim);
    min-width: 180px;
  }

  .search-action-pills {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
  }

  .sim-chip {
    padding: 5px 12px;
    border-radius: 999px;
    background: rgba(245, 241, 232, 0.05);
    border: 1px solid rgba(245, 241, 232, 0.1);
    color: rgba(245, 241, 232, 0.7);
    font-family: var(--font-sans);
    font-size: 10px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .sim-chip:hover {
    color: var(--color-marfim);
    border-color: rgba(212, 175, 55, 0.4);
  }

  .sim-chip.is-active {
    background: rgba(212, 175, 55, 0.15);
    border-color: #D4AF37;
    color: #D4AF37;
  }

  .local-result-card {
    background: linear-gradient(135deg, rgba(4, 120, 87, 0.1) 0%, rgba(3, 13, 11, 0.6) 100%);
    border: 1px solid rgba(212, 175, 55, 0.25);
    border-radius: 16px;
    padding: 24px;
  }

  .result-header-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 20px;
    gap: 16px;
    flex-wrap: wrap;
  }

  .result-badge-verified {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.14em;
    color: #2EE59D;
    margin-bottom: 6px;
  }

  .result-company-title {
    margin: 0 0 6px;
    font-family: var(--font-sans);
    font-size: 1.35rem;
    font-weight: 600;
    color: var(--color-marfim);
  }

  .result-rating-row {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 12px;
  }

  .rating-number {
    font-weight: 700;
    color: #D4AF37;
  }

  .rating-stars {
    color: #D4AF37;
    letter-spacing: 2px;
  }

  .rating-count {
    color: rgba(245, 241, 232, 0.6);
  }

  .result-category-chip {
    padding: 6px 12px;
    border-radius: 999px;
    background: rgba(212, 175, 55, 0.12);
    border: 1px solid rgba(212, 175, 55, 0.3);
    font-size: 10px;
    font-weight: 600;
    color: #D4AF37;
    letter-spacing: 0.08em;
  }

  .result-meta-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
    margin-bottom: 24px;
    font-size: 12px;
    color: rgba(245, 241, 232, 0.8);
  }

  .meta-item {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .text-open-now {
    color: #2EE59D;
    font-weight: 600;
  }

  .result-buttons-row {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }

  .btn-fake-gmaps {
    padding: 7px 16px;
    border-radius: 999px;
    background: rgba(245, 241, 232, 0.06);
    border: 1px solid rgba(245, 241, 232, 0.15);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: var(--color-marfim);
  }

  /* Banner de Clareza Ética */
  .ethical-clarity-banner {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    margin-top: 28px;
    padding: 18px 22px;
    border-radius: 12px;
    background: rgba(245, 241, 232, 0.02);
    border: 1px solid rgba(245, 241, 232, 0.08);
  }

  .clarity-icon {
    font-size: 18px;
    flex-shrink: 0;
  }

  .clarity-text {
    margin: 0;
    font-family: var(--font-sans);
    font-size: 0.88rem;
    line-height: 1.6;
    color: rgba(245, 241, 232, 0.68);
  }

  .clarity-text strong {
    color: #D4AF37;
  }

  /* --------------------------------------------------------------------------
     FLUXO DE TRABALHO EM ETAPAS (WORKFLOW)
     -------------------------------------------------------------------------- */
  .workflow-steps-track {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }

  .workflow-step-node {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .step-badge-num {
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 700;
    color: #D4AF37;
    letter-spacing: 0.15em;
  }

  .step-card-box {
    background: rgba(245, 241, 232, 0.025);
    border: 1px solid rgba(245, 241, 232, 0.08);
    border-radius: 14px;
    padding: 20px;
    height: 100%;
    display: flex;
    flex-direction: column;
    transition: all 0.3s ease;
  }

  .step-card-box:hover {
    border-color: rgba(212, 175, 55, 0.35);
    background: rgba(245, 241, 232, 0.04);
  }

  .step-action-label {
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.18em;
    color: #2EE59D;
    margin-bottom: 8px;
  }

  .step-box-title {
    margin: 0 0 10px;
    font-family: var(--font-sans);
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--color-marfim);
  }

  .step-box-desc {
    margin: 0;
    font-family: var(--font-sans);
    font-size: 0.88rem;
    line-height: 1.6;
    color: rgba(245, 241, 232, 0.65);
  }

  /* --------------------------------------------------------------------------
     DIAGRAMA DE GESTÃO DE TRÁFEGO (REACH)
     -------------------------------------------------------------------------- */
  .reach-diagram-container {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 24px;
    align-items: center;
  }

  .reach-comparison-col {
    background: rgba(245, 241, 232, 0.025);
    border: 1px solid rgba(245, 241, 232, 0.08);
    border-radius: 16px;
    padding: 24px;
  }

  .col-unfocused {
    border-color: rgba(245, 241, 232, 0.08);
  }

  .col-focused {
    border-color: rgba(212, 175, 55, 0.35);
    background: linear-gradient(180deg, rgba(4, 120, 87, 0.12) 0%, rgba(3, 13, 11, 0.7) 100%);
    box-shadow: 0 20px 48px rgba(0, 0, 0, 0.6);
  }

  .diagram-tag {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.16em;
    margin-bottom: 16px;
  }

  .tag-muted { color: rgba(245, 241, 232, 0.5); }
  .tag-gold { color: #D4AF37; }

  .diagram-illustration {
    height: 120px;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    margin-bottom: 20px;
  }

  .ill-dispersed {
    background: rgba(245, 241, 232, 0.02);
    border: 1px dashed rgba(245, 241, 232, 0.12);
  }

  .dispersed-center {
    font-size: 11px;
    color: rgba(245, 241, 232, 0.4);
  }

