---
// src/components/ServiceExperienceModal.astro
// K. UP BIZ — EXPERIÊNCIA IMERSIVA EM SERVIÇOS (DIGITAL SHELF EXPANSION)
// Experiência editorial completa em fullscreen para WEB, LOCAL e REACH.

// Configuração do WhatsApp K. Up Biz
// Número comercial oficial pode ser inserido aqui no formato internacional (ex: '5538999999999')
// Se estiver vazio, a URL padrão do WhatsApp abre o chat com a mensagem pronta para envio.
const WHATSAPP_PHONE = '';

function getWhatsAppUrl(message: string): string {
  const encoded = encodeURIComponent(message);
  return WHATSAPP_PHONE
    ? `https://wa.me/${WHATSAPP_PHONE}?text=${encoded}`
    : `https://api.whatsapp.com/send?text=${encoded}`;
}

const ctaWebUrl = getWhatsAppUrl("Olá! Conheci a K. Up Biz e gostaria de conversar sobre a criação de um site profissional.");
const ctaLocalUrl = getWhatsAppUrl("Olá! Gostaria de saber mais sobre a otimização do Perfil da Empresa no Google pela K. Up Biz.");
const ctaReachUrl = getWhatsAppUrl("Olá! Gostaria de conversar sobre gestão de tráfego pago com a K. Up Biz.");
---

<!-- ========================================================================
     OVERLAY MODAL FULLSCREEN: EXPERIÊNCIAS IMERSIVAS DE SERVIÇOS
     ======================================================================== -->
<div
  class="shelf-service-modal"
  id="shelf-service-modal"
  role="dialog"
  aria-modal="true"
  aria-hidden="true"
  aria-labelledby="active-service-badge"
  tabindex="-1"
>
  <!-- Backdrop Escuro com Efeito de Vidro Fosco -->
  <div class="service-modal-backdrop" id="service-modal-backdrop"></div>

  <!-- Contêiner Viewport com Rolagem Interna Natural -->
  <div class="service-modal-viewport" id="service-modal-viewport">
    
    <!-- Topbar Fixa / Sticky: Identificador, Navegação entre Serviços e Fechar -->
    <header class="service-modal-header" id="service-modal-header">
      <div class="header-inner-row">
        <!-- Lado Esquerdo: Identificação do Serviço Ativo -->
        <div class="service-active-identity">
          <span class="identity-dot" aria-hidden="true"></span>
          <span class="identity-badge" id="active-service-badge">01 / CRIAÇÃO DE SITES</span>
        </div>

        <!-- Centro: Marca K. Up Biz e Seletor Discreto de Serviços -->
        <nav class="service-tabs-nav" aria-label="Navegação entre experiências de serviço">
          <button
            type="button"
            class="service-tab-btn is-active"
            data-target="web"
            id="tab-btn-web"
            aria-selected="true"
            role="tab"
          >
            <span class="tab-index">01</span>
            <span class="tab-label">WEB</span>
          </button>
          <button
            type="button"
            class="service-tab-btn"
            data-target="local"
            id="tab-btn-local"
            aria-selected="false"
            role="tab"
          >
            <span class="tab-index">02</span>
            <span class="tab-label">LOCAL</span>
          </button>
          <button
            type="button"
            class="service-tab-btn"
            data-target="reach"
            id="tab-btn-reach"
            aria-selected="false"
            role="tab"
          >
            <span class="tab-index">03</span>
            <span class="tab-label">REACH</span>
          </button>
        </nav>

        <!-- Lado Direito: Botão Fechar Retornando à Prateleira -->
        <div class="service-header-actions">
          <button
            type="button"
            class="service-close-btn"
            id="service-modal-close-btn"
            aria-label="Fechar experiência do serviço e voltar à prateleira"
          >
            <span class="close-text">FECHAR</span>
            <span class="close-cross" aria-hidden="true">
              <svg fill="none" height="14" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" viewBox="0 0 24 24" width="14">
                <path d="M18 6 6 18"></path>
                <path d="m6 6 12 12"></path>
              </svg>
            </span>
          </button>
        </div>
      </div>
    </header>

    <!-- Superfície de Conteúdo com Scroll Próprio -->
    <div class="service-scroll-container" id="service-scroll-container">
      
      <!-- ==================================================================
           01. EXPERIÊNCIA WEB: CRIAÇÃO DE SITES E LANDING PAGES
           ================================================================== -->
      <article
        class="service-experience-view is-active"
        id="service-view-web"
        data-service="web"
        role="tabpanel"
        aria-label="Criação de Sites e Landing Pages"
      >
        <!-- Cena 1: Abertura Hero -->
        <section class="svc-scene svc-hero-scene">
          <div class="svc-hero-content">
            <div class="svc-eyebrow">
              <span class="svc-eyebrow-line" aria-hidden="true"></span>
              <span class="svc-eyebrow-text">01 / CRIAÇÃO DE SITES</span>
            </div>

            <h2 class="svc-headline">
              <span class="svc-headline-main">Seu negócio merece mais do que estar online.</span>
              <span class="svc-headline-gold italic-serif">Merece uma presença que impressiona.</span>
            </h2>

            <p class="svc-lead">
              Desenvolvemos sites e landing pages que unem identidade, tecnologia e estratégia para apresentar sua empresa com profissionalismo e facilitar o contato com novos clientes.
            </p>

            <div class="svc-hero-pills">
              <span class="svc-pill">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#D4AF37" stroke-width="2"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                Arquitetura Exclusiva
              </span>
              <span class="svc-pill">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#00D1FF" stroke-width="2"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
                Velocidade Ultrarrápida
              </span>
              <span class="svc-pill">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#2EE59D" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                Foco em Conversão
              </span>
            </div>
          </div>
        </section>

        <!-- Cena 2: O Problema (Pesquisa e Comparação) -->
        <section class="svc-scene svc-problem-scene">
          <div class="svc-section-header">
            <span class="svc-section-tag">CENA 02 — O CENÁRIO REAL</span>
            <h3 class="svc-section-title">Seu cliente pesquisa antes de escolher.</h3>
            <p class="svc-section-desc">
              Antes de entrar em contato, muitas pessoas procuram informações, analisam a apresentação da empresa e comparam alternativas. Um site bem estruturado ajuda sua marca a transmitir confiança nesse momento.
            </p>
          </div>

          <!-- Composição Gráfica Editorial de Comparação -->
          <div class="web-evolution-graphic">
            <div class="graphic-comparison-card card-before">
              <div class="graphic-card-header">
                <span class="status-indicator status-warning"></span>
                <span class="graphic-card-label">PRESENÇA IMPROVISADA</span>
              </div>
              <div class="mockup-wireframe-bad">
                <div class="wireframe-bar wireframe-w40"></div>
                <div class="wireframe-block wireframe-bad-hero">
                  <span>Layout genérico & confuso</span>
                </div>
                <div class="wireframe-row">
                  <div class="wireframe-bar wireframe-w70"></div>
                  <div class="wireframe-bar wireframe-w50"></div>
                </div>
                <div class="wireframe-warning-note">
                  "Sem domínio próprio, lentidão no celular e botões quebrados geram desconfiança imediata."
                </div>
              </div>
            </div>

            <div class="graphic-arrow-transition" aria-hidden="true">
              <span class="arrow-glow"></span>
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#D4AF37" stroke-width="2">
                <path d="M5 12h14"></path>
                <path d="m12 5 7 7-7 7"></path>
              </svg>
              <span class="arrow-tag">TRANSFORMAÇÃO</span>
            </div>

            <div class="graphic-comparison-card card-after">
              <div class="graphic-card-header">
                <span class="status-indicator status-success"></span>
                <span class="graphic-card-label">PADRÃO K. UP BIZ</span>
              </div>
              <div class="mockup-wireframe-good">
                <div class="wireframe-good-header">
                  <div class="dot-brand"></div>
                  <div class="wireframe-nav-dots">
                    <span></span><span></span><span></span>
                  </div>
                </div>
                <div class="wireframe-good-hero">
                  <div class="hero-tag-gold">ALTO PADRÃO VISUAL</div>
                  <div class="hero-good-title">Identidade Forte & Conexão Direta</div>
                  <div class="hero-good-cta">SOLICITAR ATENDIMENTO ↗</div>
                </div>
                <div class="wireframe-good-features">
                  <span class="good-feat">Design sob medida</span>
                  <span class="good-feat">Carregamento instantâneo</span>
                  <span class="good-feat">WhatsApp integrado</span>
                </div>
              </div>
            </div>
          </div>
        </section>

        <!-- Cena 3: A Solução (Design que valoriza. Estrutura que orienta.) -->
        <section class="svc-scene svc-solution-scene">
          <div class="svc-section-header">
            <span class="svc-section-tag">CENA 03 — A SOLUÇÃO</span>
            <h3 class="svc-section-title">Design que valoriza. Estrutura que orienta.</h3>
            <p class="svc-section-desc">
              Não construímos páginas genéricas. Cada detalhe é desenhado para guiar a atenção do visitante e valorizar o posicionamento da sua marca.
            </p>
          </div>

          <!-- Quatro Diferenciais Editoriais -->
          <div class="svc-pillars-grid">
            <div class="pillar-card">
              <div class="pillar-number">01</div>
              <div class="pillar-icon-wrap icon-cyan">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                  <line x1="3" y1="9" x2="21" y2="9"></line>
                  <line x1="9" y1="21" x2="9" y2="9"></line>
                </svg>
              </div>
              <h4 class="pillar-title">Layout Personalizado</h4>
              <p class="pillar-text">
                Composição visual autoral, tipografia sofisticada e acabamento que reflete a autoridade real da sua empresa.
              </p>
            </div>

            <div class="pillar-card">
              <div class="pillar-number">02</div>
              <div class="pillar-icon-wrap icon-gold">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <rect x="5" y="2" width="14" height="20" rx="2" ry="2"></rect>
                  <line x1="12" y1="18" x2="12.01" y2="18"></line>
                </svg>
              </div>
              <h4 class="pillar-title">Experiência Responsiva</h4>
              <p class="pillar-text">
                Navegação impecável e leitura confortável em smartphones, tablets, laptops e monitores de alta resolução.
              </p>
            </div>

            <div class="pillar-card">
              <div class="pillar-number">03</div>
              <div class="pillar-icon-wrap icon-emerald">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <line x1="8" y1="6" x2="21" y2="6"></line>
                  <line x1="8" y1="12" x2="21" y2="12"></line>
                  <line x1="8" y1="18" x2="21" y2="18"></line>
                  <line x1="3" y1="6" x2="3.01" y2="6"></line>
                  <line x1="3" y1="12" x2="3.01" y2="12"></line>
                  <line x1="3" y1="18" x2="3.01" y2="18"></line>
                </svg>
              </div>
              <h4 class="pillar-title">Organização Estratégica</h4>
              <p class="pillar-text">
                Estruturação lógica de informações que responde dúvidas críticas do cliente e reduz atritos na decisão.
              </p>
            </div>

            <div class="pillar-card">
              <div class="pillar-number">04</div>
              <div class="pillar-icon-wrap icon-gold">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
                </svg>
              </div>
              <h4 class="pillar-title">Canais de Contato Integrados</h4>
              <p class="pillar-text">
                Chamadas diretas para WhatsApp, telefone e canais comerciais estrategicamente posicionados.
              </p>
            </div>
          </div>
        </section>

        <!-- Cena 4: Projetos Reais (Mostra Contextual de Portfólio) -->
        <section class="svc-scene svc-projects-scene">
          <div class="svc-section-header">
            <span class="svc-section-tag">CENA 04 — PROJETOS REAIS</span>
            <h3 class="svc-section-title">Trabalhos reais desenvolvidos pela K. Up Biz</h3>
            <p class="svc-section-desc">
              Uma demonstração prática de sites construídos com foco em elegância, performance e clareza comercial.
            </p>
          </div>

          <div class="projects-context-grid">
            <!-- Projeto 1: Fernando Junior Corretor -->
            <div class="context-project-card">
              <div class="project-thumb-frame">
                <img
                  src="/imagens/portfolio/fernando-junior.webp"
                  alt="Site Fernando Junior Corretor de Imóveis"
                  class="project-thumb-img"
                  loading="lazy"
                  decoding="async"
                />
                <div class="project-thumb-overlay"></div>
              </div>
              <div class="project-card-body">
                <span class="project-tag">IMOBILIÁRIO & ALTO PADRÃO</span>
                <h4 class="project-name">Fernando Junior Corretor</h4>
                <p class="project-summary">
                  Plataforma exclusiva para apresentação de imóveis selecionados com experiência visual imersiva e captação direta de investidores.
                </p>
                <a
                  href="https://fernandocorretor-six.vercel.app/"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="project-ext-link"
                >
                  <span>VER PROJETO</span>
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M7 17 17 7"></path><path d="M8 7h9v9"></path></svg>
                </a>
              </div>
            </div>

            <!-- Projeto 2: Level Up Aesthetics -->
            <div class="context-project-card">
              <div class="project-thumb-frame">
                <img
                  src="/imagens/portfolio/level-up-aesthetics.webp"
                  alt="Site Clínica Estética Level Up"
                  class="project-thumb-img"
                  loading="lazy"
                  decoding="async"
                />
                <div class="project-thumb-overlay"></div>
              </div>
              <div class="project-card-body">
                <span class="project-tag">SAÚDE & BEM-ESTAR PREMIUM</span>
                <h4 class="project-name">Clínica de Estética Level Up</h4>
                <p class="project-summary">
                  Ambiente digital sofisticado que detalha procedimentos clínicos, corpo técnico e canal de agendamento ágil.
                </p>
                <a
                  href="https://clinicaestetica-xi.vercel.app/"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="project-ext-link"
                >
                  <span>VER PROJETO</span>
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M7 17 17 7"></path><path d="M8 7h9v9"></path></svg>
                </a>
              </div>
            </div>

            <!-- Projeto 3: Styvi Burguer -->
            <div class="context-project-card">
              <div class="project-thumb-frame">
                <img
                  src="/imagens/portfolio/styvy-burguer.webp"
                  alt="Site Styvi Burguer Gastronomia"
                  class="project-thumb-img"
                  loading="lazy"
                  decoding="async"
                />
                <div class="project-thumb-overlay"></div>
              </div>
              <div class="project-card-body">
                <span class="project-tag">GASTRONOMIA & DELIVERY</span>
                <h4 class="project-name">Styvi Burguer</h4>
                <p class="project-summary">
                  Cardápio digital ágil e visualmente apetitoso com arquitetura voltada para conversão de pedidos em dispositivos móveis.
                </p>
                <a
                  href="https://styviburguer.vercel.app/"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="project-ext-link"
                >
                  <span>VER PROJETO</span>
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M7 17 17 7"></path><path d="M8 7h9v9"></path></svg>
                </a>
              </div>
            </div>
          </div>
        </section>

        <!-- Cena 5: CTA de Fechamento -->
        <section class="svc-scene svc-cta-scene">
          <div class="svc-cta-box cta-theme-web">
            <div class="cta-glow-aura" aria-hidden="true"></div>
            <span class="cta-pre-label">PRÓXIMO PASSO</span>
            <h3 class="cta-headline">Vamos criar uma presença à altura do seu negócio?</h3>
            <p class="cta-subtext">
              Converse com a K. Up Biz e descubra como uma presença digital profissional pode impulsionar suas oportunidades.
            </p>
            <a
              href={ctaWebUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="svc-cta-button btn-gold-shimmer"
              id="cta-btn-web"
            >
              <span>SOLICITAR UMA PROPOSTA</span>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M7 17 17 7"></path><path d="M8 7h9v9"></path></svg>
            </a>
          </div>
        </section>
      </article>

      <!-- ==================================================================
           02. EXPERIÊNCIA LOCAL: GOOGLE MEU NEGÓCIO / PERFIL DA EMPRESA
           ================================================================== -->
      <article
        class="service-experience-view"
        id="service-view-local"
        data-service="local"
        role="tabpanel"
        aria-label="Google Meu Negócio e Presença Local"
      >
        <!-- Cena 1: Abertura Hero -->
        <section class="svc-scene svc-hero-scene">
          <div class="svc-hero-content">
            <div class="svc-eyebrow">
              <span class="svc-eyebrow-line" aria-hidden="true"></span>
              <span class="svc-eyebrow-text">02 / PRESENÇA LOCAL</span>
            </div>

            <h2 class="svc-headline">
              <span class="svc-headline-main">Seu cliente está procurando.</span>
              <span class="svc-headline-gold italic-serif">Sua empresa está preparada para ser encontrada?</span>
            </h2>

            <p class="svc-lead">
              Trabalhamos a apresentação e a otimização do Perfil da Empresa no Google para facilitar que clientes encontrem informações importantes sobre o seu negócio na Busca e no Maps.
            </p>

            <div class="svc-hero-pills">
              <span class="svc-pill">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#D4AF37" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
                Google Maps & Busca
              </span>
              <span class="svc-pill">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#2EE59D" stroke-width="2"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                Avaliações Estruturadas
              </span>
              <span class="svc-pill">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#00D1FF" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
                Informações Atualizadas
              </span>
            </div>
          </div>
        </section>

        <!-- Cena 2: A Busca Local (Simulador Gráfico Interativo de Pesquisa) -->
        <section class="svc-scene svc-problem-scene">
          <div class="svc-section-header">
            <span class="svc-section-tag">CENA 02 — A BUSCA LOCAL</span>
            <h3 class="svc-section-title">Onde a decisão de compra começa.</h3>
            <p class="svc-section-desc">
              Quando alguém precisa de um produto ou serviço próximo, a primeira ação é abrir o Google. Veja exemplos ilustrativos de buscas cotidianas:
            </p>
          </div>

          <!-- Simulador de Busca Google Local -->
          <div class="local-search-simulator">
            <div class="search-sim-bar">
              <div class="google-g-icon" aria-hidden="true">
                <svg width="20" height="20" viewBox="0 0 24 24">
                  <path fill="#4285F4" d="M23.745 12.27c0-.7-.06-1.4-.19-2.07H12v4.51h6.6c-.29 1.52-1.14 2.82-2.4 3.68v3.05h3.88c2.27-2.09 3.66-5.17 3.66-9.17z"/>
                  <path fill="#34A853" d="M12 24c3.24 0 5.95-1.08 7.93-2.91l-3.88-3.05c-1.08.72-2.45 1.16-4.05 1.16-3.12 0-5.77-2.1-6.72-4.93H1.25v3.15C3.26 21.36 7.34 24 12 24z"/>
                  <path fill="#FBBC05" d="M5.28 14.27c-.25-.72-.38-1.49-.38-2.27s.13-1.55.38-2.27V6.58H1.25C.45 8.18 0 9.98 0 12s.45 3.82 1.25 5.42l4.03-3.15z"/>
                  <path fill="#EA4335" d="M12 4.75c1.77 0 3.35.61 4.6 1.8l3.42-3.42C17.95 1.19 15.24 0 12 0 7.34 0 3.26 2.64 1.25 6.58l4.03 3.15c.95-2.83 3.6-4.98 6.72-4.98z"/>
                </svg>
              </div>
              <div class="search-input-sim" id="sim-query-text">
                "clínica de estética perto de mim"
              </div>
              <div class="search-action-pills">
                <button type="button" class="sim-chip is-active" data-query="clínica de estética perto de mim">Estética</button>
                <button type="button" class="sim-chip" data-query="hamburgueria na minha região">Hamburgueria</button>
                <button type="button" class="sim-chip" data-query="serviços profissionais em Unaí">Serviços em Unaí</button>
              </div>
            </div>

            <!-- Card de Perfil Local Exemplar -->
            <div class="local-result-card">
              <div class="result-card-inner">
                <div class="result-header-row">
                  <div>
                    <div class="result-badge-verified">
