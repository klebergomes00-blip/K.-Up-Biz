---
// src/components/NossoDiferencial.astro — Quinta Dobra: O Diferencial K. Up Biz
// Apresentação cinematográfica do case real "Fernando Junior Consultor Imobiliário / Xavier & Silva"
---

<section class="diferencial-section" id="diferencial" aria-label="04 Nosso Diferencial K. Up Biz — Case Fernando Junior">
  <!-- Auras atmosféricas cinematográficas em verde esmeralda e dourado -->
  <div class="diferencial-ambient-glow glow-emerald" aria-hidden="true"></div>
  <div class="diferencial-ambient-glow glow-gold" aria-hidden="true"></div>
  <div class="diferencial-ambient-glow glow-center" aria-hidden="true"></div>

  <!-- Vinhetas de transição suave entre seções -->
  <div class="diferencial-scrim-top" aria-hidden="true"></div>
  <div class="diferencial-scrim-bottom" aria-hidden="true"></div>

  <!-- Viewport / Palco Principal -->
  <div class="diferencial-viewport">
    <div class="wrap diferencial-wrap">

      <!-- GRID PRINCIPAL DE 2 COLUNAS: TEXTO À ESQUERDA & MOCKUP À DIREITA -->
      <div class="diferencial-grid">

        <!-- COLUNA ESQUERDA: NARRATIVA & POSICIONAMENTO EDITORIAL -->
        <div class="diferencial-col-left" id="diferencial-left">
          
          <!-- Eyebrow -->
          <div class="diferencial-eyebrow">
            <span class="eyebrow-pip" aria-hidden="true"></span>
            <span class="eyebrow-text">04 / NOSSO DIFERENCIAL</span>
          </div>

          <!-- Headline Principal com Bodoni Moda Italic Dourado -->
          <h2 class="diferencial-headline">
            <span class="headline-base">Seu negócio merece mais do que um site.</span>
            <span class="headline-highlight italic-serif text-gold">Merece impressionar.</span>
          </h2>

          <!-- Linha Decorativa Dourada -->
          <div class="diferencial-gold-divider" id="gold-divider" aria-hidden="true"></div>

          <!-- Texto de Apoio -->
          <p class="diferencial-support">
            Criamos experiências digitais que unem estratégia, design e posicionamento para transformar negócios em marcas que passam mais confiança.
          </p>

          <!-- Destaques Estratégicos Sutis -->
          <div class="diferencial-pillars-micro">
            <div class="micro-pillar">
              <span class="micro-pip"></span>
              <span class="micro-title">Estratégia sob medida</span>
            </div>
            <div class="micro-pillar">
              <span class="micro-pip"></span>
              <span class="micro-title">Design autoral</span>
            </div>
            <div class="micro-pillar">
              <span class="micro-pip"></span>
              <span class="micro-title">Percepção de valor</span>
            </div>
          </div>

          <!-- Rodapé da Coluna Esquerda: Assinatura e Frase Final -->
          <div class="diferencial-left-footer">
            <div class="diferencial-signature">
              <span class="sig-dot"></span>
              <span class="sig-label">K. UP BIZ — EXPERIÊNCIAS DIGITAIS COM PROPÓSITO.</span>
            </div>
            <div class="diferencial-final-phrase" id="diferencial-final-phrase">
              <span class="final-phrase-line italic-serif text-gold">Design que valoriza. Presença que posiciona.</span>
            </div>
          </div>

        </div>

        <!-- COLUNA DIREITA: MOCKUP PREMIUM DE TABLET EM PERSPECTIVA COM PROJETO REAL -->
        <div class="diferencial-col-right" id="diferencial-right">

          <div class="mockup-perspective-stage">
            <!-- Halo de iluminação volumétrica esmeralda/dourada que reage ao scroll -->
            <div class="tablet-halo" id="tablet-halo" aria-hidden="true"></div>

            <!-- Badge Editorial Superior do Case -->
            <div class="tablet-badge" id="tablet-badge">
              <span class="badge-dot"></span>
              <span class="badge-text">CASE IMOBILIÁRIO PREMIUM</span>
              <span class="badge-sep">•</span>
              <span class="badge-sub">PROJETO K. UP BIZ</span>
            </div>

            <!-- O CHASSI DO TABLET DE LUXO (HTML/CSS 3D) -->
            <div class="mockup-tablet" id="mockup-tablet">
              
              <!-- Bisel Metálico com Reflexo de Borda -->
              <div class="tablet-bezel">
                
                <!-- Sensor / Câmera Frontal Discreta -->
                <div class="tablet-sensor">
                  <span class="sensor-lens"></span>
                </div>

                <!-- Tela do Tablet com a Captura Real do Site -->
                <div class="tablet-screen">
                  <!-- Reflexo Especular de Vidro -->
                  <div class="screen-glare" id="screen-glare" aria-hidden="true"></div>
                  
                  <!-- Sombra Interna Perimetral de Encaixe -->
                  <div class="screen-inner-shadow" aria-hidden="true"></div>

                  <!-- Container de Vídeo do Case com Fallback de Imagem -->
                  <div class="screen-content-track" id="screen-content">
                    <video
                      id="tablet-case-video"
                      class="tablet-case-video"
                      autoplay
                      muted
                      loop
                      playsinline
                      preload="metadata"
                      poster="/images/cases/case-fernando-corretor.png"
                    >
                      <source src="/videos/fernando-corretor-demo.mp4" type="video/mp4" />
                      <!-- Fallback caso MP4 não seja suportado ou falhe -->
                      <img
                        src="/images/cases/case-fernando-corretor.png"
                        alt="Website institucional Fernando Junior Consultor Imobiliário desenvolvido pela K. Up Biz"
                        class="tablet-case-img"
                        loading="eager"
                        decoding="async"
                      />
                    </video>
                  </div>
                </div>

              </div>

              <!-- Sombra de Contato e Projeção do Dispositivo -->
              <div class="tablet-contact-shadow" aria-hidden="true"></div>
            </div>

            <!-- Mini-caption Discreto e Link para o Projeto Real Abaixo do Tablet -->
            <div class="tablet-caption" id="tablet-caption">
              <div class="caption-title">Fernando Junior Consultor Imobiliário</div>
              <div class="caption-desc">Site institucional / experiência digital</div>
              <a
                href="https://fernandocorretor-six.vercel.app/"
                target="_blank"
                rel="noopener noreferrer"
                class="tablet-case-link"
                aria-label="Explorar projeto real de Fernando Junior em nova aba"
              >
                <span class="case-link-text">EXPLORAR PROJETO</span>
                <span class="case-link-arrow" aria-hidden="true">↗</span>
              </a>
            </div>

          </div>

        </div>

      </div>

    </div>
  </div>
</section>

<style>
  /* ==========================================================================
     K. UP BIZ — QUINTA DOBRA | O DIFERENCIAL K. UP BIZ (CASE REAL)
     Paleta Canônica: #041D17, #030D0B, #047857, #D4AF37, #F5F1E8
     ========================================================================== */

  .diferencial-section {
    position: relative;
    width: 100%;
    background: linear-gradient(
      180deg,
      #041D17 0%,
      #030D0B 140px,
      #030D0B calc(100% - 140px),
      #041D17 100%
    );
    color: var(--color-marfim);
    overflow: hidden;
    z-index: 7;
  }

  @media (min-width: 1025px) {
    .diferencial-section {
      height: 100vh;
      height: 100dvh;
      min-height: 100vh;
      min-height: 100dvh;
      display: flex;
      flex-direction: column;
      justify-content: center;
      box-sizing: border-box;
    }
  }

  /* --------------------------------------------------------------------------
     AURAS ATMOSFÉRICAS E SCRIMS
     -------------------------------------------------------------------------- */
  .diferencial-ambient-glow {
    position: absolute;
    border-radius: 50%;
    filter: blur(140px);
    pointer-events: none;
    z-index: 0;
  }

  .glow-emerald {
    top: 20%;
    right: 5%;
    width: clamp(380px, 45vw, 680px);
    height: clamp(380px, 45vw, 680px);
    background: radial-gradient(
      circle,
      rgba(4, 120, 87, 0.22) 0%,
      rgba(4, 29, 23, 0.05) 60%,
      transparent 80%
    );
  }

  .glow-gold {
    bottom: 12%;
    left: -5%;
    width: clamp(340px, 40vw, 580px);
    height: clamp(340px, 40vw, 580px);
    background: radial-gradient(
      circle,
      rgba(212, 175, 55, 0.12) 0%,
      rgba(4, 29, 23, 0.03) 60%,
      transparent 75%
    );
  }

  .glow-center {
    top: 50%;
    left: 55%;
    transform: translate(-50%, -50%);
    width: clamp(450px, 55vw, 820px);
    height: clamp(350px, 45vw, 640px);
    background: radial-gradient(
      ellipse,
      rgba(11, 43, 34, 0.3) 0%,
      rgba(4, 29, 23, 0.08) 50%,
      transparent 75%
    );
  }

  .diferencial-scrim-top {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: clamp(80px, 12vh, 140px);
    z-index: 1;
    background: linear-gradient(180deg, #041D17 0%, transparent 100%);
    pointer-events: none;
  }

  .diferencial-scrim-bottom {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: clamp(80px, 12vh, 140px);
    z-index: 1;
    background: linear-gradient(0deg, #041D17 0%, transparent 100%);
    pointer-events: none;
  }

  /* --------------------------------------------------------------------------
     ESTRUTURA DE VIEWPORT & GRID PRINCIPAL
     -------------------------------------------------------------------------- */
  .diferencial-viewport {
    position: relative;
    z-index: 2;
    width: 100%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(24px, 4vh, 48px) 0;
    box-sizing: border-box;
  }

  .diferencial-wrap {
    width: 100%;
    position: relative;
  }

  .diferencial-grid {
    display: grid;
    grid-template-columns: 1.05fr 1.25fr;
    align-items: center;
    gap: clamp(36px, 5.5vw, 84px);
    width: 100%;
  }

  /* --------------------------------------------------------------------------
     COLUNA ESQUERDA: NARRATIVA & POSICIONAMENTO
     -------------------------------------------------------------------------- */
  .diferencial-col-left {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    position: relative;
    z-index: 3;
    will-change: transform, opacity;
  }

  .diferencial-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-bottom: clamp(16px, 2.4vh, 24px);
  }

  .eyebrow-pip {
    width: 6.5px;
    height: 6.5px;
    border-radius: 50%;
    background-color: var(--color-verde-esmeralda);
    box-shadow: 0 0 12px rgba(4, 120, 87, 0.9), 0 0 4px rgba(212, 175, 55, 0.4);
  }

  .eyebrow-text {
    font-family: var(--font-sans);
    font-size: 11.5px;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-dourado);
  }

  .diferencial-headline {
    margin: 0 0 clamp(16px, 2.2vh, 22px);
    display: flex;
    flex-direction: column;
    gap: 4px;
    line-height: 1.15;
    letter-spacing: -0.025em;
  }

  .headline-base {
    font-family: var(--font-sans);
    font-size: clamp(2rem, 3.1vw, 3.2rem);
    font-weight: 600;
    color: var(--color-marfim);
  }

  .headline-highlight {
    font-family: var(--font-bodoni);
    font-style: italic;
    font-weight: 400;
    font-size: clamp(2.4rem, 3.8vw, 4.1rem);
    color: var(--color-dourado);
    text-shadow: 0 0 35px rgba(212, 175, 55, 0.35);
  }

  .diferencial-gold-divider {
    width: 80px;
    height: 1.5px;
    background: linear-gradient(90deg, var(--color-dourado) 0%, rgba(212, 175, 55, 0.2) 80%, transparent 100%);
    margin: 0 0 clamp(18px, 2.5vh, 26px);
    transform-origin: left center;
    will-change: transform, opacity;
  }

  .diferencial-support {
    margin: 0 0 clamp(22px, 3vh, 32px);
    font-family: var(--font-sans);
    font-size: clamp(1.02rem, 1.22vw, 1.18rem);
    line-height: 1.68;
    color: var(--color-marfim-muted);
    max-width: 520px;
  }

  .diferencial-pillars-micro {
    display: flex;
    flex-wrap: wrap;
    gap: 12px clamp(12px, 1.8vw, 24px);
    margin-bottom: clamp(24px, 3.2vh, 36px);
  }

  .micro-pillar {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 14px;
    border-radius: 999px;
    background: rgba(4, 120, 87, 0.1);
    border: 1px solid rgba(4, 120, 87, 0.28);
  }

  .micro-pip {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--color-verde-esmeralda);
    box-shadow: 0 0 6px rgba(4, 120, 87, 0.9);
  }

  .micro-title {
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(245, 241, 232, 0.88);
  }

  .diferencial-left-footer {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding-top: 18px;
    border-top: 1px solid rgba(245, 241, 232, 0.08);
    width: 100%;
    max-width: 520px;
  }

  .diferencial-signature {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.16em;
    color: rgba(245, 241, 232, 0.5);
    text-transform: uppercase;
  }

  .sig-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--color-verde-esmeralda);
    box-shadow: 0 0 8px rgba(4, 120, 87, 0.8);
  }

  .diferencial-final-phrase {
    opacity: 0;
    transform: translateY(10px);
    will-change: opacity, transform;
  }

  .final-phrase-line {
    font-family: var(--font-bodoni);
    font-style: italic;
    font-weight: 400;
    font-size: clamp(1.2rem, 1.45vw, 1.45rem);
    color: var(--color-dourado);
    text-shadow: 0 0 20px rgba(212, 175, 55, 0.25);
  }

  /* --------------------------------------------------------------------------
     COLUNA DIREITA: MOCKUP TABLET 3D EM PERSPECTIVA
     -------------------------------------------------------------------------- */
  .diferencial-col-right {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
    z-index: 3;
    width: 100%;
  }

  .mockup-perspective-stage {
    perspective: 1400px;
    perspective-origin: center 45%;
    width: 100%;
    max-width: 680px;
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  /* Halo Luminoso Esmeralda & Ouro */
  .tablet-halo {
    position: absolute;
    inset: -30px;
    border-radius: 40px;
    background: radial-gradient(
      ellipse 75% 65% at 50% 50%,
      rgba(4, 120, 87, 0.35) 0%,
      rgba(212, 175, 55, 0.2) 45%,
      transparent 75%
    );
    filter: blur(52px);
    opacity: 0.45;
    pointer-events: none;
    z-index: 0;
    will-change: opacity, transform;
  }

  /* Badge Editorial Superior */
  .tablet-badge {
    position: absolute;
    top: -22px;
    z-index: 6;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 16px;
    border-radius: 999px;
    background: rgba(3, 13, 11, 0.9);
    border: 1px solid rgba(212, 175, 55, 0.35);
    backdrop-filter: blur(12px);
    box-shadow: 0 10px 28px rgba(0, 0, 0, 0.6), 0 0 16px rgba(212, 175, 55, 0.2);
    opacity: 0;
    transform: translateY(8px);
    will-change: opacity, transform;
  }

  .badge-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--color-verde-esmeralda);
    box-shadow: 0 0 8px rgba(4, 120, 87, 0.9);
  }

  .badge-text {
    font-family: var(--font-sans);
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.16em;
    color: var(--color-dourado);
    text-transform: uppercase;
  }

  .badge-sep {
    font-size: 10px;
    color: rgba(245, 241, 232, 0.3);
  }

  .badge-sub {
    font-family: var(--font-sans);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.12em;
    color: rgba(245, 241, 232, 0.7);
    text-transform: uppercase;
  }

  /* O CHASSI DO TABLET */
  .mockup-tablet {
    position: relative;
    z-index: 2;
    width: 100%;
    border-radius: 32px;
    background: #080f0d;
    padding: 14px;
    box-sizing: border-box;
    box-shadow:
      0 32px 80px rgba(0, 0, 0, 0.85),
      0 12px 30px rgba(0, 0, 0, 0.6),
      0 0 45px rgba(4, 120, 87, 0.28),
      inset 0 1px 2px rgba(245, 241, 232, 0.25),
      inset 0 -1px 2px rgba(0, 0, 0, 0.8);
    border: 1px solid rgba(212, 175, 55, 0.32);
    transform-style: preserve-3d;
    will-change: transform, box-shadow, filter;
  }

  .tablet-bezel {
    position: relative;
    width: 100%;
    border-radius: 22px;
    background: #030807;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    border: 1px solid rgba(245, 241, 232, 0.08);
  }

  .tablet-sensor {
    position: absolute;
    top: 6px;
    left: 50%;
    transform: translateX(-50%);
    width: 24px;
    height: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 10;
  }

  .sensor-lens {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: #0c1815;
    border: 0.5px solid rgba(245, 241, 232, 0.2);
  }

  /* Tela do Tablet */
  .tablet-screen {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 10.6;
    background: #030D0B;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .screen-content-track {
    position: relative;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #030D0B;
  }

  .tablet-case-video {
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center center;
    display: block;
    background: #030D0B;
    border-radius: inherit;
  }

  .tablet-case-img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center center;
    display: block;
    background: #030D0B;
    user-select: none;
    -webkit-user-drag: none;
  }

  /* Reflexo de Vidro Especular */
  .screen-glare {
    position: absolute;
    inset: 0;
    z-index: 5;
    background: linear-gradient(
      125deg,
      rgba(245, 241, 232, 0.16) 0%,
      rgba(245, 241, 232, 0.05) 30%,
      transparent 55%,
      rgba(212, 175, 55, 0.08) 85%,
      transparent 100%
    );
    pointer-events: none;
    opacity: 0.75;
    will-change: opacity;
  }

  .screen-inner-shadow {
    position: absolute;
    inset: 0;
    z-index: 4;
    box-shadow: inset 0 0 10px rgba(0, 0, 0, 0.45);
    pointer-events: none;
  }

  /* Sombra de Contato Inferior */
  .tablet-contact-shadow {
    position: absolute;
    bottom: -22px;
    left: 8%;
    right: 8%;
    height: 36px;
    background: radial-gradient(ellipse at center, rgba(0, 0, 0, 0.8) 0%, transparent 75%);
    filter: blur(12px);
    z-index: 0;
    pointer-events: none;
  }

  /* Mini-caption Discreto e Link para o Projeto Real Abaixo do Mockup */
  .tablet-caption {
    margin-top: 18px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 4px;
    opacity: 0;
    transform: translateY(8px);
    will-change: opacity, transform;
    pointer-events: auto;
  }

  .tablet-case-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 8px;
    padding: 5px 14px;
    border-radius: 999px;
    background: rgba(4, 120, 87, 0.14);
    border: 1px solid rgba(212, 175, 55, 0.35);
    color: var(--color-dourado);
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;
    transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    pointer-events: auto;
    cursor: pointer;
  }

  .tablet-case-link:hover {
    background: rgba(212, 175, 55, 0.2);
    border-color: var(--color-dourado);
    color: var(--color-marfim);
    box-shadow: 0 0 16px rgba(212, 175, 55, 0.35);
    transform: translateY(-1.5px);
  }

  .case-link-arrow {
    font-size: 12px;
    transition: transform 0.3s ease;
  }

  .tablet-case-link:hover .case-link-arrow {
    transform: translate(2px, -2px);
  }

  .caption-title {
    font-family: var(--font-sans);
    font-size: 12.5px;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--color-marfim);
  }

  .caption-desc {
    font-family: var(--font-sans);
    font-size: 11px;
    color: var(--color-dourado);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0.85;
  }

  /* --------------------------------------------------------------------------
     RESPONSIVIDADE (TABLET & MOBILE)
     -------------------------------------------------------------------------- */
  @media (max-width: 1024px) {
    .diferencial-section {
      min-height: auto;
      padding: clamp(70px, 10vh, 100px) 0;
    }

    .diferencial-grid {
      grid-template-columns: 1fr;
      gap: 48px;
    }

    .diferencial-col-left {
      max-width: 640px;
      margin: 0 auto;
      text-align: center;
      align-items: center;
    }

    .diferencial-headline {
      align-items: center;
    }

    .diferencial-gold-divider {
      margin-left: auto;
      margin-right: auto;
    }

    .diferencial-pillars-micro {
      justify-content: center;
    }

    .diferencial-left-footer {
      align-items: center;
    }

    .mockup-perspective-stage {
      max-width: 580px;
    }
  }

  @media (max-width: 767px) {
    .diferencial-section {
      padding: 56px 0;
    }

    .diferencial-col-left {
      text-align: left;
      align-items: flex-start;
    }

    .diferencial-headline {
      align-items: flex-start;
    }

    .headline-base {
      font-size: 1.85rem;
    }

    .headline-highlight {
      font-size: 2.35rem;
    }

    .diferencial-gold-divider {
      margin-left: 0;
      margin-right: 0;
    }

    .diferencial-pillars-micro {
      justify-content: flex-start;
      gap: 8px;
    }

    .diferencial-left-footer {
      align-items: flex-start;
    }

    .mockup-perspective-stage {
      perspective: none;
      max-width: 100%;
    }

    .mockup-tablet {
      border-radius: 20px;
      padding: 8px;
    }

    .tablet-bezel {
      border-radius: 14px;
    }

    .tablet-badge {
      position: relative;
      top: 0;
      margin-bottom: 14px;
      opacity: 1 !important;
      transform: none !important;
    }

    .tablet-caption {
      opacity: 1 !important;
      transform: none !important;
    }

    .diferencial-final-phrase {
      opacity: 1 !important;
      transform: none !important;
    }
  }

  /* --------------------------------------------------------------------------
     ACESSIBILIDADE: PREFERS-REDUCED-MOTION
     -------------------------------------------------------------------------- */
  @media (prefers-reduced-motion: reduce) {
    .diferencial-col-left,
    .mockup-tablet,
    .tablet-badge,
    .tablet-caption,
    .diferencial-final-phrase {
      opacity: 1 !important;
      transform: none !important;
      filter: none !important;
    }

    .tablet-halo {
      opacity: 0.5 !important;
    }
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const initNossoDiferencial = () => {
    const section = document.getElementById('diferencial');
    if (!section) return;

    // ------------------------------------------------------------------------
    // CONTROLE DE REPRODUÇÃO DO VÍDEO DO CASE (AUTO-PLAY / INTERSECTION OBSERVER)
    // ------------------------------------------------------------------------
    const caseVideo = section.querySelector('#tablet-case-video');
    if (caseVideo) {
      caseVideo.muted = true;
      caseVideo.defaultMuted = true;
      caseVideo.playsInline = true;

      const playVideoSafe = () => {
        if (caseVideo.paused) {
          const playPromise = caseVideo.play();
          if (playPromise !== undefined) {
            playPromise.catch(() => {
              // Silencioso se política de autoplay bloquear temporariamente
            });
          }
        }
      };

      const pauseVideoSafe = () => {
        if (!caseVideo.paused) {
          caseVideo.pause();
        }
      };

      if ('IntersectionObserver' in window) {
        const videoObserver = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                playVideoSafe();
              } else {
                pauseVideoSafe();
              }
            });
          },
          {
            root: null,
            threshold: 0.1, // Inicia assim que a 5ª dobra adentra a tela
          }
        );
        videoObserver.observe(section);
      } else {
        playVideoSafe();
      }

      // Tratamento para garantir fallback caso haja falha de carregamento
      caseVideo.addEventListener('error', () => {
        console.warn('Vídeo demo do case não disponível ou com erro. Exibindo imagem de poster/fallback.');
      });
    }

    const isReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (isReducedMotion) {
      return;
    }

    // Elementos principais
    const colLeft = section.querySelector('#diferencial-left');
    const goldDivider = section.querySelector('#gold-divider');
    const finalPhrase = section.querySelector('#diferencial-final-phrase');

    const tablet = section.querySelector('#mockup-tablet');
    const tabletHalo = section.querySelector('#tablet-halo');
    const tabletBadge = section.querySelector('#tablet-badge');
    const tabletCaption = section.querySelector('#tablet-caption');
    const screenGlare = section.querySelector('#screen-glare');
    const screenContent = section.querySelector('#screen-content');

    const mm = gsap.matchMedia();

    // ========================================================================
    // 1. DESKTOP CINEMATOGRÁFICO (>= 1025px): PINNING + 4 FASES DE SCRUBBING
    // ========================================================================
    mm.add('(min-width: 1025px)', () => {
      // Estado Inicial Explícito
      gsap.set(colLeft, { opacity: 0, y: 35 });
      gsap.set(goldDivider, { scaleX: 0, transformOrigin: 'left center' });
      gsap.set(finalPhrase, { opacity: 0, y: 12 });

      gsap.set(tablet, {
        opacity: 0,
        x: 70,
        y: 20,
        rotateY: -14,
        rotateX: 6,
        scale: 0.9,
        transformOrigin: 'center center',
        filter: 'blur(4px)'
      });

      gsap.set(tabletHalo, { opacity: 0.2, scale: 0.85 });
      gsap.set(tabletBadge, { opacity: 0, y: 12 });
      gsap.set(tabletCaption, { opacity: 0, y: 10 });
      gsap.set(screenGlare, { opacity: 0.4 });
      gsap.set(screenContent, { y: 0 });

      // Master Timeline do ScrollTrigger
      const masterTl = gsap.timeline({
        scrollTrigger: {
          trigger: section,
          start: 'top top',
          end: () => '+=' + Math.round(window.innerHeight * 2.5),
          pin: true,
          pinSpacing: true,
          scrub: 0.8,
          anticipatePin: 1,
          invalidateOnRefresh: true,
        }
      });

      // ----------------------------------------------------------------------
      // FASE 1 — ENTRADA (0% a 25% do Scroll | 0.0s -> 2.5s)
      // A dobra entra elegante, textos surgem e tablet vem da direita em perspectiva
      // ----------------------------------------------------------------------
      masterTl.addLabel('fase1-entrada', 0.0);

      masterTl
        // Entrada dos textos da esquerda com fade + y suave
        .to(colLeft, {
          opacity: 1,
          y: 0,
          duration: 1.6,
          ease: 'power2.out'
        }, 0.0)
        // Linha dourada se estende
        .to(goldDivider, {
          scaleX: 1,
          duration: 1.4,
          ease: 'power2.out'
        }, 0.3)
        // O mockup vem da direita com leve perspectiva, escala menor e blur removido
        .to(tablet, {
          opacity: 1,
          x: 0,
          y: 0,
          rotateY: -7,
          rotateX: 3,
          scale: 0.96,
          filter: 'blur(0px)',
          duration: 2.2,
          ease: 'power2.out'
        }, 0.2)
        // Halo luminoso de fundo ganha presença inicial
        .to(tabletHalo, {
          opacity: 0.55,
          scale: 0.95,
          duration: 2.0,
          ease: 'power2.out'
        }, 0.4);

      // ----------------------------------------------------------------------
      // FASE 2 — REVELAÇÃO DO CASE (25% a 60% do Scroll | 2.5s -> 6.0s)
      // O mockup gira suavemente para posição mais frontal, escala cresce e tela ganha protagonismo
      // ----------------------------------------------------------------------
      masterTl.addLabel('fase2-revelacao', 2.5);

      masterTl
        // Mockup rotaciona suavemente para posição frontal e escala ganha destaque
        .to(tablet, {
          rotateY: 0,
          rotateX: 0,
          scale: 1.03,
          boxShadow: '0 38px 95px rgba(0, 0, 0, 0.92), 0 0 55px rgba(4, 120, 87, 0.4)',
          borderColor: 'rgba(212, 175, 55, 0.55)',
          duration: 3.2,
          ease: 'power1.inOut'
        }, 2.5)
        // Brilho do dispositivo e halo esmeralda/dourado se intensificam
        .to(tabletHalo, {
          opacity: 0.85,
          scale: 1.08,
          duration: 3.0,
          ease: 'power1.inOut'
        }, 2.6)
        // Reflexo de vidro especular reage à iluminação
        .to(screenGlare, {
          opacity: 0.85,
          duration: 2.8,
          ease: 'power1.inOut'
        }, 2.8);

      // ----------------------------------------------------------------------
      // FASE 3 — APRESENTAÇÃO (60% a 85% do Scroll | 6.0s -> 8.5s)
      // Mockup estabiliza, entram badge editorial superior e mini-caption inferior
      // ----------------------------------------------------------------------
      masterTl.addLabel('fase3-apresentacao', 6.0);

      masterTl
        // Estabilização equilibrada do mockup
        .to(tablet, {
          scale: 1.0,
          duration: 1.8,
          ease: 'power2.out'
        }, 6.0)
        // Entrada da badge editorial "CASE IMOBILIÁRIO PREMIUM"
        .to(tabletBadge, {
          opacity: 1,
          y: 0,
          duration: 1.2,
          ease: 'power3.out'
        }, 6.2)
        // Entrada do mini-caption "Fernando Junior Consultor Imobiliário"
        .to(tabletCaption, {
          opacity: 1,
          y: 0,
          duration: 1.2,
          ease: 'power3.out'
        }, 6.5);

      // ----------------------------------------------------------------------
      // FASE 4 — FECHAMENTO (85% a 100% do Scroll | 8.5s -> 10.0s)
      // Estado final estável e assinatura editorial "Design que valoriza. Presença que posiciona."
      // ----------------------------------------------------------------------
      masterTl.addLabel('fase4-fechamento', 8.5);

      masterTl
        // Revelação da frase final de assinatura
        .to(finalPhrase, {
          opacity: 1,
          y: 0,
          duration: 1.2,
          ease: 'power2.out'
        }, 8.6)
        // Hold contemplativo final
        .to({}, { duration: 0.5 }, 9.5);
    });

    // ========================================================================
    // 2. MOBILE & TABLET (<= 1024px): SEQUÊNCIA NARRATIVA FLUÍDA SEM PINNING
    // ========================================================================
    mm.add('(max-width: 1024px)', () => {
      // Estado inicial adaptado para fluxo vertical
      gsap.set(colLeft, { opacity: 1, y: 0 });
      gsap.set(goldDivider, { scaleX: 1 });
      gsap.set(tablet, { opacity: 1, scale: 1, x: 0, y: 0, rotateY: 0, rotateX: 0, filter: 'blur(0px)' });
      gsap.set(tabletHalo, { opacity: 0.5 });
      gsap.set(tabletBadge, { opacity: 1, y: 0 });
      gsap.set(tabletCaption, { opacity: 1, y: 0 });
      gsap.set(finalPhrase, { opacity: 1, y: 0 });

      // Animação sutil de entrada ao rolar sobre o tablet no mobile/tablet
      gsap.from(tablet, {
        opacity: 0,
        y: 30,
        scale: 0.95,
        duration: 0.8,
        ease: 'power2.out',
        scrollTrigger: {
          trigger: tablet,
          start: 'top 80%',
          toggleActions: 'play none none reverse',
        }
      });
    });

    // Re-sincronização caso o cinematic intro inicial termine
    window.addEventListener('cinematic-intro-complete', () => {
      ScrollTrigger.refresh();
    });
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initNossoDiferencial);
  } else {
    initNossoDiferencial();
  }
</script>
