---
// /whatsapp — Página de passagem para o WhatsApp.
// Os botões de contato do site apontam para cá. A visita conta como "contato"
// no Google Ads (campanha otimizada para leads) e a conversa abre em seguida.
// A página não aparece no Google (noindex) e não entra no sitemap.
import Layout from '../layouts/Layout.astro';
import { EMPRESA } from '../config/empresa';
const padrao = 'Olá, Kleber! Vim pelo site da K. Up Biz e gostaria de conversar sobre o meu negócio.';
const direto = `https://wa.me/${EMPRESA.whatsapp}?text=${encodeURIComponent(padrao)}`;
---

<Layout title="Abrindo o WhatsApp — K. Up Biz" description="Abrindo a conversa com a K. Up Biz no WhatsApp." noindex>
  <main class="wa-go">
    <div class="wa-card">
      <span class="wa-ic" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="30" height="30"><path fill="currentColor" d="M19.05 4.91A9.82 9.82 0 0 0 12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38a9.9 9.9 0 0 0 4.74 1.21h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.91-7.01zm-7.01 15.24h-.01a8.23 8.23 0 0 1-4.19-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.2 8.2 0 0 1-1.26-4.38c0-4.54 3.7-8.23 8.24-8.23 2.2 0 4.27.86 5.82 2.42a8.18 8.18 0 0 1 2.41 5.83c0 4.54-3.7 8.22-8.22 8.22zm4.52-6.16c-.25-.12-1.47-.72-1.69-.81-.23-.08-.39-.12-.56.12-.17.25-.64.81-.78.97-.14.17-.29.19-.54.06-.25-.12-1.05-.39-1.99-1.23-.74-.66-1.23-1.47-1.38-1.72-.14-.25-.02-.38.11-.51.11-.11.25-.29.37-.43.13-.14.17-.25.25-.41.08-.17.04-.31-.02-.43-.06-.12-.56-1.34-.76-1.84-.2-.48-.41-.42-.56-.43h-.48c-.17 0-.43.06-.66.31-.22.25-.86.85-.86 2.07 0 1.22.89 2.4 1.01 2.56.12.17 1.75 2.67 4.23 3.74.59.26 1.05.41 1.41.52.59.19 1.13.16 1.56.1.48-.07 1.47-.6 1.67-1.18.21-.58.21-1.07.14-1.18-.06-.1-.22-.16-.47-.28z"/></svg>
      </span>
      <h1>Abrindo o WhatsApp…</h1>
      <p>Você vai conversar direto com o Kleber, da K.&nbsp;Up&nbsp;Biz.</p>
      <a class="wa-btn" id="wa-go-btn" href={direto} rel="noopener noreferrer">Abrir o WhatsApp</a>
      <a class="wa-back" href="/">Voltar ao site</a>
    </div>
  </main>

  <script is:inline define:vars={{ numero: EMPRESA.whatsapp, padrao }}>
    (function () {
      var params = new URLSearchParams(location.search);
      var msg = (params.get('m') || padrao).slice(0, 500);
      var url = 'https://wa.me/' + numero + '?text=' + encodeURIComponent(msg);
      var btn = document.getElementById('wa-go-btn');
      if (btn) btn.href = url;
      // Pequena espera para a tag do Google registrar a visita antes de sair da página
      setTimeout(function () { location.replace(url); }, 700);
    })();
  </script>
</Layout>

<style>
  .wa-go {
    min-height: 100vh;
    min-height: 100svh;
    display: grid;
    place-items: center;
    padding: 24px;
    background: radial-gradient(80% 60% at 50% 0%, rgba(4, 120, 87, 0.35), transparent 70%), #030D0B;
    color: #F5F1E8;
    font-family: var(--font-sans);
  }
  .wa-card { max-width: 380px; text-align: center; }
  .wa-ic {
    display: inline-grid;
    place-items: center;
    width: 64px;
    height: 64px;
    margin-bottom: 20px;
    border-radius: 20px;
    background: linear-gradient(135deg, #1C9E57, #0E6B5F);
    color: #fff;
    box-shadow: 0 0 40px rgba(37, 211, 102, 0.35);
    animation: waPulse 1.6s ease-in-out infinite;
  }
  @keyframes waPulse { 50% { transform: scale(1.06); } }
  h1 { margin: 0 0 10px; font-size: 26px; font-weight: 600; letter-spacing: -0.02em; }
  p { margin: 0 0 26px; font-size: 16px; line-height: 1.55; color: rgba(245, 241, 232, 0.75); }
  .wa-btn {
    display: inline-block;
    padding: 14px 26px;
    border-radius: 999px;
    background: linear-gradient(135deg, #D4AF37, #F3E5AB);
    color: #041D17;
    font-weight: 700;
    text-decoration: none;
  }
  .wa-back { display: block; margin-top: 18px; font-size: 14px; color: rgba(245, 241, 232, 0.72); }
  .wa-btn:focus-visible, .wa-back:focus-visible { outline: 2px solid #D4AF37; outline-offset: 3px; }
  @media (prefers-reduced-motion: reduce) { .wa-ic { animation: none; } }
</style>
