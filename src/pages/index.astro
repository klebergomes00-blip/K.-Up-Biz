---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import CinematicIntro from '../components/CinematicIntro.astro';
import NossaVisao from '../components/NossaVisao.astro';
import DigitalShelf from '../components/DigitalShelf.astro';
import NossoMetodo from '../components/NossoMetodo.astro';
import NossoDiferencial from '../components/NossoDiferencial.astro';
import ProjetosSelecionados from '../components/ProjetosSelecionados.astro';
import PerguntasFrequentes from '../components/PerguntasFrequentes.astro';
import Contato from '../components/Contato.astro';
import WhatsAppFlutuante from '../components/WhatsAppFlutuante.astro';
---

<Layout
  title="K. Up Biz | Criação de Sites, Google Meu Negócio e Tráfego Pago"
  description="Criação de sites e landing pages, otimização do Google Meu Negócio e gestão de tráfego pago para empresas que querem ser encontradas. Atendimento online para todo o Brasil."
>
  <a href="#main-content" class="skip-link">Pular para o conteúdo</a>

  <!-- Abertura Cinematográfica Premium V2 -->
  <CinematicIntro />

  <!-- Header Canônico com Notch Floating Menu -->
  <Header />

  <!-- Hero Cinematográfica com Apple-Style Scroll Video Scrubbing -->
  <main id="main-content">
    <span id="inicio" class="anchor-inicio" aria-hidden="true"></span>
    <Hero />
    <NossaVisao />
    <DigitalShelf />
    <NossoMetodo />
    <NossoDiferencial />
    <ProjetosSelecionados />
    <PerguntasFrequentes />
    <Contato />
  </main>
  <WhatsAppFlutuante />
</Layout>

<script>
  // Acessibilidade: enquanto a introdução está na tela, o restante da página fica
  // fora do alcance do teclado (inert) e o foco não vai parar em itens invisíveis.
  const intro = document.getElementById('cinematic-intro');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (intro && !reduce) {
    const blocked = [document.getElementById('site-header'), document.getElementById('main-content')].filter(Boolean) as HTMLElement[];
    blocked.forEach((el) => (el.inert = true));
    const release = () => blocked.forEach((el) => (el.inert = false));
    window.addEventListener('cinematic-intro-complete', release, { once: true });
    window.addEventListener('cinematic-header-reveal', release, { once: true });
    window.setTimeout(release, 15000);
  }
</script>

