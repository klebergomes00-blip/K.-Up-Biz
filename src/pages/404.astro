---
// src/pages/404.astro — Página não encontrada
import Layout from '../layouts/Layout.astro';
import Rodape from '../components/Rodape.astro';
import { waLink } from '../config/empresa';
const wa = waLink('Olá, Kleber! Vim pelo site da K. Up Biz e gostaria de conversar sobre o meu negócio.');
---

<Layout title="Página não encontrada — K. Up Biz" description="A página que você procurou não existe." noindex>
  <main class="nf" id="inicio">
    <a href="/" class="nf-logo" aria-label="K. Up Biz — página inicial">
      <img src="/imagens/kupbiz-logo-fundo-escuro.svg" alt="K. Up Biz" width="132" height="36" />
    </a>
    <p class="nf-code" aria-hidden="true">404</p>
    <h1>Esta página <span>não foi encontrada.</span></h1>
    <p class="nf-lead">O endereço pode ter mudado ou foi digitado com algum erro. Que tal voltar ao início?</p>
    <div class="nf-actions">
      <a href="/" class="nf-btn">Voltar ao início</a>
      <a href="/#solucoes" class="nf-btn nf-ghost">Ver soluções</a>
      <a href={wa} target="_blank" rel="noopener noreferrer" class="nf-btn nf-ghost">Falar no WhatsApp</a>
    </div>
  </main>
  <Rodape />
</Layout>

<style>
  .nf {
    min-height: 78vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 48px 20px;
    font-family: var(--font-sans);
    color: #F5F1E8;
    background: radial-gradient(50% 50% at 50% 45%, rgba(4, 120, 87, 0.3), transparent 70%);
  }
  .nf-logo { position: absolute; top: 28px; left: clamp(20px, 5vw, 64px); }
  .nf-logo img { height: 34px; width: auto; }
  .nf-code {
    margin: 0;
    font-size: clamp(110px, 22vw, 220px);
    font-weight: 700;
    line-height: 0.9;
    letter-spacing: -0.06em;
    color: transparent;
    -webkit-text-stroke: 1px rgba(212, 175, 55, 0.5);
  }
  .nf h1 { margin: 18px 0 12px; font-size: clamp(28px, 4.5vw, 48px); font-weight: 600; letter-spacing: -0.03em; }
  .nf h1 span { display: block; font-family: var(--font-instrument-serif); font-style: italic; font-weight: 400; color: #D4AF37; }
  .nf-lead { max-width: 440px; margin: 0 0 32px; font-size: 17px; line-height: 1.6; color: rgba(245, 241, 232, 0.78); }
  .nf-actions { display: flex; flex-wrap: wrap; gap: 12px; justify-content: center; }
  .nf-btn {
    padding: 14px 24px;
    border-radius: 999px;
    background: linear-gradient(135deg, #D4AF37, #F3E5AB);
    color: #030D0B;
    font-weight: 700;
    text-decoration: none;
  }
  .nf-ghost { background: rgba(245, 241, 232, 0.06); color: #F5F1E8; border: 1px solid rgba(245, 241, 232, 0.2); font-weight: 600; }
  .nf-btn:focus-visible, .nf-logo:focus-visible { outline: 2px solid #D4AF37; outline-offset: 3px; }
</style>
