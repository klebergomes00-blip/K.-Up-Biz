---
import '../styles/global.css';
import CookieConsent from '../components/CookieConsent.astro';

import { EMPRESA } from '../config/empresa';
import { SEO } from '../config/seo';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const {
  title = "K. Up Biz | Criação de Sites, Google Meu Negócio e Tráfego Pago",
  description = "Criação de sites e landing pages, otimização do Google Meu Negócio e gestão de tráfego pago para empresas que querem ser encontradas. Atendimento online para todo o Brasil.",
  noindex = false
} = Astro.props;

// Caminho limpo da página: "/" ou "/termos-de-uso" (sem .html e sem barra final)
const path = Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '/').replace(/(.)\/$/, '$1') || '/';
const canonical = new URL(path, Astro.site).href;
const ogImage = new URL('/imagens/og-kupbiz.jpg', Astro.site).href;
const isHome = path === '/';
const siteUrl = new URL('/', Astro.site).href;

// Dados de empresa local para o Google (aparecem só na página inicial)
const jsonLd = [{
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${siteUrl}#website`,
  name: EMPRESA.nomeFantasia,
  url: siteUrl,
  inLanguage: 'pt-BR',
  publisher: { '@id': `${siteUrl}#empresa` }
}, {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  '@id': `${siteUrl}#empresa`,
  name: EMPRESA.nomeFantasia,
  description,
  url: siteUrl,
  image: ogImage,
  logo: new URL('/icon-512.png', Astro.site).href,
  telephone: '+55 61 99622-9988',
  email: EMPRESA.email,
  founder: { '@type': 'Person', name: EMPRESA.responsavel },
  address: {
    '@type': 'PostalAddress',
    streetAddress: EMPRESA.endereco,
    addressLocality: 'Cabeceiras',
    addressRegion: 'GO',
    addressCountry: 'BR'
  },
  areaServed: { '@type': 'Country', name: 'Brasil' },
  sameAs: [EMPRESA.instagramUrl],
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Serviços',
    itemListElement: [
      'Criação de sites e landing pages',
      'Otimização do Perfil da Empresa no Google',
      'Gestão de tráfego pago'
    ].map((nome) => ({ '@type': 'Offer', itemOffered: { '@type': 'Service', name: nome } }))
  }
}];
---

<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {!noindex && <link rel="canonical" href={canonical} />}
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#041D17" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large'} />
    {SEO.googleSiteVerification && <meta name="google-site-verification" content={SEO.googleSiteVerification} />}

    <!-- Open Graph / Redes Sociais -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={EMPRESA.nomeFantasia} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="pt_BR" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Fontes hospedadas no próprio site (sem conexão com o Google Fonts) -->
    <link rel="preload" href="/fonts/instrument-sans-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/instrument-serif-latin-400-italic.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="/fonts/fonts.css" />
    {isHome && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <slot />
    <CookieConsent />
  </body>
</html>
