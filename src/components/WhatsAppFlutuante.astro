---
// src/components/WhatsAppFlutuante.astro — Botão flutuante de WhatsApp (celular/tablet).
// Aparece depois da abertura, some na seção de Contato, com menu ou modal abertos.
import { waLink } from '../config/empresa';
const url = waLink('Olá, Kleber! Vim pelo site da K. Up Biz e gostaria de conversar sobre o meu negócio.');
---

<a href={url} target="_blank" rel="noopener noreferrer" class="wa-float" id="wa-float" aria-label="Conversar no WhatsApp (abre em nova aba)" tabindex="-1" aria-hidden="true">
  <svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true">
    <path fill="currentColor" d="M19.05 4.91A9.82 9.82 0 0 0 12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38a9.9 9.9 0 0 0 4.74 1.21h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.91-7.01zm-7.01 15.24h-.01a8.23 8.23 0 0 1-4.19-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.2 8.2 0 0 1-1.26-4.38c0-4.54 3.7-8.23 8.24-8.23 2.2 0 4.27.86 5.82 2.42a8.18 8.18 0 0 1 2.41 5.83c0 4.54-3.7 8.22-8.22 8.22zm4.52-6.16c-.25-.12-1.47-.72-1.69-.81-.23-.08-.39-.12-.56.12-.17.25-.64.81-.78.97-.14.17-.29.19-.54.06-.25-.12-1.05-.39-1.99-1.23-.74-.66-1.23-1.47-1.38-1.72-.14-.25-.02-.38.11-.51.11-.11.25-.29.37-.43.13-.14.17-.25.25-.41.08-.17.04-.31-.02-.43-.06-.12-.56-1.34-.76-1.84-.2-.48-.41-.42-.56-.43h-.48c-.17 0-.43.06-.66.31-.22.25-.86.85-.86 2.07 0 1.22.89 2.4 1.01 2.56.12.17 1.75 2.67 4.23 3.74.59.26 1.05.41 1.41.52.59.19 1.13.16 1.56.1.48-.07 1.47-.6 1.67-1.18.21-.58.21-1.07.14-1.18-.06-.1-.22-.16-.47-.28z"/>
  </svg>
</a>

<style>
  .wa-float {
    position: fixed;
    right: 16px;
    bottom: calc(16px + env(safe-area-inset-bottom, 0px));
    z-index: 9000;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    display: none;
    place-items: center;
    background: linear-gradient(135deg, #D4AF37, #F3E5AB);
    color: #030D0B;
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.45), 0 0 0 1px rgba(255, 255, 255, 0.25) inset;
    opacity: 0;
    transform: translateY(16px) scale(0.9);
    pointer-events: none;
    transition: opacity 0.35s ease, transform 0.45s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .wa-float.is-visible { opacity: 1; transform: none; pointer-events: auto; }
  .wa-float:focus-visible { outline: 3px solid #F5F1E8; outline-offset: 3px; }
  @media (max-width: 900px) {
    .wa-float { display: grid; }
  }
  @media (prefers-reduced-motion: reduce) {
    .wa-float { transition: none; }
  }
</style>

<script>
  const initWaFloat = () => {
    const btn = document.getElementById('wa-float');
    if (!btn) return;
    const contato = document.getElementById('contato');
    let raf = 0;
    const update = () => {
      raf = 0;
      const pastHero = window.scrollY > window.innerHeight * 0.9;
      const r = contato?.getBoundingClientRect();
      const atContact = !!r && r.top < window.innerHeight * 0.85;
      const blocked = document.body.classList.contains('shelf-modal-open') ||
        document.getElementById('nav-toggle')?.getAttribute('aria-expanded') === 'true' ||
        !!document.getElementById('cinematic-intro')?.offsetParent;
      const show = pastHero && !atContact && !blocked;
      btn.classList.toggle('is-visible', show);
      btn.tabIndex = show ? 0 : -1;
      btn.setAttribute('aria-hidden', show ? 'false' : 'true');
    };
    const schedule = () => { if (!raf) raf = requestAnimationFrame(update); };
    window.addEventListener('scroll', schedule, { passive: true });
    window.addEventListener('resize', schedule);
    new MutationObserver(schedule).observe(document.body, { attributes: true, attributeFilter: ['class'] });
    update();
  };
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initWaFloat);
  else initWaFloat();
</script>
