---
// src/components/ProjetosSelecionados.astro — Sexta Dobra: Projetos Selecionados
// Galeria guiada pelo scroll: a seção fica fixa na tela e, conforme o usuário rola,
// os projetos deslizam até o centro, um de cada vez (com uma pausa em cada).
// Tudo é dimensionado pela altura da tela para nunca cortar texto.

const projects = [
  {
    id: '01',
    key: 'fernando-junior',
    name: 'Fernando Junior',
    segment: 'Imobiliário premium',
    description: 'Uma experiência imobiliária cinematográfica, criada para valorizar propriedades e transmitir sofisticação.',
    url: 'https://fernandocorretor-six.vercel.app/',
    urlClean: 'fernandocorretor-six.vercel.app',
    image: '/imagens/portfolio/fernando-junior.webp',
    accent: '#D4AF37'
  },
  {
    id: '02',
    key: 'level-up-agency',
    name: 'Level Up Agency',
    segment: 'Marketing & presença digital',
    description: 'Design e posicionamento reunidos para apresentar soluções de presença digital.',
    url: 'https://level-up-agency-astro.vercel.app/',
    urlClean: 'level-up-agency-astro.vercel.app',
    image: '/imagens/portfolio/level-up-agency.webp',
    accent: '#2EE59D'
  },
  {
    id: '03',
    key: 'level-up-aesthetics',
    name: 'Level Up Aesthetics',
    segment: 'Estética & bem-estar',
    description: 'Uma experiência digital elegante que transmite cuidado, confiança e beleza natural.',
    url: 'https://clinicaestetica-xi.vercel.app/',
    urlClean: 'clinicaestetica-xi.vercel.app',
    image: '/imagens/portfolio/level-up-aesthetics.webp',
    accent: '#E9D5B5'
  },
  {
    id: '04',
    key: 'styvy-burguer',
    name: 'Styvy Burguer',
    segment: 'Gastronomia',
    description: 'Uma narrativa visual que transforma ingredientes, brasa e sabor em desejo.',
    url: 'https://styviburguer.vercel.app/',
    urlClean: 'styviburguer.vercel.app',
    image: '/imagens/portfolio/styvy-burguer.webp',
    accent: '#F08A3C'
  }
];
const total = String(projects.length).padStart(2, '0');
---

<section
  class="portfolio-section"
  id="portfolio"
  aria-labelledby="portfolio-title"
  style={`--n:${projects.length}; --accent:${projects[0].accent}`}
>
  <div class="pf-sticky">
    <div class="pf-ambient" aria-hidden="true"></div>

    <div class="pf-head">
      <div class="pf-head-text">
        <div class="pf-eyebrow">
          <span class="pf-pip" aria-hidden="true"></span>
          05 / PROJETOS SELECIONADOS
        </div>
        <h2 class="pf-title" id="portfolio-title">
          Cada projeto, uma estratégia. <span class="pf-gold">Uma experiência única.</span>
        </h2>
      </div>
      <div class="pf-arrows">
        <button type="button" class="pf-arrow" data-pf-prev aria-label="Projeto anterior">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6"/></svg>
        </button>
        <button type="button" class="pf-arrow" data-pf-next aria-label="Próximo projeto">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 18l6-6-6-6"/></svg>
        </button>
      </div>
    </div>

    <div class="pf-stage">
      <div class="pf-track">
        {projects.map((p, i) => (
          <article
            class={`pf-card${i === 0 ? ' is-active' : ''}`}
            data-pf-card={i}
            data-accent={p.accent}
            style={`--card-accent:${p.accent}`}
            aria-label={`Projeto ${p.id} de ${total}: ${p.name}`}
          >
            <a class="pf-frame" href={p.url} target="_blank" rel="noopener noreferrer" tabindex="-1" aria-hidden="true">
              <div class="pf-bar">
                <span class="pf-dots"><i></i><i></i><i></i></span>
                <span class="pf-url">
                  <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg>
                  {p.urlClean}
                </span>
                <span class="pf-live"><span class="pf-live-dot"></span>No ar</span>
              </div>
              <div class="pf-shot">
                <img
                  src={p.image}
                  alt={`Página inicial do site ${p.name}, desenvolvido pela K. Up Biz`}
                  width="1584"
                  height="849"
                  loading={i < 2 ? 'eager' : 'lazy'}
                  decoding="async"
                />
              </div>
            </a>

            <div class="pf-info">
              <div class="pf-info-text">
                <span class="pf-seg"><span class="pf-num">{p.id}</span>{p.segment}</span>
                <h3 class="pf-name">{p.name}</h3>
                <p class="pf-desc">{p.description}</p>
              </div>
              <a class="pf-visit" href={p.url} target="_blank" rel="noopener noreferrer" aria-label={`Visitar o site ${p.name} (abre em nova aba)`}>
                Visitar site <span aria-hidden="true">↗</span>
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>

    <div class="pf-controls">
      <span class="pf-counter" aria-live="polite"><b data-pf-current>01</b> / {total}</span>
      <div class="pf-dots-nav" role="group" aria-label="Escolher projeto">
        {projects.map((p, i) => (
          <button
            type="button"
            class={`pf-dot${i === 0 ? ' is-active' : ''}`}
            data-pf-dot={i}
            aria-label={`Ver projeto ${p.name}`}
            aria-current={i === 0 ? 'true' : 'false'}
          ></button>
        ))}
      </div>
      <span class="pf-hint" aria-hidden="true">Role para ver os projetos</span>
    </div>
  </div>
</section>

<style>
  /* ==========================================================================
     K. UP BIZ — SEXTA DOBRA | PROJETOS SELECIONADOS (galeria guiada pelo scroll)
     ========================================================================== */
  .portfolio-section {
    --gold: #D4AF37;
    --gold-l: #F3E5AB;
    --ivory: #F5F1E8;
    --ivory-2: rgba(245, 241, 232, 0.7);
    --ivory-3: rgba(245, 241, 232, 0.42);
    --line: rgba(245, 241, 232, 0.1);
    --ease: cubic-bezier(0.16, 1, 0.3, 1);
    --gutter: max(clamp(20px, 5vw, 64px), calc((100vw - var(--max-width, 1240px)) / 2 + 64px));
    /* Largura do card limitada pela altura disponível: nunca corta */
    --card-w: clamp(260px, min(70vw, calc((100svh - 330px) * 1.75)), 940px);
    position: relative;
    height: calc(100svh + (var(--n) - 1) * 75svh);
    background: linear-gradient(180deg, #041D17 0%, #030D0B 160px, #030D0B 100%);
    color: var(--ivory);
    z-index: 7;
  }

  .pf-sticky {
    position: sticky;
    top: 0;
    height: 100svh;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: auto minmax(0, 1fr) auto;
    padding: clamp(76px, 13svh, 120px) 0 clamp(14px, 3svh, 32px);
    overflow: hidden;
  }

  .pf-ambient {
    position: absolute;
    left: 50%;
    top: 55%;
    width: min(1100px, 130vw);
    height: 75%;
    transform: translate(-50%, -50%);
    background: radial-gradient(closest-side, color-mix(in srgb, var(--accent) 22%, transparent), transparent 75%);
    filter: blur(60px);
    opacity: 0.8;
    transition: background 1s ease;
    pointer-events: none;
  }

  /* Cabeçalho compacto */
  .pf-head {
    position: relative;
    z-index: 3;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    padding: 0 var(--gutter);
  }
  .pf-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-bottom: clamp(8px, 1.6svh, 16px);
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.22em;
    color: var(--gold);
  }
  .pf-pip { width: 6px; height: 6px; border-radius: 50%; background: #2EE59D; box-shadow: 0 0 10px #2EE59D; }
  .pf-title {
    margin: 0;
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: clamp(24px, min(3.2vw, 5.6svh), 46px);
    line-height: 1.1;
    letter-spacing: -0.03em;
  }
  .pf-gold {
    font-family: var(--font-instrument-serif);
    font-style: italic;
    font-weight: 400;
    letter-spacing: -0.01em;
    color: var(--gold);
  }

  .pf-arrows { display: flex; gap: 10px; flex-shrink: 0; }
  .pf-arrow {
    width: 46px;
    height: 46px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    border: 1px solid var(--line);
    background: rgba(245, 241, 232, 0.06);
    color: var(--ivory);
    cursor: pointer;
    transition: background 0.3s ease, border-color 0.3s ease, opacity 0.3s ease, transform 0.3s var(--ease);
  }
  .pf-arrow:hover:not(:disabled) { background: rgba(245, 241, 232, 0.14); border-color: rgba(212, 175, 55, 0.5); transform: scale(1.05); }
  .pf-arrow:disabled { opacity: 0.3; cursor: default; }
  .pf-arrow:focus-visible { outline: 2px solid var(--gold); outline-offset: 3px; }

  /* Palco: o trilho é movido pelo script conforme o scroll */
  .pf-stage {
    position: relative;
    display: flex;
    align-items: center;
    min-width: 0;
    min-height: 0;
    padding-top: clamp(10px, 2svh, 20px);
  }
  .pf-track {
    display: flex;
    align-items: flex-start;
    gap: clamp(20px, 3vw, 48px);
    will-change: transform;
  }

  .pf-card {
    flex: 0 0 var(--card-fit, var(--card-w));
    width: var(--card-fit, var(--card-w));
    opacity: 0.35;
    transform-origin: 50% 40%;
  }

  .pf-frame {
    display: block;
    border-radius: 20px;
    overflow: hidden;
    border: 1px solid rgba(245, 241, 232, 0.12);
    background: #06140F;
    box-shadow: 0 40px 90px -30px rgba(0, 0, 0, 0.85);
    transition: box-shadow 0.8s ease, border-color 0.8s ease;
  }
  .pf-card.is-active .pf-frame {
    border-color: color-mix(in srgb, var(--card-accent) 45%, transparent);
    box-shadow: 0 40px 90px -30px rgba(0, 0, 0, 0.85), 0 0 60px -10px color-mix(in srgb, var(--card-accent) 35%, transparent);
  }
  .pf-bar {
    display: flex;
    align-items: center;
    gap: 12px;
    height: 34px;
    padding: 0 14px;
    background: rgba(245, 241, 232, 0.04);
    border-bottom: 1px solid var(--line);
  }
  .pf-dots { display: flex; gap: 6px; }
  .pf-dots i { width: 9px; height: 9px; border-radius: 50%; }
  .pf-dots i:nth-child(1) { background: #FF5F57; }
  .pf-dots i:nth-child(2) { background: #FEBC2E; }
  .pf-dots i:nth-child(3) { background: #28C840; }
  .pf-url {
    flex: 1;
    max-width: 300px;
    margin: 0 auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    height: 22px;
    padding: 0 12px;
    border-radius: 7px;
    background: rgba(0, 0, 0, 0.35);
    font-family: var(--font-sans);
    font-size: 11px;
    color: var(--ivory-2);
    white-space: nowrap;
    overflow: hidden;
  }
  .pf-live {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 600;
    color: #2EE59D;
    white-space: nowrap;
  }
  .pf-live-dot { width: 7px; height: 7px; border-radius: 50%; background: #2EE59D; animation: pfLive 2s ease-in-out infinite; }
  @keyframes pfLive { 50% { box-shadow: 0 0 0 5px rgba(46, 229, 157, 0.15); } }

  .pf-shot { position: relative; aspect-ratio: 1584 / 849; overflow: hidden; }
  .pf-shot img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    transition: transform 6s ease-out;
  }
  .pf-card.is-active .pf-shot img { transform: scale(1.04); }

  /* Informações (compactas e sempre dentro da tela) */
  .pf-info {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px;
    padding: clamp(10px, 2svh, 18px) 2px 0;
    opacity: 0;
    transform: translateY(10px);
    transition: opacity 0.5s ease, transform 0.6s var(--ease);
  }
  .pf-card.is-active .pf-info { opacity: 1; transform: none; }
  .pf-info-text { min-width: 0; }
  .pf-seg {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--card-accent);
  }
  .pf-num { color: var(--ivory-3); }
  .pf-name {
    margin: 4px 0 4px;
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: clamp(18px, min(2vw, 3.6svh), 28px);
    letter-spacing: -0.025em;
    color: var(--ivory);
  }
  .pf-desc {
    max-width: 560px;
    margin: 0;
    font-family: var(--font-sans);
    font-size: clamp(13px, min(1.1vw, 2.3svh), 16px);
    line-height: 1.5;
    color: var(--ivory-2);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .pf-visit {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 11px 20px;
    border-radius: 999px;
    border: 1px solid rgba(245, 241, 232, 0.18);
    background: rgba(245, 241, 232, 0.05);
    color: var(--ivory);
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
    transition: background 0.35s ease, border-color 0.35s ease, color 0.35s ease;
  }
  .pf-visit span { transition: transform 0.35s var(--ease); }
  .pf-visit:hover { background: var(--ivory); color: #030D0B; border-color: var(--ivory); }
  .pf-visit:hover span { transform: translate(2px, -2px); }
  .pf-visit:focus-visible { outline: 2px solid var(--gold); outline-offset: 3px; }

  /* Controles */
  .pf-controls {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 16px;
    padding-top: clamp(8px, 1.6svh, 16px);
    font-family: var(--font-sans);
  }
  .pf-counter { font-size: 13px; color: var(--ivory-3); letter-spacing: 0.08em; min-width: 54px; text-align: right; }
  .pf-counter b { color: var(--ivory); font-weight: 600; }
  .pf-dots-nav {
    display: flex;
    align-items: center;
    gap: 10px;
    height: 40px;
    padding: 0 18px;
    border-radius: 999px;
    background: rgba(245, 241, 232, 0.07);
  }
  .pf-dot {
    position: relative;
    width: 8px;
    height: 8px;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: rgba(245, 241, 232, 0.35);
    cursor: pointer;
    transition: width 0.5s var(--ease), background 0.3s ease;
  }
  .pf-dot::before { content: ''; position: absolute; inset: -12px -4px; }
  .pf-dot:hover { background: rgba(245, 241, 232, 0.65); }
  .pf-dot.is-active { width: 32px; background: var(--ivory); }
  .pf-dot:focus-visible { outline: 2px solid var(--gold); outline-offset: 3px; }
  .pf-hint {
    min-width: 54px;
    font-size: 12px;
    color: var(--ivory-3);
    white-space: nowrap;
  }

  /* Telas baixas */
  @media (max-height: 700px) {
    .pf-live { display: none; }
    .pf-bar { height: 28px; }
    .pf-dots i { width: 8px; height: 8px; }
    .pf-hint { display: none; }
  }

  /* Celular */
  @media (max-width: 760px) {
    .portfolio-section {
      --card-w: clamp(240px, min(84vw, calc((100svh - 360px) * 1.86)), 520px);
      height: calc(100svh + (var(--n) - 1) * 65svh);
    }
    .pf-arrows { display: none; }
    .pf-info { flex-direction: column; align-items: flex-start; gap: 12px; }
    .pf-visit { padding: 10px 16px; font-size: 13px; }
    .pf-bar { height: 28px; gap: 8px; padding: 0 10px; }
    .pf-dots i { width: 7px; height: 7px; }
    .pf-url { font-size: 10px; height: 18px; }
    .pf-live, .pf-hint { display: none; }
    .pf-frame { border-radius: 14px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .pf-shot img, .pf-info, .pf-dot { transition: none; }
    .pf-card.is-active .pf-shot img { transform: none; }
    .pf-live-dot { animation: none; }
  }
</style>

<script>
  // Galeria guiada pelo scroll vertical: progresso da seção -> posição no trilho.
  // Cada projeto tem uma "parada" (fica centralizado por um trecho do scroll).
  const initPortfolio = () => {
    const section = document.getElementById('portfolio');
    if (!section) return;
    const stage = section.querySelector<HTMLElement>('.pf-stage');
    const track = section.querySelector<HTMLElement>('.pf-track');
    const cards = Array.from(section.querySelectorAll<HTMLElement>('[data-pf-card]'));
    const dots = Array.from(section.querySelectorAll<HTMLButtonElement>('[data-pf-dot]'));
    const prev = section.querySelector<HTMLButtonElement>('[data-pf-prev]');
    const next = section.querySelector<HTMLButtonElement>('[data-pf-next]');
    const current = section.querySelector<HTMLElement>('[data-pf-current]');
    if (!stage || !track || !cards.length) return;

    const N = cards.length;
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let active = -1;
    let raf = 0;

    const clamp = (v: number, a = 0, b = 1) => Math.min(b, Math.max(a, v));
    // Segura o card no centro em parte do trecho e desliza no restante
    const hold = (t: number) => {
      const x = clamp((t - 0.3) / 0.4);
      return reduced ? Math.round(x) : x * x * (3 - 2 * x);
    };

    const progress = () => {
      const r = section.getBoundingClientRect();
      const span = r.height - window.innerHeight;
      return span > 0 ? clamp(-r.top / span) : 0;
    };

    const setActive = (i: number) => {
      if (i === active) return;
      active = i;
      cards.forEach((c, k) => c.classList.toggle('is-active', k === i));
      dots.forEach((d, k) => {
        d.classList.toggle('is-active', k === i);
        d.setAttribute('aria-current', k === i ? 'true' : 'false');
      });
      if (current) current.textContent = String(i + 1).padStart(2, '0');
      section.style.setProperty('--accent', cards[i].dataset.accent || '#D4AF37');
      if (prev) prev.disabled = i === 0;
      if (next) next.disabled = i === N - 1;
    };

    // Ajusta a largura do card ao espaço vertical real (print + informações)
    const fit = () => {
      section.style.removeProperty('--card-fit');
      const maxW = cards[0].offsetWidth;
      const pad = parseFloat(getComputedStyle(stage).paddingTop) || 0;
      const avail = stage.clientHeight - pad - 6;
      const info = Math.max(...cards.map((c) => c.querySelector<HTMLElement>('.pf-info')?.offsetHeight || 0)) + 4;
      const bar = cards[0].querySelector<HTMLElement>('.pf-bar')?.offsetHeight || 0;
      const byHeight = (avail - info - bar) * (1584 / 849);
      const w = Math.max(220, Math.min(maxW, byHeight));
      section.style.setProperty('--card-fit', `${Math.floor(w)}px`);
    };

    const render = () => {
      raf = 0;
      const raw = progress() * (N - 1);
      const base = Math.min(N - 2, Math.floor(raw));
      const pos = N > 1 ? base + hold(raw - base) : 0;

      const w = cards[0].offsetWidth;
      const gap = parseFloat(getComputedStyle(track).columnGap || '0') || 0;
      const step = w + gap;
      const offset = (section.clientWidth - w) / 2;
      track.style.transform = `translate3d(${(offset - pos * step).toFixed(1)}px,0,0)`;

      cards.forEach((c, k) => {
        const d = Math.abs(k - pos);
        const s = 1 - Math.min(d, 1.5) * 0.08;
        c.style.transform = `scale(${s.toFixed(4)})`;
        c.style.opacity = String(Math.max(0.25, 1 - d * 0.65).toFixed(3));
      });
      setActive(Math.round(pos));
    };

    const schedule = () => {
      if (!raf) raf = requestAnimationFrame(render);
    };

    // Leva o scroll até a parada de um projeto
    const goTo = (i: number) => {
      const target = clamp(i, 0, N - 1);
      const r = section.getBoundingClientRect();
      const span = r.height - window.innerHeight;
      const y = window.scrollY + r.top + (N > 1 ? (target / (N - 1)) * span : 0);
      window.scrollTo({ top: y, behavior: reduced ? 'auto' : 'smooth' });
    };

    prev?.addEventListener('click', () => goTo(active - 1));
    next?.addEventListener('click', () => goTo(active + 1));
    dots.forEach((d, k) => d.addEventListener('click', () => goTo(k)));

    window.addEventListener('scroll', schedule, { passive: true });
    window.addEventListener('resize', () => { fit(); schedule(); });
    document.fonts?.ready.then(() => { fit(); schedule(); });
    fit();
    render();
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initPortfolio);
  } else {
    initPortfolio();
  }
</script>
