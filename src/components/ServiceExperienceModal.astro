    #shelf-service-modal .ax-split .ax-list li { font-size: 14px; }
    #shelf-service-modal .ax-tl-step { padding-top: 30px; }
    #shelf-service-modal .ax-tl-step p { font-size: 13px; }
    #shelf-service-modal .ax-cta { padding-top: 48px; padding-bottom: 48px; }
    #shelf-service-modal .ax-cta-box { padding: 48px 32px; }
    #shelf-service-modal .ax-phone { height: 90%; border-radius: 38px; padding: 8px; }
    #shelf-service-modal .ax-phone-screen { border-radius: 31px; }
    #shelf-service-modal .ax-phone-island { top: 14px; height: 18px; }
    #shelf-service-modal .ax-gsearch { top: 42px; padding: 8px 12px; font-size: 11px; }
    #shelf-service-modal .ax-profile { gap: 5px; padding: 10px 14px 16px; }
    #shelf-service-modal .ax-pcat,
    #shelf-service-modal .ax-pmeta li:nth-child(n+3) { display: none; }
    #shelf-service-modal .ax-pname { font-size: 15px; }
    #shelf-service-modal .ax-pbtns span { padding: 7px 0; }
  }

  @media (max-width: 900px) {
    #shelf-service-modal .ax-split {
      grid-template-columns: 1fr;
      grid-template-rows: auto minmax(0, 1fr);
      align-items: start;
      gap: 8px;
      padding-top: 5vh;
      padding-bottom: 3vh;
    }
    #shelf-service-modal .ax-split .ax-h3 { font-size: clamp(26px, 7vw, 38px); margin-bottom: 10px; }
    #shelf-service-modal .ax-split .ax-p,
    #shelf-service-modal .ax-split .ax-list li { font-size: 14px; }
    #shelf-service-modal .ax-split .ax-list { gap: 6px; }
    #shelf-service-modal .ax-split .ax-tag { margin-bottom: 10px; }
    #shelf-service-modal .ax-sim-chips { margin-top: 12px; }
    #shelf-service-modal .ax-device-wrap { min-height: 0; }
    #shelf-service-modal .ax-phone { height: 100%; max-height: 520px; }
    #shelf-service-modal .ax-particles { height: 100%; }

    #shelf-service-modal .ax-features-stage { grid-template-columns: 1fr; }
    #shelf-service-modal .ax-feature-visual { display: none; }

    #shelf-service-modal .ax-tl-line {
      left: 7px;
      right: auto;
      top: 0;
      bottom: 0;
      width: 2px;
      height: auto;
    }
    #shelf-service-modal .ax-tl-line span {
      width: 100%;
      height: 100%;
      transform-origin: 50% 0;
      transform: scaleY(clamp(0, calc(var(--p, 0) * 1.15), 1));
    }
    #shelf-service-modal .ax-tl-steps { grid-template-columns: 1fr; gap: 18px; }
    #shelf-service-modal .ax-tl-step { padding: 0 0 0 40px; }
    #shelf-service-modal .ax-tl-step h4 { margin: 6px 0 4px; font-size: 19px; }
    #shelf-service-modal .ax-tl-step p { font-size: 13px; }
  }

  @media (max-width: 600px) {
    /* Título do hero flui naturalmente (sem palavras órfãs) */
    #shelf-service-modal .ax-hero-title { font-size: clamp(30px, 8.6vw, 40px); line-height: 1.06; }
    #shelf-service-modal .ax-line { display: inline; overflow: visible; padding: 0; margin: 0; }
    #shelf-service-modal .ax-line > span { display: inline; }
    #shelf-service-modal .ax-line::after { content: " "; }
    #shelf-service-modal .ax-line:not(.ax-gold) + .ax-gold::before { content: "\A"; white-space: pre; }
    #shelf-service-modal .ax-hero-num { font-size: 70vw; right: -8vw; opacity: 0.6; }
    #shelf-service-modal .ax-chips li { font-size: 12px; padding: 8px 12px; }
    #shelf-service-modal .ax-browser { aspect-ratio: 4 / 5; }
    #shelf-service-modal .ax-good-score { top: auto; bottom: 22%; }
    #shelf-service-modal .ax-feature-list li { grid-template-columns: 32px 1fr; }
    #shelf-service-modal .ax-shot { width: 78vw; }
    #shelf-service-modal .ax-cta-box { border-radius: 24px; }
    #shelf-service-modal .ax-btn { width: 100%; justify-content: center; }
  }

  /* Celular/tablet: o selo "Exemplo ilustrativo" fica acima da ilustração, sem cobrir o conteúdo */
  @media (max-width: 900px) {
    #shelf-service-modal .ax-device-wrap { padding-top: 36px; box-sizing: border-box; }
    #shelf-service-modal .ax-illus { top: 2px; right: auto; left: 50%; transform: translateX(-50%); }
  }

  @media (prefers-reduced-motion: reduce) {
    #shelf-service-modal .ax-line > span,
    #shelf-service-modal .ax-kicker,
    #shelf-service-modal .ax-hero-lead,
    #shelf-service-modal .ax-chips li,
    #shelf-service-modal .ax-scroll-cue { transform: none !important; opacity: 1 !important; animation: none !important; }
    #shelf-service-modal .ax-aurora,
    #shelf-service-modal .ax-grid-floor,
    #shelf-service-modal .ax-radar i,
    #shelf-service-modal .ax-beams i { animation: none !important; }
    #shelf-service-modal .rv { opacity: 1; transform: none; filter: none; }
  }
</style>

<script>
  // ==========================================================================
  // K. UP BIZ — MOTOR DE CENAS DO OVERLAY DE SERVIÇOS
  // Calcula o progresso de cada cena [data-scrub] dentro do contêiner de
  // scroll do modal e publica em variáveis CSS (--p, --s0..--sN). A abertura,
  // o fechamento e a troca de abas continuam sendo controlados pelo
  // DigitalShelf.astro — este script apenas observa essas mudanças.
  // ==========================================================================
  const initServiceScenes = () => {
    const modal = document.getElementById('shelf-service-modal');
    // O modal fica dentro da seção Soluções (z-index 6); levamos ele para o fim do <body>
    // para que nenhuma outra seção (ex.: o Hero, z-index 10) passe por cima dele.
    if (modal && modal.parentElement !== document.body) document.body.appendChild(modal);
    const scroller = document.getElementById('service-scroll-container');
    const header = document.getElementById('service-modal-header');
    if (!modal || !scroller) return;

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const clamp = (v: number, a = 0, b = 1) => Math.min(b, Math.max(a, v));
    const views = Array.from(modal.querySelectorAll<HTMLElement>('.service-experience-view'));

    // Barra de progresso de leitura no cabeçalho
    let progressEl: HTMLElement | null = null;
    if (header && !header.querySelector('.ax-progress')) {
      progressEl = document.createElement('div');
      progressEl.className = 'ax-progress';
      progressEl.innerHTML = '<span></span>';
      header.appendChild(progressEl);
    }

    // Quebra os textos de declaração em palavras (uma vez)
    const KEYWORDS = /^(confiança|confiança\.|investimento\.|decisões\.|Google\.|também\.|momento\.)$/i;
    modal.querySelectorAll<HTMLElement>('[data-words]').forEach((el) => {
      const words = (el.textContent || '').trim().split(/\s+/);
      el.innerHTML = words
        .map((w) => `<span class="ax-word${KEYWORDS.test(w) ? ' is-key' : ''}">${w}</span>`)
        .join(' ');
    });

    // Partículas (REACH)
    type Particle = { sx: number; sy: number; tx: number; ty: number; q: boolean; ph: number; r: number };
    const canvasStates = new Map<HTMLCanvasElement, { parts: Particle[]; w: number; h: number; ctx: CanvasRenderingContext2D }>();

    const buildParticles = (canvas: HTMLCanvasElement) => {
      const rect = canvas.getBoundingClientRect();
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      const w = Math.max(1, rect.width);
      const h = Math.max(1, rect.height);
      canvas.width = w * dpr;
      canvas.height = h * dpr;
      const ctx = canvas.getContext('2d');
      if (!ctx) return;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      const m = Math.min(w, h);
      const parts: Particle[] = [];
      const N = w < 500 ? 150 : 240;
      let seed = 7;
      const rnd = () => ((seed = (seed * 16807) % 2147483647) / 2147483647);
      for (let i = 0; i < N; i++) {
        const q = i % 3 === 0;
        const ang = rnd() * Math.PI * 2;
        let tx: number, ty: number;
        if (q) {
          const ring = [0.1, 0.19, 0.28][i % 9 === 0 ? 0 : i % 2 ? 1 : 2];
          tx = w / 2 + Math.cos(ang) * m * ring;
          ty = h / 2 + Math.sin(ang) * m * ring;
        } else {
          const d = m * (0.55 + rnd() * 0.4);
          tx = w / 2 + Math.cos(ang) * d;
          ty = h / 2 + Math.sin(ang) * d;
        }
        parts.push({ sx: rnd() * w, sy: rnd() * h, tx, ty, q, ph: rnd() * Math.PI * 2, r: 1 + rnd() * 1.8 });
      }
      canvasStates.set(canvas, { parts, w, h, ctx });
    };

    const ease = (t: number) => (t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2);

    const drawParticles = (canvas: HTMLCanvasElement, p: number, time: number) => {
      const st = canvasStates.get(canvas);
      if (!st) return;
      const { parts, w, h, ctx } = st;
      const t = ease(clamp((p - 0.2) / 0.55));
      const m = Math.min(w, h);
      ctx.clearRect(0, 0, w, h);

      // Anéis do alvo
      if (t > 0.01) {
        [0.1, 0.19, 0.28].forEach((r, i) => {
          ctx.beginPath();
          ctx.arc(w / 2, h / 2, m * r, 0, Math.PI * 2 * clamp(t * 1.3 - i * 0.15));
          ctx.strokeStyle = `rgba(212,175,55,${0.35 * t})`;
          ctx.lineWidth = 1;
          ctx.stroke();
        });
        const g = ctx.createRadialGradient(w / 2, h / 2, 0, w / 2, h / 2, m * 0.32);
        g.addColorStop(0, `rgba(212,175,55,${0.16 * t})`);
        g.addColorStop(1, 'rgba(212,175,55,0)');
        ctx.fillStyle = g;
        ctx.fillRect(0, 0, w, h);
      }

      for (const pt of parts) {
        const wob = reduced ? 0 : (1 - t * 0.85) * 10;
        const wx = Math.sin(time * 0.0007 + pt.ph) * wob;
        const wy = Math.cos(time * 0.0009 + pt.ph) * wob;
        const x = pt.sx + (pt.tx - pt.sx) * t + wx;
        const y = pt.sy + (pt.ty - pt.sy) * t + wy;
        let a: number, col: string, r = pt.r;
        if (pt.q) {
          a = 0.45 + t * 0.55;
          col = t > 0.3 ? '212,175,55' : '245,241,232';
          r = pt.r + t * 0.8;
        } else {
          a = 0.45 - t * 0.35;
          col = '245,241,232';
        }
        ctx.beginPath();
        ctx.arc(x, y, r, 0, Math.PI * 2);
        ctx.fillStyle = `rgba(${col},${a})`;
        if (pt.q && t > 0.5) {
          ctx.shadowColor = 'rgba(212,175,55,0.9)';
          ctx.shadowBlur = 8 * t;
        } else {
          ctx.shadowBlur = 0;
        }
        ctx.fill();
      }
      ctx.shadowBlur = 0;
    };

    // ------------------------------------------------------------------------
    // Estado da view ativa
    // ------------------------------------------------------------------------
    let active: HTMLElement | null = null;
    let scenes: HTMLElement[] = [];
    let reveals: IntersectionObserver | null = null;
    let raf = 0;
    let loopRaf = 0;

    const measure = () => {
      const vh = scroller.clientHeight;
      scroller.style.setProperty('--svh', `${vh}px`);
      scenes.forEach((el) => {
        const n = el.dataset.n;
        if (n) el.style.setProperty('--n', n);
        if (el.hasAttribute('data-h')) {
          const track = el.querySelector<HTMLElement>('.ax-track');
          if (track) {
            const dist = Math.max(0, track.scrollWidth - scroller.clientWidth);
            el.style.setProperty('--dist', `${dist}px`);
            el.style.height = `${vh + dist * 1.15}px`;
          }
        }
      });
      modal.querySelectorAll<HTMLCanvasElement>('.service-experience-view.is-active canvas.ax-particles').forEach(buildParticles);
    };

    const update = (time = performance.now()) => {
      raf = 0;
      if (!active) return;
      const vh = scroller.clientHeight;
      const top = scroller.getBoundingClientRect().top;
      const max = scroller.scrollHeight - vh;
      progressEl?.style.setProperty('--read', max > 0 ? (scroller.scrollTop / max).toFixed(4) : '0');

      scenes.forEach((el) => {
        const r = el.getBoundingClientRect();
        const span = r.height - vh;
        const p = span > 0 ? clamp((top - r.top) / span) : 0;
        el.style.setProperty('--p', p.toFixed(4));

        const n = Number(el.dataset.n || 0);
        if (n) {
          const step = Math.min(n - 1, Math.floor(p * n));
          for (let i = 0; i < n; i++) {
            el.style.setProperty(`--s${i}`, clamp(p * n - i).toFixed(4));
          }
          if (el.dataset.step !== String(step)) {
            el.dataset.step = String(step);
            el.querySelectorAll<HTMLElement>('[data-step]').forEach((c) => {
              if (c === el) return;
              const k = Number(c.dataset.step);
              c.classList.toggle('on', k === step);
              c.classList.toggle('past', k < step);
            });
          }
        }

        if (el.classList.contains('ax-statement')) {
          const words = el.querySelectorAll<HTMLElement>('.ax-word');
          const lit = clamp((p - 0.08) / 0.75) * words.length;
          words.forEach((w, i) => {
            w.style.opacity = String(0.14 + 0.86 * clamp(lit - i));
          });
        }

        const canvas = el.querySelector<HTMLCanvasElement>('canvas.ax-particles');
        if (canvas) drawParticles(canvas, p, time);
      });
    };

    const schedule = () => {
      if (document.hidden) return update();
      if (!raf) raf = requestAnimationFrame(() => update());
    };

    // Loop leve apenas enquanto a cena de partículas está visível (respiração)
    const particleLoop = (time: number) => {
      loopRaf = 0;
      if (!active || !modal.classList.contains('is-active')) return;
      const scene = active.querySelector<HTMLElement>('.ax-particles-scene');
      if (!scene) return;
      const r = scene.getBoundingClientRect();
      if (r.bottom > 0 && r.top < window.innerHeight) update(time);
      loopRaf = requestAnimationFrame(particleLoop);
    };

    // Remove a classe de entrada sem disparar o observer em loop
    const clearEntered = () => {
      views.forEach((v) => {
        if (v.classList.contains('ax-entered')) v.classList.remove('ax-entered');
      });
      mo.takeRecords();
    };

    const activate = () => {
      const next = views.find((v) => v.classList.contains('is-active')) || null;
      const open = modal.classList.contains('is-active');
      if (!open) {
        clearEntered();
        active = null;
        if (loopRaf) cancelAnimationFrame(loopRaf);
        loopRaf = 0;
        return;
      }
      if (next === active) return;
      active = next;
      if (!active) return;

      scenes = Array.from(active.querySelectorAll<HTMLElement>('[data-scrub]'));
      scenes.forEach((el) => delete el.dataset.step);

      // Reinicia animação de entrada do hero
      clearEntered();
      void active.offsetWidth;
      setTimeout(() => {
        if (active && !active.classList.contains('ax-entered')) active.classList.add('ax-entered');
        mo.takeRecords();
      }, 30);

      // Revelações ao entrar na tela
      reveals?.disconnect();
      const rvEls = active.querySelectorAll<HTMLElement>('.rv');
      rvEls.forEach((el) => el.classList.remove('in'));
      reveals = new IntersectionObserver(
        (entries) => entries.forEach((e) => e.isIntersecting && e.target.classList.add('in')),
        { root: scroller, threshold: 0.2 }
      );
      rvEls.forEach((el) => reveals!.observe(el));

      measure();
      update();
      if (!loopRaf && active.querySelector('.ax-particles-scene')) {
        loopRaf = requestAnimationFrame(particleLoop);
      }
    };

    // Observa abertura/fechamento do modal e troca de abas feitas pelo DigitalShelf
    const mo = new MutationObserver(activate);
    mo.observe(modal, { attributes: true, attributeFilter: ['class'] });
    views.forEach((v) => mo.observe(v, { attributes: true, attributeFilter: ['class'] }));

    scroller.addEventListener('scroll', schedule, { passive: true });
    window.addEventListener('resize', () => {
      if (!active) return;
      measure();
      schedule();
    });

    // Recalcula a galeria quando as imagens carregarem
    modal.querySelectorAll<HTMLImageElement>('.ax-shot img').forEach((img) => {
      if (!img.complete) img.addEventListener('load', () => active && (measure(), schedule()), { once: true });
    });

    // Luz que segue o cursor no CTA + botão magnético
    modal.querySelectorAll<HTMLElement>('[data-glow]').forEach((box) => {
      box.addEventListener('pointermove', (e) => {
        const r = box.getBoundingClientRect();
        box.style.setProperty('--mx', `${e.clientX - r.left}px`);
        box.style.setProperty('--my', `${e.clientY - r.top}px`);
      });
    });
    if (!reduced && window.matchMedia('(hover: hover)').matches) {
      modal.querySelectorAll<HTMLElement>('[data-magnetic]').forEach((btn) => {
        btn.addEventListener('pointermove', (e) => {
          const r = btn.getBoundingClientRect();
          const dx = (e.clientX - (r.left + r.width / 2)) * 0.25;
          const dy = (e.clientY - (r.top + r.height / 2)) * 0.35;
          btn.style.translate = `${dx}px ${dy}px`;
        });
        btn.addEventListener('pointerleave', () => {
          btn.style.translate = '0 0';
        });
      });
    }

    // Acessibilidade: abas com setas do teclado e foco preso dentro do modal aberto
    const tabs = Array.from(modal.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
    const syncTabs = () => tabs.forEach((t) => (t.tabIndex = t.getAttribute('aria-selected') === 'true' ? 0 : -1));
    tabs.forEach((tab, idx) => {
      tab.addEventListener('keydown', (e) => {
        let to = -1;
        if (e.key === 'ArrowRight') to = (idx + 1) % tabs.length;
        if (e.key === 'ArrowLeft') to = (idx - 1 + tabs.length) % tabs.length;
        if (e.key === 'Home') to = 0;
        if (e.key === 'End') to = tabs.length - 1;
        if (to < 0) return;
        e.preventDefault();
        tabs[to].click();
        tabs[to].focus();
      });
    });
    new MutationObserver(syncTabs).observe(modal, { subtree: true, attributes: true, attributeFilter: ['aria-selected'] });

    modal.addEventListener('keydown', (e) => {
      if (e.key !== 'Tab' || !modal.classList.contains('is-active')) return;
      const focusables = Array.from(
        modal.querySelectorAll<HTMLElement>('a[href], button:not([disabled]), [tabindex="0"]')
      ).filter((el) => el.offsetParent !== null && !el.closest('[aria-hidden="true"]'));
      if (!focusables.length) return;
      const first = focusables[0];
      const last = focusables[focusables.length - 1];
      if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
      else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
    });

    activate();
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initServiceScenes);
  } else {
    initServiceScenes();
  }
</script>
