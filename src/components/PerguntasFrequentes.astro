  /* Acessibilidade: prefers-reduced-motion */
  @media (prefers-reduced-motion: reduce) {
    .faq-panel,
    .faq-icon-wrap,
    .faq-icon-line,
    .eyebrow-pip,
    .sculpture-stage,
