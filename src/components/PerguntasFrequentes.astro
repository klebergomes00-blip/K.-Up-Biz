      transition: none !important;
      animation: none !important;
    }
  }
  /* ==========================================================================
     ESFERA DE VIDRO + INTERROGAÇÃO EM OURO (substitui o SVG antigo)
     ========================================================================== */
  .sculpture-container.qx {
    max-width: 420px;
    height: 330px;
    pointer-events: auto;
  }

  .qx .orbital-system { z-index: 1; }
  .qx .ring-1 { width: 300px; height: 300px; }
  .qx .ring-3 { width: 360px; height: 360px; }

  .qx-orb {
    position: relative;
    width: 210px;
    height: 210px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    filter: drop-shadow(0 30px 40px rgba(0, 0, 0, 0.55));
    z-index: 4;
  }

  /* Corpo de vidro escuro */
  .qx-glass {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background:
      radial-gradient(circle at 50% 120%, rgba(4, 120, 87, 0.55), transparent 60%),
      radial-gradient(circle at 30% 25%, rgba(245, 241, 232, 0.10), transparent 45%),
      radial-gradient(circle at 50% 50%, rgba(6, 34, 27, 0.92), rgba(3, 13, 11, 0.96) 70%);
    box-shadow:
      inset 0 2px 1px rgba(255, 255, 255, 0.10),
      inset 0 -18px 40px rgba(4, 120, 87, 0.35),
      inset 0 0 0 1px rgba(245, 241, 232, 0.08);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
  }

  /* Borda dourada que gira lentamente */
  .qx-rim {
    position: absolute;
    inset: -3px;
    border-radius: 50%;
    background: conic-gradient(
      from 0deg,
      rgba(212, 175, 55, 0) 0deg,
      rgba(243, 229, 171, 0.95) 50deg,
      rgba(212, 175, 55, 0.6) 95deg,
      rgba(212, 175, 55, 0) 150deg,
      rgba(4, 120, 87, 0.5) 230deg,
      rgba(212, 175, 55, 0) 300deg
    );
    -webkit-mask: radial-gradient(farthest-side, transparent calc(100% - 2px), #000 calc(100% - 1.5px));
    mask: radial-gradient(farthest-side, transparent calc(100% - 2px), #000 calc(100% - 1.5px));
    animation: qxRimSpin 9s linear infinite;
    filter: drop-shadow(0 0 6px rgba(212, 175, 55, 0.55));
  }
  @keyframes qxRimSpin { to { transform: rotate(360deg); } }

  /* Luz dourada refletida no fundo da esfera */
  .qx-caustic {
    position: absolute;
    left: 22%;
    right: 22%;
    bottom: 10%;
    height: 26%;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgba(243, 229, 171, 0.35), transparent);
    filter: blur(10px);
    animation: qxCaustic 4.5s ease-in-out infinite;
  }
  @keyframes qxCaustic {
    0%, 100% { opacity: 0.55; transform: scaleX(1); }
    50% { opacity: 0.95; transform: scaleX(1.15); }
  }

  /* Símbolos ? e ! */
  .qx-glyph-wrap {
    position: relative;
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    perspective: 600px;
    z-index: 2;
  }
  .qx-glyph {
    grid-area: 1 / 1;
    font-family: 'Instrument Serif', Georgia, serif;
    font-style: italic;
    font-weight: 400;
    font-size: 150px;
    line-height: 1;
    padding: 0 0.12em 0.06em 0;
    background: linear-gradient(160deg, #FFF6D6 0%, #F3E5AB 18%, #D4AF37 45%, #9C7720 70%, #E8C766 88%, #B8912A 100%);
    background-size: 100% 220%;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    filter: drop-shadow(0 6px 10px rgba(0, 0, 0, 0.55)) drop-shadow(0 0 22px rgba(212, 175, 55, 0.35));
    backface-visibility: hidden;
    transition: transform 0.9s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.6s ease;
    user-select: none;
  }
  .qx-q {
    transform-origin: 50% 82%;
    animation: qxSwing 5.5s ease-in-out infinite, qxShine 7s ease-in-out infinite;
  }
  .qx-a {
    opacity: 0;
    transform: rotateY(-90deg) scale(0.8);
  }
  @keyframes qxSwing {
    0%, 100% { rotate: -5deg; }
    50% { rotate: 5deg; }
  }
  @keyframes qxShine {
    0%, 100% { background-position: 0 0%; }
    50% { background-position: 0 100%; }
  }

  /* Reação: pergunta aberta -> "?" vira "!" */
  .qx.is-answered .qx-q { opacity: 0; transform: rotateY(90deg) scale(0.8); }
  .qx.is-answered .qx-a { opacity: 1; transform: none; }
  .qx.is-answered .qx-rim { animation-duration: 2.5s; }

  /* Brilhos do vidro (por cima do símbolo) */
  .qx-specular {
    position: absolute;
    top: 7%;
    left: 16%;
    width: 46%;
    height: 26%;
    border-radius: 50%;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.22), rgba(255, 255, 255, 0));
    transform: rotate(-24deg);
    z-index: 3;
    pointer-events: none;
  }
  .qx-reflection {
    position: absolute;
    bottom: 12%;
    right: 18%;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.5);
    filter: blur(2px);
    z-index: 3;
  }

  /* Pílulas flutuantes */
  .qx-chip {
    position: absolute;
    z-index: 6;
    padding: 8px 14px;
    border-radius: 999px;
    border: 1px solid rgba(245, 241, 232, 0.14);
    background: rgba(8, 26, 21, 0.72);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
    color: rgba(245, 241, 232, 0.88);
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.01em;
    cursor: pointer;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.35);
    animation: qxBob 6s ease-in-out infinite;
    transition: border-color 0.3s ease, color 0.3s ease, background 0.3s ease, box-shadow 0.3s ease, scale 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .qx-chip::before {
    content: '';
    display: inline-block;
    width: 6px;
    height: 6px;
    margin-right: 8px;
    border-radius: 50%;
    background: #D4AF37;
    box-shadow: 0 0 8px #D4AF37;
    vertical-align: 1px;
  }
  .qx-chip:hover,
  .qx-chip:focus-visible {
    animation-play-state: paused;
    border-color: rgba(212, 175, 55, 0.7);
    color: #F3E5AB;
    background: rgba(20, 40, 30, 0.85);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.35), 0 0 24px rgba(212, 175, 55, 0.25);
    scale: 1.06;
    outline: none;
  }
  .qx-chip.is-current {
    border-color: #D4AF37;
    color: #030D0B;
    background: linear-gradient(135deg, #D4AF37, #F3E5AB);
  }
  .qx-chip.is-current::before { background: #030D0B; box-shadow: none; }

  .qx-chip-1 { top: 10%; right: 2%; animation-delay: -1s; }
  .qx-chip-2 { top: 30%; left: 0; animation-delay: -3s; }
  .qx-chip-3 { bottom: 14%; left: 6%; animation-delay: -2s; }
  .qx-chip-4 { bottom: 6%; right: 6%; animation-delay: -4.5s; }

  @keyframes qxBob {
    0%, 100% { translate: 0 0; }
    50% { translate: 0 -10px; }
  }

  @media (max-width: 1024px) {
    .sculpture-container.qx { max-width: 380px; height: 300px; }
    .qx-orb { width: 180px; height: 180px; }
    .qx-glyph { font-size: 128px; }
    .qx .ring-1 { width: 250px; height: 250px; }
    .qx .ring-3 { width: 300px; height: 300px; }
  }

  @media (max-width: 640px) {
    .sculpture-container.qx { max-width: 100%; height: 210px; margin: 6px auto 16px; }
    .qx .sculpture-stage { width: 140px; height: 160px; }
    .qx-orb { width: 128px; height: 128px; }
    .qx-glyph { font-size: 92px; }
    .qx .ring-1 { width: 170px; height: 170px; }
    .qx .ring-3 { width: 200px; height: 200px; }
    .qx-chip { font-size: 12px; padding: 7px 11px; }
    .qx-chip::before { width: 5px; height: 5px; margin-right: 6px; }
    .qx-chip-1 { top: 4%; right: 0; }
    .qx-chip-2 { top: 40%; left: 0; }
    .qx-chip-3 { bottom: 4%; left: 4%; }
    .qx-chip-4 { bottom: 12%; right: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .qx-rim, .qx-caustic, .qx-q, .qx-chip { animation: none !important; }
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const initFaqExperience = () => {
    const faqSection = document.getElementById('faq');
    if (!faqSection) return;

    const sculptureCore = faqSection.querySelector('#sculpture-core') as HTMLElement | null;
    const sculptureHalo = faqSection.querySelector('#sculpture-halo') as HTMLElement | null;
    const orbitalSystem = faqSection.querySelector('#orbital-system') as HTMLElement | null;

    // 1. Interatividade do Accordion + Reação Cinematográfica da Escultura
    const items = faqSection.querySelectorAll('.faq-item');
    items.forEach((item) => {
      const btn = item.querySelector('.faq-trigger') as HTMLButtonElement | null;
      if (!btn) return;

      btn.addEventListener('click', () => {
        const isOpen = item.classList.contains('is-open');

        // Fecha os demais para manter leitura limpa
        items.forEach((other) => {
          if (other !== item) {
            other.classList.remove('is-open');
            const otherBtn = other.querySelector('.faq-trigger');
            if (otherBtn) otherBtn.setAttribute('aria-expanded', 'false');
          }
        });

        // Alterna o item clicado
        if (isOpen) {
          item.classList.remove('is-open');
          btn.setAttribute('aria-expanded', 'false');
        } else {
          item.classList.add('is-open');
          btn.setAttribute('aria-expanded', 'true');

          // Reação Cinematográfica Discreta na Escultura 3D (Sem distração)
          if (
            sculptureCore &&
            sculptureHalo &&
            !window.matchMedia('(prefers-reduced-motion: reduce)').matches
          ) {
            // A. Micro-rotação amortecida no eixo Y e X
            gsap.fromTo(
              sculptureCore,
              {
                rotationY: 15,
                rotationX: -6,
                scale: 1.05
              },
              {
                rotationY: 0,
                rotationX: 0,
                scale: 1,
                duration: 1.4,
                ease: 'power2.out'
              }
            );

            // B. Pulso suave no Halo Esmeralda / Dourado
            gsap.fromTo(
              sculptureHalo,
              {
                scale: 1.25,
                opacity: 0.8
              },
              {
                scale: 1,
                opacity: 0.45,
                duration: 1.5,
                ease: 'power2.out'
              }
            );

            // C. Leve oscilação angular dos anéis orbitais
            if (orbitalSystem) {
              gsap.fromTo(
                orbitalSystem,
                { rotationZ: '+=12deg' },
                { rotationZ: 0, duration: 1.8, ease: 'power2.out' }
              );
            }
          }
        }
      });
    });

    // 2. Animação Suave de Entrada GSAP (ScrollTrigger natural, sem pinning prolongado)
    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      ScrollTrigger.create({
        trigger: faqSection,
        start: 'top 85%',
        once: true,
        onEnter: () => {
          const tl = gsap.timeline();

          // Ato 1: Identificação editorial
          tl.from(faqSection.querySelector('.faq-eyebrow'), {
            opacity: 0,
            y: 14,
            duration: 0.4,
            ease: 'power2.out'
          })
          // Ato 2: Título com máscara vertical
          .from(faqSection.querySelector('.headline-line'), {
            opacity: 0,
            y: 20,
            duration: 0.5,
            ease: 'power3.out'
          }, '-=0.25')
          .from(faqSection.querySelector('.headline-highlight'), {
            opacity: 0,
            y: 18,
            duration: 0.5,
            ease: 'power3.out'
          }, '-=0.35')
          // Ato 3: Descrição e divisor
          .from(faqSection.querySelector('.faq-gold-divider'), {
            scaleX: 0,
            transformOrigin: 'left center',
            duration: 0.4,
            ease: 'power2.out'
          }, '-=0.3')
          .from(faqSection.querySelector('.faq-description'), {
            opacity: 0,
            y: 12,
            duration: 0.4,
            ease: 'power2.out'
          }, '-=0.25')
          // Ato 4: Escultura tridimensional e anéis orbitais
          .from(faqSection.querySelector('.sculpture-container'), {
            opacity: 0,
            y: 20,
            scale: 0.94,
            duration: 0.6,
            ease: 'back.out(1.2)'
          }, '-=0.35')
          .from(faqSection.querySelectorAll('.orbital-ring'), {
            opacity: 0,
            scale: 0.88,
            duration: 0.5,
            stagger: 0.05,
            ease: 'power2.out'
          }, '-=0.45')
          // Ato 5: Selo e perguntas com stagger suave
          .from(faqSection.querySelector('.faq-editorial-badge'), {
            opacity: 0,
            y: 10,
            duration: 0.35,
            ease: 'power2.out'
          }, '-=0.3')
          .fromTo(
            faqSection.querySelectorAll('.faq-item'),
            { opacity: 0, y: 16 },
            {
              opacity: 1,
              y: 0,
              duration: 0.4,
              stagger: 0.04,
              ease: 'power2.out',
              clearProps: 'opacity,transform'
            },
            '-=0.45'
          );
        }
      });
    }
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initFaqExperience);
  } else {
    initFaqExperience();
  }

  // Refresh ScrollTrigger when intro completes
  window.addEventListener('cinematic-intro-complete', () => {
    ScrollTrigger.refresh();
  });
</script>

<script>
  // Esfera da FAQ: "?" vira "!" ao abrir uma pergunta e pílulas abrem respostas
  const initFaqOrb = () => {
    const section = document.getElementById('faq');
    const orb = section?.querySelector<HTMLElement>('.qx');
    if (!section || !orb) return;
    let timer = 0;
    const chips = Array.from(orb.querySelectorAll<HTMLButtonElement>('.qx-chip'));

    const syncChips = () => {
      const open = section.querySelector('.faq-item.is-open');
      const id = open?.id.replace('faq-item-', '');
      chips.forEach((c) => c.classList.toggle('is-current', c.dataset.faqTarget === id));
    };

    section.querySelectorAll<HTMLButtonElement>('.faq-trigger').forEach((btn) => {
      btn.addEventListener('click', () => {
        setTimeout(() => {
          syncChips();
          if (btn.getAttribute('aria-expanded') === 'true') {
            orb.classList.add('is-answered');
            clearTimeout(timer);
            timer = window.setTimeout(() => orb.classList.remove('is-answered'), 1800);
          }
        }, 0);
      });
    });

    chips.forEach((chip) => {
      chip.addEventListener('click', () => {
        const target = section.querySelector<HTMLButtonElement>(`#faq-btn-${chip.dataset.faqTarget}`);
        if (!target) return;
        if (target.getAttribute('aria-expanded') !== 'true') target.click();
        else {
          orb.classList.add('is-answered');
          clearTimeout(timer);
          timer = window.setTimeout(() => orb.classList.remove('is-answered'), 1800);
        }
        if (window.innerWidth <= 1024) {
          target.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
        target.focus({ preventScroll: true });
      });
    });

    syncChips();
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initFaqOrb);
  } else {
    initFaqOrb();
  }
</script>
