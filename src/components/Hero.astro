---
// src/components/Hero.astro — Refinamento V2: Composição Editorial
---

<section class="hero-scroll-wrapper" id="hero-scroll-wrapper" aria-label="Apresentação Principal K. UP BIZ">
  <!-- Pinned Viewport Container -->
  <div class="hero-viewport" id="hero-viewport">
    
    <!-- Mídia: Vídeo de Fundo e Imagem do Fundador -->
    <!-- Mídia: Vídeo de Fundo e Fotografia Limpa de Abertura -->
    <div class="hero-media-container" aria-hidden="true">
      <video
        id="hero-video"
        class="hero-video"
        muted
        playsinline
        preload="auto"
        poster="/imagens/hero-poster.png"
      >
        <source src="/videos/hero-desktop-intra-opt.mp4" type="video/mp4" />
        <source src="/videos/hero-desktop.mp4" type="video/mp4" />
      </video>

      <!-- Camada de Fotografia Limpa para Abertura Inicial (0% Scroll) -->
      <div class="hero-photo-layer" id="hero-photo-layer">
        <img
          src="/imagens/hero-poster.png"
          alt="Fundador K. UP BIZ"
          class="hero-photo-img"
          id="hero-photo-img"
          loading="eager"
          decoding="async"
        />
      </div>
      
      <!-- Scrims Cinematográficos para Fusão & Legibilidade Sem Obstrução -->
      <div class="hero-scrim-right"></div>
      <div class="hero-scrim-top"></div>
      <div class="hero-scrim-bottom"></div>
    </div>

    <!-- Camada de Conteúdo Narrativo em 3 Atos (Coluna Direita no Desktop) -->
    <div class="hero-content-container">
      <div class="wrap hero-wrap">
        <div class="hero-stage" id="hero-stage">
          
          <!-- Painel Editorial Liquid Glass Premium (Proteção Óptica para Legibilidade) -->
          <div class="hero-glass-panel" id="hero-glass-panel" aria-hidden="true">
            <div class="glass-reflection-gold"></div>
            <div class="glass-inner-glow"></div>
          </div>
          
          <!-- ================================================================
               MOMENTO 1 — A IDEIA (6% - 28% do Scroll)
               A fotografia do fundador é protagonista. Surge a centelha da ideia.
               ================================================================ -->
          <div class="hero-act hero-act-1" id="hero-act-1">
            <h2 class="act-title act1-title" id="act1-title">
              <span class="act-line act1-prefix">Toda grande transformação começa com</span>
              <span class="act-line act1-lead">
                <span class="italic-serif text-gold act1-highlight">uma ideia.</span>
              </span>
            </h2>

            <!-- Linha Decorativa Minimalista de Pensamento -->
            <div class="act1-decor" aria-hidden="true">
              <div class="act1-decor-line" id="act1-decor-line"></div>
              <div class="act1-decor-spark"></div>
            </div>
          </div>

          <!-- ================================================================
               ATO 2 — A ESTRATÉGIA (32% - 64% do Scroll)
               À medida que as partículas se expandem, surge a estratégia.
               ================================================================ -->
          <div class="hero-act hero-act-2" id="hero-act-2">
            <h2 class="act-title act2-title" id="act2-title">
              <span class="act-line act2-prefix">Uma boa ideia precisa de</span>
              <span class="act-line act2-lead">
                <span class="italic-serif text-gold act2-highlight">estratégia.</span>
              </span>
            </h2>

            <div class="act2-decor" aria-hidden="true">
              <div class="act2-decor-line" id="act2-decor-line"></div>
              <div class="act2-decor-spark"></div>
            </div>
          </div>

          <!-- ================================================================
               ATO 3 — A TRANSFORMAÇÃO (68% - 100% do Scroll)
               A realização completa: Sua empresa não precisa apenas aparecer. Precisa ser encontrada.
               ================================================================ -->
          <div class="hero-act hero-act-3" id="hero-act-3">
            <h1 class="hero-title" id="hero-title-3">
              <span class="title-line title-line-1">Sua empresa não precisa apenas aparecer.</span>
              <span class="title-line title-line-2">
                Precisa <span class="italic-serif text-gold hero-highlight">ser encontrada.</span>
              </span>
            </h1>

            <p class="hero-subtitle" id="hero-subtitle-3">
              Google, sites e tráfego pago trabalhando juntos para transformar visibilidade em oportunidades de negócio.
            </p>

            <div class="hero-cta-group" id="hero-cta-group-3">
              <a href="#contato" class="btn-pill btn-pill-lg hero-cta-primary" id="cta-primary">
                <span>ELEVE SEU NEGÓCIO</span>
                <span aria-hidden="true" class="arrow">
                  <svg fill="none" height="15" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2.4" viewBox="0 0 24 24" width="15">
                    <path d="M7 17 17 7"></path>
                    <path d="M8 7h9v9"></path>
                  </svg>
                </span>
              </a>

              <a href="#solucoes" class="btn-outline hero-cta-secondary" id="cta-secondary">
                <span>CONHEÇA NOSSAS SOLUÇÕES</span>
              </a>
            </div>
          </div>

        </div>
      </div>
    </div>

    <!-- Indicador de Rolagem Minimalista & Editorial -->
    <div class="hero-scroll-indicator" id="hero-scroll-indicator" aria-hidden="true">
      <span class="scroll-explore-text">ROLE PARA EXPLORAR</span>
      <div class="scroll-explore-line">
        <div class="scroll-explore-line-fill"></div>
      </div>
    </div>

    <!-- Linha de Brilho Inferior Canônica do Design System -->
    <div class="hero-bottom-glow" aria-hidden="true"></div>
  </div>
</section>

<style>
  /* ==========================================================================
     HERO V2 — COMPOSIÇÃO EDITORIAL CINEMATOGRÁFICA
     - Desktop: Imagem do fundador à esquerda, conteúdo comercial à direita
     - Mobile: Imagem acima, conteúdo comercial abaixo
     ========================================================================== */

  /* Wrapper com Altura para Scroll Scrubbing */
  .hero-scroll-wrapper {
    position: relative;
    width: 100%;
    height: 320vh;
    background-color: var(--color-verde-profundo);
  }

  /* Viewport Pinned durante o Scrub */
  .hero-viewport {
    position: sticky;
    top: 0;
    left: 0;
    width: 100%;
    height: 100vh;
    height: 100dvh;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: center;
    z-index: 10;
    border-radius: 0 0 36px 36px;
  }

  /* Mídia e Vídeo de Fundo */
  .hero-media-container {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
    overflow: hidden;
    background: #02120e;
  }

  .hero-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 25% center; /* Enquadra o fundador com naturalidade à esquerda */
    transform: scale(1.02);
    will-change: transform;
    pointer-events: none;
  }

  /* Camada de Fotografia Limpa de Abertura (Scroll = 0) */
  .hero-photo-layer {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 2;
    overflow: hidden;
    pointer-events: none;
    will-change: opacity;
  }

  .hero-photo-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 25% center;
    transform: scale(1.02);
    will-change: transform;
    pointer-events: none;
  }

  /* Scrim Lateral Direito: Proteção óptica sutil para o texto editorial, preservando integralmente o fundador e os fluxos de luz */
  .hero-scrim-right {
    position: absolute;
    top: 0;
    right: 0;
    width: 50%;
    height: 100%;
    background: radial-gradient(
      ellipse 85% 75% at 90% 50%,
      rgba(4, 29, 23, 0.65) 0%,
      rgba(4, 29, 23, 0.35) 50%,
      rgba(4, 29, 23, 0.08) 80%,
      transparent 100%
    );
    z-index: 3;
    pointer-events: none;
  }

  /* Scrim Superior: Integração sutil com o Header */
  .hero-scrim-top {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 25%;
    background: linear-gradient(
      180deg,
      rgba(4, 29, 23, 0.82) 0%,
      rgba(4, 29, 23, 0.3) 65%,
      transparent 100%
    );
    z-index: 3;
    pointer-events: none;
  }

  /* Scrim Inferior */
  .hero-scrim-bottom {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 22%;
    background: linear-gradient(
      0deg,
      rgba(4, 29, 23, 0.96) 0%,
      rgba(4, 29, 23, 0.35) 60%,
      transparent 100%
    );
    z-index: 3;
    pointer-events: none;
  }

  /* Camada de Conteúdo */
  .hero-content-container {
    position: relative;
    z-index: 5;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    padding-top: calc(var(--header-height) + 12px);
    padding-bottom: 72px; /* Espaço confortável e seguro até a borda inferior */
  }

  /* Layout Grid/Flex: Coluna Comercial à Direita */
  .hero-wrap {
    display: flex;
    justify-content: flex-end; /* Posiciona o bloco de texto à direita */
    align-items: center;
    width: 100%;
  }

  /* Palco Narrativo em 3 Atos: Envolvido pelo Painel Editorial Liquid Glass */
  .hero-stage {
    width: 100%;
    max-width: clamp(520px, 44vw, 630px);
    min-height: 380px;
    display: grid;
    grid-template-areas: "stage";
    align-items: center;
    justify-items: start;
    position: relative;
    z-index: 6;
    background: none;
    padding: clamp(34px, 3.4vw, 44px) clamp(32px, 3.2vw, 42px);
    border-radius: 24px;
  }

  /* ==========================================================================
     PAINEL EDITORIAL LIQUID GLASS PREMIUM
     - Vidro esmeralda translúcido com reflexo áureo e bevel sutil
     - Protege a legibilidade contra partículas e linhas de luz do vídeo
     ========================================================================== */
  .hero-glass-panel {
    position: absolute;
    inset: 0;
    border-radius: 24px;
    background: linear-gradient(
      140deg,
      rgba(4, 29, 23, 0.40) 0%,
      rgba(4, 29, 23, 0.22) 45%,
      rgba(11, 43, 34, 0.35) 100%
    );
    backdrop-filter: blur(14px) saturate(120%);
    -webkit-backdrop-filter: blur(14px) saturate(120%);
    border: 1px solid rgba(245, 241, 232, 0.14);
    box-shadow:
      0 24px 60px rgba(0, 0, 0, 0.28),
      0 4px 16px rgba(0, 0, 0, 0.16),
      inset 0 1px 0 rgba(245, 241, 232, 0.18),
      inset 0 0 28px rgba(4, 120, 87, 0.08);
    pointer-events: none;
    z-index: 1;
    overflow: hidden;
    opacity: 0; /* Controlado rigorosamente pelo GSAP masterTimeline */
    transform: translateY(16px);
    will-change: opacity, transform;
  }

  /* Reflexo Dourado Editorial Sutil na Borda Superior */
  .glass-reflection-gold {
    position: absolute;
    top: 0;
    left: 28px;
    width: 160px;
    height: 1.5px;
    background: linear-gradient(
      90deg,
      transparent 0%,
      rgba(212, 175, 55, 0.65) 30%,
      rgba(243, 229, 171, 0.9) 60%,
      transparent 100%
    );
    filter: drop-shadow(0 0 6px rgba(212, 175, 55, 0.45));
    pointer-events: none;
  }

  /* Brilho Interno Difuso (Refração Suave Esmeralda/Dourada) */
  .glass-inner-glow {
    position: absolute;
    top: -40px;
    right: -40px;
    width: 220px;
    height: 220px;
    background: radial-gradient(
      circle,
      rgba(212, 175, 55, 0.06) 0%,
      rgba(4, 120, 87, 0.05) 50%,
      transparent 70%
    );
    pointer-events: none;
  }

  /* Atos Narrativos Compartilham a Mesma Área Óptica com Z-Index Superior */
  .hero-act {
    grid-area: stage;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    text-align: left;
    position: relative;
    z-index: 2;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    will-change: opacity, transform;
  }

  /* Títulos dos Atos 1 e 2 */
  .act-title {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    text-align: left;
    margin: 0 0 clamp(20px, 2.2vw, 28px) 0;
    overflow: visible;
    will-change: clip-path, transform, opacity;
  }

  .act-line {
    display: block;
    white-space: normal;
  }

  /* Linhas Prefixos dos Atos 1 e 2 (Sans-Serif Editorial Marfim) */
  .act1-prefix,
  .act2-prefix {
    font-family: var(--font-sans);
    font-size: clamp(22px, 2.2vw, 32px);
    font-weight: 500;
    line-height: 1.28;
    letter-spacing: -0.015em;
    color: var(--color-marfim);
    text-shadow: 0 2px 14px rgba(0, 0, 0, 0.9);
    display: block;
    margin-bottom: clamp(8px, 1.1vw, 14px);
  }

  /* Linhas de Destaque Focal */
  .act1-lead,
  .act2-lead {
    display: block;
    line-height: 1.1;
    margin-top: 2px;
  }

  /* Destaques em Bodoni Moda Italic Dourada */
  .act1-highlight {
    font-family: var(--font-bodoni);
    font-style: italic;
    font-weight: 400;
    font-size: clamp(46px, 5.2vw, 72px);
    line-height: 1.1;
    letter-spacing: -0.01em;
    color: var(--color-dourado);
    text-shadow: 
      0 2px 12px rgba(0, 0, 0, 0.95),
      0 0 26px rgba(212, 175, 55, 0.7),
      0 0 52px rgba(212, 175, 55, 0.35);
    display: inline-block;
    padding-right: 0.18em;
    padding-bottom: 0.05em;
  }

  .act2-highlight {
    font-family: var(--font-bodoni);
    font-style: italic;
    font-weight: 400;
    font-size: clamp(48px, 5.5vw, 76px);
    line-height: 1.1;
    letter-spacing: -0.01em;
    color: var(--color-dourado);
    text-shadow: 
      0 2px 14px rgba(0, 0, 0, 0.98),
      0 0 28px rgba(212, 175, 55, 0.78),
      0 0 56px rgba(212, 175, 55, 0.4);
    display: inline-block;
    padding-right: 0.18em;
    padding-bottom: 0.05em;
  }

  /* Linha Decorativa do Ato 1 */
  .act1-decor {
    display: flex;
    align-items: center;
    gap: 12px;
    width: 100%;
    max-width: 300px;
    margin-top: clamp(18px, 2.2vw, 26px);
  }

  .act1-decor-line {
    height: 2px;
    flex: 1;
    background: linear-gradient(
      90deg,
      #D4AF37 0%,
      rgba(4, 120, 87, 0.8) 70%,
      transparent 100%
    );
    transform-origin: left center;
    box-shadow: 0 0 10px rgba(212, 175, 55, 0.5);
    will-change: transform;
  }

  .act1-decor-spark {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #D4AF37;
    box-shadow: 0 0 12px #D4AF37;
    flex-shrink: 0;
  }

  /* Linha Decorativa do Ato 2 */
  .act2-decor {
    display: flex;
    align-items: center;
    gap: 12px;
    width: 100%;
    max-width: 300px;
    margin-top: clamp(18px, 2.2vw, 26px);
  }

  .act2-decor-line {
    height: 2px;
    flex: 1;
    background: linear-gradient(
      90deg,
      #047857 0%,
      rgba(212, 175, 55, 0.9) 70%,
      transparent 100%
    );
    transform-origin: left center;
    box-shadow: 0 0 10px rgba(4, 120, 87, 0.5);
    will-change: transform;
  }

  .act2-decor-spark {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-dourado);
    box-shadow: 0 0 12px var(--color-dourado);
    flex-shrink: 0;
  }

  /* Badge / Eyebrow */
  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 6px 16px 6px 12px;
    border-radius: 999px;
    background: rgba(11, 43, 34, 0.75);
    border: 1px solid rgba(212, 175, 55, 0.32);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
    margin-bottom: 20px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.35);
  }

  .badge-pulse {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-dourado);
    box-shadow: 0 0 12px var(--color-dourado);
    animation: pulse-glow 2.4s ease-in-out infinite;
  }

  @keyframes pulse-glow {
    0%, 100% {
      opacity: 1;
      transform: scale(1);
    }
    50% {
      opacity: 0.4;
      transform: scale(0.8);
    }
  }

  .badge-text {
    font-size: 11.5px;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--color-marfim);
    text-transform: uppercase;
  }

  /* Headline com Escala Refinada e Hierarquia Clara (Ato 3) */
  .hero-title {
    margin: 0 0 clamp(20px, 2vw, 26px) 0;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    text-align: left;
    overflow: visible;
    will-change: clip-path, transform, opacity;
  }

  .title-line {
    display: block;
    white-space: normal;
  }

  /* Frase 1: Contexto / Desafio (Sans-Serif Elegante, não compete com a 2ª) */
  .title-line-1 {
    font-family: var(--font-sans);
    font-size: clamp(21px, 2vw, 28px);
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: -0.015em;
    color: rgba(245, 241, 232, 0.88);
    text-shadow: 0 2px 14px rgba(0, 0, 0, 0.88);
    margin-bottom: clamp(6px, 0.8vw, 10px);
    display: block;
  }

  /* Frase 2: Conclusão Comercial Monumental */
  .title-line-2 {
    font-family: var(--font-sans);
    font-size: clamp(32px, 3.8vw, 52px);
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.025em;
    color: var(--color-marfim);
    text-shadow: 0 4px 24px rgba(0, 0, 0, 0.95);
    display: block;
  }

  /* Destaque Dourado com Mais Presença em "ser encontrada." */
  .hero-highlight {
    font-family: var(--font-bodoni);
    font-style: italic;
    font-weight: 400;
    font-size: 1.1em;
    letter-spacing: -0.01em;
    color: var(--color-dourado);
    text-shadow: 
      0 2px 14px rgba(0, 0, 0, 0.98),
      0 0 28px rgba(212, 175, 55, 0.75),
      0 0 56px rgba(212, 175, 55, 0.38);
    display: inline-block;
    padding-right: 0.18em;
    padding-bottom: 0.05em;
  }

  /* Subtítulo com Marfim Suave, Largura Confortável e Espaçamento Otimizado */
  .hero-subtitle {
    font-size: clamp(15.5px, 1.15vw, 17.5px);
    line-height: 1.65;
    color: rgba(245, 241, 232, 0.92);
    letter-spacing: -0.005em;
    max-width: 520px;
    margin: 0 0 clamp(30px, 3.2vw, 40px) 0;
    text-align: left;
    text-shadow: 0 2px 14px rgba(0, 0, 0, 0.9);
    font-weight: 400;
  }

  /* CTAs Lado a Lado no Desktop com Hierarquia Clara */
  .hero-cta-group {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    gap: 16px;
    flex-wrap: nowrap; /* Garante que os dois botões permaneçam lado a lado no desktop */
    width: 100%;
  }

  /* Botão Primário: Visualmente Dominante, Área Clicável Otimizada */
  .hero-cta-primary {
    padding: 14px 12px 14px 26px;
    font-size: 14.5px;
    font-weight: 700;
    letter-spacing: 0.025em;
    min-height: 52px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.45), 0 0 16px rgba(212, 175, 55, 0.25);
    flex-shrink: 0;
  }

  /* Botão Secundário: Complementar, Equilibrado e Contraste Reforçado */
  .hero-cta-secondary {
    padding: 14px 26px;
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.025em;
    min-height: 52px;
    background: rgba(4, 29, 23, 0.72);
    border: 1.5px solid rgba(245, 241, 232, 0.45);
    color: var(--color-marfim);
    box-shadow: 0 4px 18px rgba(0, 0, 0, 0.4);
    flex-shrink: 0;
  }

  .hero-cta-secondary:hover {
    border-color: var(--color-dourado);
    color: #ffffff;
    background: rgba(212, 175, 55, 0.18);
    box-shadow: 0 0 24px rgba(212, 175, 55, 0.35), 0 8px 24px rgba(0, 0, 0, 0.45);
    transform: translateY(-2px);
  }

  /* Indicador de Rolagem: Minimalista, Tipográfico & Linha Vertical Dourada */
  .hero-scroll-indicator {
    position: absolute;
    bottom: 32px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 20;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    pointer-events: none;
    opacity: 0; /* Animado suavemente no enterTl */
    will-change: opacity, transform;
  }

  .scroll-explore-text {
    font-family: var(--font-sans);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.22em;
    color: var(--color-marfim);
    opacity: 0.85;
    text-transform: uppercase;
    white-space: nowrap;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.85);
  }

  .scroll-explore-line {
    width: 1.5px;
    height: 38px;
    background: rgba(212, 175, 55, 0.22);
    position: relative;
    overflow: hidden;
    border-radius: 999px;
  }

  .scroll-explore-line-fill {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(
      180deg,
      rgba(212, 175, 55, 0) 0%,
      var(--color-dourado) 50%,
      rgba(212, 175, 55, 0.95) 100%
    );
    border-radius: 999px;
    box-shadow: 0 0 8px rgba(212, 175, 55, 0.6);
    transform-origin: top center;
    animation: scroll-line-sweep 2.2s cubic-bezier(0.65, 0, 0.35, 1) infinite;
  }

  @keyframes scroll-line-sweep {
    0% {
      transform: translateY(-100%);
      opacity: 0;
    }
    30% {
      opacity: 1;
    }
    70% {
      opacity: 1;
    }
    100% {
      transform: translateY(100%);
      opacity: 0;
    }
  }

  /* Linha de Brilho Inferior */
  .hero-bottom-glow {
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    width: min(720px, 85%);
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent,
      rgba(4, 120, 87, 0.6) 20%,
      rgba(212, 175, 55, 0.8) 50%,
      rgba(4, 120, 87, 0.6) 80%,
      transparent
    );
    box-shadow: 0 0 20px rgba(212, 175, 55, 0.4);
    pointer-events: none;
    z-index: 6;
  }

  /* ==========================================================================
     TABLET / LAPTOPS COMPACTOS (861px - 1120px)
     - Preserva fotografia à esquerda sem invasão de textos
     - Escala tipográfica calibrada
     ========================================================================== */
  @media (min-width: 861px) and (max-width: 1120px) {
    .hero-stage {
      max-width: 490px;
      padding: 28px 26px;
      border-radius: 22px;
    }

    .hero-glass-panel {
      border-radius: 22px;
    }

    .act1-prefix,
    .act2-prefix {
      font-size: 21px;
    }

    .act1-highlight,
    .act2-highlight {
      font-size: 45px;
    }

    .title-line-1 {
      font-size: 20px;
    }

    .title-line-2 {
      font-size: 33px;
    }

    .hero-subtitle {
      font-size: 14.5px;
      max-width: 430px;
    }

    .hero-cta-group {
      gap: 12px;
    }

    .hero-cta-primary {
      padding: 12px 10px 12px 20px;
      font-size: 13.5px;
    }

    .hero-cta-secondary {
      padding: 12px 20px;
      font-size: 13px;
    }
  }

  /* ==========================================================================
     MOBILE (< 860px) — COMPOSIÇÃO VERTICAL PRÓPRIA:
     - Imagem/Vídeo ACIMA com enquadramento focado no rosto do fundador
     - Conteúdo comercial ABAIXO com legibilidade máxima
     ========================================================================== */
  @media (max-width: 860px) {
    .hero-scroll-wrapper {
      height: 260vh;
    }

    .hero-viewport {
      display: flex;
      flex-direction: column;
      justify-content: flex-start;
      height: 100vh;
      height: 100dvh;
      overflow: hidden;
    }

    /* Mídia na Metade Superior */
    .hero-media-container {
      position: relative;
      width: 100%;
      height: 44vh;
      flex-shrink: 0;
    }

    .hero-video,
    .hero-photo-img {
      /* Enquadramento calibrado rigorosamente no rosto do fundador */
      object-position: 20% 30%;
    }

    .hero-scrim-right {
      display: none; /* No mobile a divisão é vertical */
    }

    .hero-scrim-top {
      height: 35%;
      background: linear-gradient(
        180deg,
        rgba(4, 29, 23, 0.75) 0%,
        transparent 100%
      );
    }

    .hero-scrim-bottom {
      height: 45%;
      background: linear-gradient(
        0deg,
        var(--color-verde-profundo) 0%,
        rgba(4, 29, 23, 0.7) 50%,
        transparent 100%
      );
    }

    /* Conteúdo Comercial na Metade Inferior */
    .hero-content-container {
      position: relative;
      width: 100%;
      flex: 1;
      padding: 8px 0 24px 0;
      display: flex;
      align-items: center;
      background: var(--color-verde-profundo);
    }

    .hero-wrap {
      justify-content: flex-start;
      padding: 0 20px;
    }

    .hero-stage {
      max-width: 100%;
      min-height: auto;
      margin: 0;
      padding: 20px 18px 22px 18px;
      border-radius: 20px;
      background: none;
      align-items: flex-start;
      text-align: left;
    }

    .hero-glass-panel {
      border-radius: 20px;
      background: linear-gradient(
        140deg,
        rgba(4, 29, 23, 0.48) 0%,
        rgba(4, 29, 23, 0.32) 45%,
        rgba(11, 43, 34, 0.44) 100%
      );
    }

    .hero-act {
      align-items: flex-start;
      text-align: left;
    }

    .act1-title,
    .act2-title {
      margin-bottom: 14px;
    }

    .act1-prefix,
    .act2-prefix {
      font-size: clamp(17px, 4.6vw, 22px);
      line-height: 1.25;
      margin-bottom: 6px;
    }

    .act1-lead,
    .act2-lead {
      line-height: 1.1;
      margin-top: 2px;
    }

    .act1-highlight,
    .act2-highlight {
      font-size: clamp(32px, 8.5vw, 44px);
      padding-right: 0.16em;
    }

    .act1-decor,
    .act2-decor {
      max-width: 200px;
      margin-top: 12px;
    }

    .hero-badge {
      margin-bottom: 12px;
      padding: 4px 12px;
    }

    .badge-text {
      font-size: 10.5px;
    }

    .hero-title {
      margin-bottom: 14px;
      align-items: flex-start;
      text-align: left;
    }

    .title-line-1 {
      font-size: clamp(17px, 4.5vw, 22px);
      line-height: 1.25;
      margin-bottom: 6px;
    }

    .title-line-2 {
      font-size: clamp(24px, 6.5vw, 32px);
      line-height: 1.15;
    }

    .hero-highlight {
      font-size: 1.08em;
      padding-right: 0.16em;
    }

    .hero-subtitle {
      font-size: clamp(13px, 3.5vw, 14.5px);
      line-height: 1.5;
      margin-bottom: 22px;
      max-width: 100%;
      text-align: left;
    }

    .hero-cta-group {
      flex-direction: column;
      flex-wrap: wrap;
      width: 100%;
      gap: 11px;
      align-items: stretch;
    }

    .hero-cta-primary,
    .hero-cta-secondary {
      width: 100%;
      max-width: 360px;
      justify-content: center;
      padding: 13px 20px;
      min-height: 48px;
      font-size: 14px;
    }

    .hero-scroll-indicator {
      bottom: max(18px, env(safe-area-inset-bottom, 16px));
      gap: 8px;
    }

    .scroll-explore-text {
      font-size: 8.5px;
      letter-spacing: 0.18em;
    }

    .scroll-explore-line {
      height: 26px;
    }
  }

  /* Telas Pequenas Verticais (< 380px) */
  @media (max-width: 380px) {
    .hero-media-container {
      height: 40vh;
    }
    .act1-prefix,
    .act2-prefix {
      font-size: 16px;
    }
    .act1-highlight,
    .act2-highlight {
      font-size: 30px;
    }
    .title-line-1 {
      font-size: 16px;
    }
    .title-line-2 {
      font-size: 24px;
    }
    .hero-subtitle {
      font-size: 12.5px;
      margin-bottom: 16px;
    }
  }

  /* Acessibilidade: prefers-reduced-motion */
  @media (prefers-reduced-motion: reduce) {
    .hero-scroll-wrapper {
      height: 100vh;
    }
    .hero-act-1,
    .hero-act-2 {
      display: none !important;
    }
    .hero-act-3 {
      opacity: 1 !important;
      visibility: visible !important;
      pointer-events: auto !important;
    }
    .scroll-explore-line-fill {
      animation: none !important;
      transform: translateY(0) !important;
      opacity: 0.8 !important;
    }
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  document.addEventListener('DOMContentLoaded', () => {
    const video = document.getElementById('hero-video') as HTMLVideoElement | null;
    const photoLayer = document.getElementById('hero-photo-layer');
    const photoImg = document.getElementById('hero-photo-img');
    const scrollWrapper = document.getElementById('hero-scroll-wrapper');
    const heroViewport = document.getElementById('hero-viewport');
    const scrollIndicator = document.getElementById('hero-scroll-indicator');
    const bottomGlow = document.querySelector('.hero-bottom-glow');

    // Elementos do Momento 1 (A Ideia)
    const act1 = document.getElementById('hero-act-1');
    const act1Title = document.getElementById('act1-title');
    const act1Line = document.getElementById('act1-decor-line');
    const act1Spark = act1?.querySelector('.act1-decor-spark');

    // Elementos do Momento 2 (A Estratégia)
    const act2 = document.getElementById('hero-act-2');
    const act2Title = document.getElementById('act2-title');
    const act2Line = document.getElementById('act2-decor-line');
    const act2Spark = act2?.querySelector('.act2-decor-spark');

    // Elementos do Momento 3 (A Transformação)
    const act3 = document.getElementById('hero-act-3');
    const act3Title = document.getElementById('hero-title-3');
    const act3Subtitle = document.getElementById('hero-subtitle-3');
    const act3Ctas = document.getElementById('hero-cta-group-3');

    // Painel Editorial Liquid Glass Premium
    const glassPanel = document.getElementById('hero-glass-panel');

    // 1. ANIMAÇÃO DE ENTRADA DO INDICADOR DE ROLAGEM ("ROLE PARA EXPLORAR")
    // Centralizado com precisão na parte inferior da viewport e revelado após a fotografia e o header
    let indicatorRevealed = false;
    const revealScrollIndicator = () => {
      if (scrollIndicator && window.scrollY < 20 && !indicatorRevealed) {
        indicatorRevealed = true;
        gsap.fromTo(
          scrollIndicator,
          { opacity: 0, y: 16, xPercent: -50 },
          { opacity: 1, y: 0, xPercent: -50, duration: 0.9, ease: 'power2.out' }
        );
      }
    };

    window.addEventListener('cinematic-indicator-reveal', revealScrollIndicator);
    window.addEventListener('cinematic-intro-complete', revealScrollIndicator);

    if (!document.getElementById('cinematic-intro') || window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      revealScrollIndicator();
    }

    // 2. CURSOR GLOW FOLLOWER NOS BOTÕES .btn-pill (Canônico do Design System)
    document.querySelectorAll<HTMLElement>('.btn-pill').forEach((btn) => {
      const light = { x: 0, y: 0 };
      const apply = () => {
        btn.style.setProperty('--mx', `${light.x}px`);
        btn.style.setProperty('--my', `${light.y}px`);
      };
      const rest = () => ({ x: btn.offsetWidth - 22, y: btn.offsetHeight / 2 });
      const settle = (duration: number) => {
        if (!btn.offsetWidth) return;
        const target = rest();
        if (duration) {
          gsap.to(light, {
            ...target,
            duration,
            ease: 'power3.inOut',
            onUpdate: apply,
            overwrite: true
          });
        } else {
          Object.assign(light, target);
          apply();
        }
      };

      settle(0);
      window.addEventListener('resize', () => settle(0), { passive: true });

      btn.addEventListener('pointermove', (e: PointerEvent) => {
        const r = btn.getBoundingClientRect();
        const target = { x: e.clientX - r.left, y: e.clientY - r.top };
        gsap.to(light, {
          ...target,
          duration: 0.25,
          ease: 'power3.out',
          onUpdate: apply,
          overwrite: true
        });
      });

      btn.addEventListener('pointerleave', () => settle(0.8));
    });

    // 3. APPLE-STYLE SCROLL VIDEO SCRUBBING & MASTER NARRATIVE TIMELINE
    if (!video || !scrollWrapper || !heroViewport) return;

    // Respeitar prefers-reduced-motion
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      video.pause();
      return;
    }

    // Pausa garantida: o vídeo NUNCA toca de forma independente
    video.pause();

    let isInitialized = false;

    const setupScrubber = () => {
      if (isInitialized) return;
      isInitialized = true;

      video.pause();

      // Timeline normalizada (0.0s a 10.0s = 0% a 100% do progresso de scroll)
      const timelineDuration = 10;

      // Mecanismo Não-Bloqueante de Busca de Frames (Bidirecional Suave)
      let targetTime = 0;
      const requestSeek = (time: number) => {
        const videoDuration = (video && Number.isFinite(video.duration) && video.duration > 0) ? video.duration : 1;
        targetTime = Math.max(0, Math.min(videoDuration, time));
        // Se o decodificador de hardware não estiver ocupado, aplica a busca imediatamente
        if (!video.seeking && video.readyState >= 1) {
          if (Math.abs(video.currentTime - targetTime) > 0.015) {
            video.currentTime = targetTime;
          }
        }
      };

      // Fila de busca contínua: assim que o decodificador conclui um frame,
      // atualiza para a nova posição se o usuário continuou rolando
      video.addEventListener('seeked', () => {
        if (Math.abs(video.currentTime - targetTime) > 0.015) {
          video.currentTime = targetTime;
        }
      });

      // Objeto proxy animado pelo GSAP (progresso 0 a 1)
      const videoProxy = { progress: 0 };

      // Garantir alinhamento horizontal centralizado rigoroso do indicador
      if (scrollIndicator) {
        gsap.set(scrollIndicator, { xPercent: -50, left: '50%' });
      }

      // Definir estado inicial explícito de todos os 3 atos narrativos e do painel liquid glass
      gsap.set([act1, act2, act3], {
        opacity: 0,
        visibility: 'hidden',
        pointerEvents: 'none',
        y: 20
      });

      if (glassPanel) {
        gsap.set(glassPanel, {
          opacity: 0,
          visibility: 'hidden',
          y: 16
        });
      }

      // Única Instância Principal de ScrollTrigger & Timeline Mestre
      const masterTimeline = gsap.timeline({
        scrollTrigger: {
          trigger: scrollWrapper,
          start: 'top top',
          end: 'bottom bottom',
          scrub: 0.5, // Damping equilibrado estilo Apple
          pin: heroViewport,
          anticipatePin: 1,
          invalidateOnRefresh: true,
        }
      });

      // --- 1. Sincronização do tempo do vídeo pelo proxy de progresso ---
      masterTimeline.to(videoProxy, {
        progress: 1,
        ease: 'none',
        duration: timelineDuration,
        onUpdate: () => {
          const videoDuration = (video && Number.isFinite(video.duration) && video.duration > 0) ? video.duration : 1;
          requestSeek(videoProxy.progress * videoDuration);
        }
      }, 0);

      // --- 2. Movimento de Câmera Virtual Suave (CSS Transform em 0-100%) ---
      const cameraTargets: (HTMLElement | HTMLVideoElement)[] = [video];
      if (photoImg) cameraTargets.push(photoImg);
      masterTimeline.to(cameraTargets, {
        scale: 1.07,
        xPercent: -1.5,
        yPercent: -0.6,
        ease: 'none',
        duration: timelineDuration,
      }, 0);

      // --- 3. Indicador de Rolagem: Fade-out suave ao iniciar o scroll (0% a 5%) ---
      // E reaparece automaticamente com precisão cirúrgica ao retornar ao topo (0%)
      if (scrollIndicator) {
        masterTimeline.fromTo(
          scrollIndicator,
          { opacity: 1, y: 0, xPercent: -50 },
          {
            opacity: 0,
            y: 18,
            xPercent: -50,
            ease: 'power2.out',
            duration: 0.5,
          },
          0
        );
      }

      // --- 4. Transição Suave da Fotografia Limpa para o Vídeo (0% a 6% do Scroll) ---
      if (photoLayer) {
        masterTimeline.to(photoLayer, {
          opacity: 0,
          ease: 'power1.out',
          duration: 0.6,
        }, 0);
      }

      // --- 5. ATO 1 — A IDEIA (6% a 28% do Scroll) ---
      // A fotografia do fundador é protagonista. A ideia surge com máscara vertical suave.
      if (glassPanel) {
        masterTimeline.set(glassPanel, {
          visibility: 'visible',
        }, 0.5);

        masterTimeline.fromTo(glassPanel,
          { opacity: 0, y: 16 },
          { opacity: 1, y: 0, duration: 0.8, ease: 'power2.out' },
          0.55
        );
      }

      if (act1) {
        masterTimeline.set(act1, {
          visibility: 'visible',
          pointerEvents: 'auto',
        }, 0.5);

        masterTimeline.fromTo(act1,
          { opacity: 0, y: 22 },
          { opacity: 1, y: 0, duration: 0.8, ease: 'power2.out' },
          0.6
        );

        if (act1Title) {
          masterTimeline.fromTo(act1Title,
            {
              clipPath: 'polygon(-10% 120%, 110% 120%, 110% 120%, -10% 120%)',
              filter: 'blur(4px)'
            },
            {
              clipPath: 'polygon(-10% -20%, 110% -20%, 110% 120%, -10% 120%)',
              filter: 'blur(0px)',
              duration: 0.8,
              ease: 'power2.out'
            },
            0.6
          );
        }

        if (act1Line) {
          masterTimeline.fromTo(act1Line,
            { scaleX: 0 },
            { scaleX: 1.35, duration: 0.9, ease: 'none' },
            0.7
          );
        }

        if (act1Spark) {
          masterTimeline.fromTo(act1Spark,
            { opacity: 0, scale: 0 },
            { opacity: 1, scale: 1, duration: 0.4, ease: 'power2.out' },
            0.8
          );
        }

        // Saída suave do Ato 1 por deslocamento e fade (concluída em 28%, antes do Ato 2)
        masterTimeline.to(act1, {
          opacity: 0,
          y: -20,
          filter: 'blur(4px)',
          ease: 'power2.in',
          duration: 0.6,
        }, 2.2);

        masterTimeline.set(act1, {
          visibility: 'hidden',
          pointerEvents: 'none',
        }, 2.8);
      }

      if (glassPanel) {
        // Durante a transição entre frases, suaviza a opacidade para manter a continuidade sem parecer um retângulo vazio
        masterTimeline.to(glassPanel, {
          opacity: 0.45,
          duration: 0.5,
          ease: 'power2.inOut',
        }, 2.3);

        masterTimeline.to(glassPanel, {
          opacity: 1,
          duration: 0.7,
          ease: 'power2.out',
        }, 3.1);
      }

      // --- 6. ATO 2 — A ESTRATÉGIA (32% a 63% do Scroll) ---
      // Inicia apenas após o Ato 1 ter desaparecido completamente (intervalo livre de 28% a 32%)
      if (act2) {
        masterTimeline.set(act2, {
          visibility: 'visible',
          pointerEvents: 'auto',
        }, 3.1);

        masterTimeline.fromTo(act2,
          { opacity: 0, y: 22 },
          { opacity: 1, y: 0, duration: 0.8, ease: 'power2.out' },
          3.2
        );

        if (act2Title) {
          masterTimeline.fromTo(act2Title,
            {
              clipPath: 'polygon(-10% 120%, 110% 120%, 110% 120%, -10% 120%)',
              filter: 'blur(4px)'
            },
            {
              clipPath: 'polygon(-10% -20%, 110% -20%, 110% 120%, -10% 120%)',
              filter: 'blur(0px)',
              duration: 0.8,
              ease: 'power2.out'
            },
            3.2
          );
        }

        if (act2Line) {
          masterTimeline.fromTo(act2Line,
            { scaleX: 0 },
            { scaleX: 1.35, duration: 0.9, ease: 'none' },
            3.3
          );
        }

        if (act2Spark) {
          masterTimeline.fromTo(act2Spark,
            { opacity: 0, scale: 0 },
            { opacity: 1, scale: 1, duration: 0.4, ease: 'power2.out' },
            3.4
          );
        }

        // Saída suave do Ato 2 (concluída em 63%, antes do Ato 3)
        masterTimeline.to(act2, {
          opacity: 0,
          y: -20,
          filter: 'blur(4px)',
          ease: 'power2.in',
          duration: 0.7,
        }, 5.6);

        masterTimeline.set(act2, {
          visibility: 'hidden',
          pointerEvents: 'none',
        }, 6.3);
      }

      if (glassPanel) {
        // Suaviza discretamente na transição para o clímax da transformação
        masterTimeline.to(glassPanel, {
          opacity: 0.45,
          duration: 0.6,
          ease: 'power2.inOut',
        }, 5.7);

        masterTimeline.to(glassPanel, {
          opacity: 1,
          duration: 0.8,
          ease: 'power2.out',
        }, 6.7);
      }

      // --- 7. ATO 3 — O RESULTADO / A TRANSFORMAÇÃO (68% a 100% do Scroll) ---
      // Sincronizado com o ponto de maior impacto visual do vídeo (intervalo livre de 63% a 68%)
      if (act3) {
        masterTimeline.set(act3, {
          visibility: 'visible',
          pointerEvents: 'auto',
        }, 6.8);

        masterTimeline.fromTo(act3,
          { opacity: 0, y: 24 },
          { opacity: 1, y: 0, duration: 0.8, ease: 'power2.out' },
          6.8
        );

        if (act3Title) {
          masterTimeline.fromTo(act3Title,
            {
              clipPath: 'polygon(-10% 120%, 110% 120%, 110% 120%, -10% 120%)',
              filter: 'blur(4px)'
            },
            {
              clipPath: 'polygon(-10% -20%, 110% -20%, 110% 120%, -10% 120%)',
              filter: 'blur(0px)',
              duration: 0.8,
              ease: 'power2.out'
            },
            6.8
          );
        }

        if (act3Subtitle) {
          masterTimeline.fromTo(act3Subtitle,
            { opacity: 0, y: 16, filter: 'blur(4px)' },
            { opacity: 1, y: 0, filter: 'blur(0px)', duration: 0.7, ease: 'power2.out' },
            7.6
          );
        }

        if (act3Ctas) {
          masterTimeline.fromTo(act3Ctas.children,
            { opacity: 0, y: 18 },
            { opacity: 1, y: 0, stagger: 0.2, duration: 0.7, ease: 'power2.out' },
            8.2
          );
        }
      }

      // --- 8. Transição Visual para a Próxima Seção (Brilho Inferior Intensificado) ---
      if (bottomGlow) {
        masterTimeline.fromTo(bottomGlow,
          { opacity: 0.4, scaleX: 0.8 },
          { opacity: 1, scaleX: 1.15, duration: 1.5, ease: 'power2.out' },
          8.5
        );
      }
    };

    // Inicializar scrubber imediatamente e sincronizar em eventos de layout/mídia
    setupScrubber();

    if (video.readyState < 1) {
      video.addEventListener('loadedmetadata', () => {
        ScrollTrigger.refresh();
      }, { once: true });
      video.addEventListener('canplay', () => {
        ScrollTrigger.refresh();
      }, { once: true });
    }

    window.addEventListener('cinematic-intro-complete', () => {
      ScrollTrigger.refresh();
    });
  });
</script>
