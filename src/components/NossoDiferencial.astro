---
// src/components/NossoDiferencial.astro — Quinta Dobra: O Diferencial K. Up Biz
// Três diferenciais reais em cards que se empilham com o scroll (sticky stack).
// Sem vídeo e sem pinning do GSAP: leve e estável.
---

<section class="diferencial-section" id="diferencial" aria-labelledby="diferencial-title">
  <div class="dif-ambient dif-ambient-emerald" aria-hidden="true"></div>
  <div class="dif-ambient dif-ambient-gold" aria-hidden="true"></div>

  <div class="dif-wrap">
    <!-- COLUNA ESQUERDA: TEXTO FIXO -->
    <div class="dif-intro">
      <div class="dif-intro-inner">
        <div class="dif-eyebrow">
          <span class="dif-pip" aria-hidden="true"></span>
          <span>04 / NOSSO DIFERENCIAL</span>
        </div>

        <h2 class="dif-title" id="diferencial-title">
          <span class="dif-title-line">Nada de pacote genérico.</span>
          <span class="dif-title-line dif-gold">Tudo pensado para o seu negócio.</span>
        </h2>

        <div class="dif-divider" aria-hidden="true"></div>

        <p class="dif-lead">
          Cada projeto é adaptado à sua marca, ao seu público e ao seu objetivo. E quem cuida dele do começo ao fim é a mesma pessoa que conversa com você.
        </p>

        <ol class="dif-index" aria-hidden="true">
          <li data-dif-index="0"><span>01</span>Atendimento direto</li>
          <li data-dif-index="1"><span>02</span>Sob medida</li>
          <li data-dif-index="2"><span>03</span>Tudo conectado</li>
        </ol>
      </div>
    </div>

    <!-- COLUNA DIREITA: CARDS EMPILHÁVEIS -->
    <div class="dif-stack">
      <!-- CARD 1 · ATENDIMENTO DIRETO -->
      <article class="dif-card" data-dif-card="0" style="--i:0">
        <div class="dif-card-text">
          <span class="dif-card-num">01</span>
          <h3 class="dif-card-title">Você fala direto<br/><em>com quem faz.</em></h3>
          <p class="dif-card-desc">
            Sem intermediários e sem briefing passado de mão em mão. Do primeiro contato à entrega, o atendimento é comigo, o mesmo profissional que cria o seu projeto.
          </p>
        </div>
        <div class="dif-visual dif-visual-chat" aria-hidden="true">
          <div class="chat-head">
            <span class="chat-avatar">K</span>
            <span class="chat-who"><b>Kleber · K. Up Biz</b><small>responde você pessoalmente</small></span>
            <span class="chat-online"></span>
          </div>
          <div class="chat-body">
            <span class="chat-bubble chat-in" style="--d:0">Oi! Quero melhorar a presença da minha empresa.</span>
            <span class="chat-bubble chat-out" style="--d:1">Oi! Eu mesmo cuido do seu projeto, do início ao fim. Me conta sobre o seu negócio?</span>
            <span class="chat-typing" style="--d:2"><i></i><i></i><i></i></span>
          </div>
        </div>
      </article>

      <!-- CARD 2 · SOB MEDIDA -->
      <article class="dif-card" data-dif-card="1" style="--i:1">
        <div class="dif-card-text">
          <span class="dif-card-num">02</span>
          <h3 class="dif-card-title">Sob medida,<br/><em>no ritmo certo.</em></h3>
          <p class="dif-card-desc">
            Criado do zero ou a partir de uma base pronta quando o prazo pede: design, textos e estrutura são sempre adaptados à identidade da sua marca.
          </p>
        </div>
        <div class="dif-visual dif-visual-tailor" aria-hidden="true">
          <div class="tailor-frame">
            <div class="tailor-nav"><i></i><i></i><i></i><b></b></div>
            <div class="tailor-hero">
              <span class="tailor-line w70"></span>
              <span class="tailor-line w45"></span>
              <span class="tailor-btn"></span>
            </div>
            <div class="tailor-grid"><i></i><i></i><i></i></div>
          </div>
          <div class="tailor-tools">
            <span class="tailor-swatches"><i style="--c:#D4AF37"></i><i style="--c:#047857"></i><i style="--c:#F5F1E8"></i></span>
            <span class="tailor-type">Aa</span>
            <span class="tailor-tag">Sua marca</span>
          </div>
        </div>
      </article>

      <!-- CARD 3 · TUDO CONECTADO -->
      <article class="dif-card" data-dif-card="2" style="--i:2">
        <div class="dif-card-text">
          <span class="dif-card-num">03</span>
          <h3 class="dif-card-title">Site, Google e anúncios<br/><em>trabalhando juntos.</em></h3>
          <p class="dif-card-desc">
            Em vez de três fornecedores, uma estratégia só: o anúncio leva ao seu perfil, o perfil leva ao site e o site leva ao WhatsApp.
          </p>
        </div>
        <div class="dif-visual dif-visual-flow" aria-hidden="true">
          <svg class="flow-svg" viewBox="0 0 320 240" preserveAspectRatio="xMidYMid meet">
            <defs>
              <linearGradient id="dif-flow-grad" x1="0" y1="0" x2="1" y2="1">
                <stop offset="0%" stop-color="#047857" />
                <stop offset="100%" stop-color="#D4AF37" />
              </linearGradient>
            </defs>
            <path class="flow-path" d="M60 60 C 140 60, 120 120, 200 120 S 250 190, 270 190" />
            <path class="flow-path flow-path-lit" d="M60 60 C 140 60, 120 120, 200 120 S 250 190, 270 190" />
          </svg>
          <span class="flow-node" style="--x:18.75%; --y:25%; --d:0"><b>Anúncio</b></span>
          <span class="flow-node" style="--x:40%; --y:45%; --d:1"><b>Google</b></span>
          <span class="flow-node" style="--x:62.5%; --y:50%; --d:2"><b>Site</b></span>
          <span class="flow-node flow-node-goal" style="--x:84.4%; --y:79%; --d:3"><b>WhatsApp</b></span>
        </div>
      </article>
    </div>
  </div>
</section>

<style>
  /* ==========================================================================
     K. UP BIZ — QUINTA DOBRA | NOSSO DIFERENCIAL (cards empilháveis)
     Paleta: #041D17, #030D0B, #047857, #D4AF37, #F5F1E8
     ========================================================================== */
  .diferencial-section {
    --gold: #D4AF37;
    --gold-l: #F3E5AB;
    --ivory: #F5F1E8;
    --ivory-2: rgba(245, 241, 232, 0.7);
    --ivory-3: rgba(245, 241, 232, 0.38);
    --line: rgba(245, 241, 232, 0.09);
    --ease: cubic-bezier(0.16, 1, 0.3, 1);
    position: relative;
    width: 100%;
    background: linear-gradient(180deg, #041D17 0%, #030D0B 160px, #030D0B calc(100% - 160px), #041D17 100%);
    color: var(--ivory);
    overflow: clip;
    z-index: 7;
    padding: clamp(80px, 14vh, 160px) 0 clamp(80px, 12vh, 140px);
  }

  .dif-ambient {
    position: absolute;
    border-radius: 50%;
    filter: blur(110px);
    pointer-events: none;
  }
  .dif-ambient-emerald { width: 600px; height: 600px; left: -200px; top: 20%; background: rgba(4, 120, 87, 0.22); }
  .dif-ambient-gold { width: 480px; height: 480px; right: -160px; bottom: 10%; background: rgba(212, 175, 55, 0.08); }

  .dif-wrap {
    position: relative;
    max-width: var(--max-width, 1240px);
    margin: 0 auto;
    padding: 0 clamp(20px, 5vw, 64px);
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
    gap: clamp(32px, 6vw, 96px);
    align-items: start;
  }

  /* --------------------------------------------------------------------------
     TEXTO FIXO
     -------------------------------------------------------------------------- */
  .dif-intro { position: relative; height: 100%; }
  .dif-intro-inner {
    position: sticky;
    top: clamp(96px, 16vh, 160px);
  }
  .dif-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 22px;
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.22em;
    color: var(--gold);
  }
  .dif-pip {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #2EE59D;
    box-shadow: 0 0 10px #2EE59D;
  }
  .dif-title {
    margin: 0;
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: clamp(32px, 3.5vw, 52px);
    line-height: 1.05;
    letter-spacing: -0.035em;
  }
  .dif-title-line { display: block; }
  .dif-gold {
    font-family: var(--font-instrument-serif);
    font-style: italic;
    font-weight: 400;
    letter-spacing: -0.01em;
    color: var(--gold);
  }
  .dif-divider {
    width: 56px;
    height: 1px;
    margin: 28px 0;
    background: linear-gradient(90deg, var(--gold), transparent);
  }
  .dif-lead {
    max-width: 440px;
    margin: 0 0 36px;
    font-family: var(--font-sans);
    font-size: clamp(16px, 1.25vw, 18px);
    line-height: 1.65;
    color: var(--ivory-2);
  }
  .dif-index {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 4px;
  }
  .dif-index li {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 10px 0;
    font-family: var(--font-sans);
    font-size: 15px;
    font-weight: 500;
    color: var(--ivory-3);
    transition: color 0.5s ease, transform 0.5s var(--ease);
  }
  .dif-index li span {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.14em;
    color: inherit;
  }
  .dif-index li::after {
    content: '';
    flex: 1;
    max-width: 0;
    height: 1px;
    background: linear-gradient(90deg, var(--gold), transparent);
    transition: max-width 0.7s var(--ease);
  }
  .dif-index li.is-active { color: var(--ivory); transform: translateX(6px); }
  .dif-index li.is-active span { color: var(--gold); }
  .dif-index li.is-active::after { max-width: 120px; }

  /* --------------------------------------------------------------------------
     CARDS EMPILHÁVEIS
     -------------------------------------------------------------------------- */
  .dif-stack {
    display: grid;
    gap: clamp(24px, 8vh, 80px);
    padding-bottom: 4vh;
  }
  .dif-card {
    --stack-scale: 1;
    --stack-dim: 0;
    position: sticky;
    top: calc(clamp(96px, 16vh, 160px) + var(--i) * 18px);
    min-height: min(560px, 68vh);
    display: grid;
    grid-template-rows: auto 1fr;
    gap: 28px;
    padding: clamp(28px, 3.4vw, 44px);
    border-radius: 32px;
    border: 1px solid rgba(245, 241, 232, 0.1);
    background:
      radial-gradient(120% 80% at 100% 0%, rgba(4, 120, 87, 0.28), transparent 60%),
      radial-gradient(80% 60% at 0% 100%, rgba(212, 175, 55, 0.07), transparent 60%),
      linear-gradient(180deg, #0A211B, #06140F);
    box-shadow: 0 -20px 60px rgba(0, 0, 0, 0.45), inset 0 1px 0 rgba(255, 255, 255, 0.05);
    transform: scale(var(--stack-scale));
    transform-origin: 50% 0%;
    filter: brightness(calc(1 - var(--stack-dim) * 0.45));
    overflow: hidden;
    will-change: transform;
  }
  .dif-card::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    padding: 1px;
    background: linear-gradient(140deg, rgba(212, 175, 55, 0.5), transparent 35%, transparent 70%, rgba(4, 120, 87, 0.5));
    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    opacity: 0.6;
    pointer-events: none;
  }

  .dif-card-num {
    display: block;
    margin-bottom: 14px;
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.18em;
    color: var(--gold);
  }
  .dif-card-title {
    margin: 0 0 14px;
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: clamp(26px, 2.6vw, 38px);
    line-height: 1.08;
    letter-spacing: -0.03em;
    color: var(--ivory);
  }
  .dif-card-title em {
    font-family: var(--font-instrument-serif);
    font-style: italic;
    font-weight: 400;
    color: var(--gold);
  }
  .dif-card-desc {
    max-width: 520px;
    margin: 0;
    font-family: var(--font-sans);
    font-size: clamp(15px, 1.15vw, 17px);
    line-height: 1.6;
    color: var(--ivory-2);
  }

  .dif-visual {
    position: relative;
    min-height: 220px;
    border-radius: 22px;
    border: 1px solid var(--line);
    background: rgba(3, 13, 11, 0.55);
    overflow: hidden;
  }

  /* Visual 1 · Conversa direta */
  .dif-visual-chat { display: flex; flex-direction: column; }
  .chat-head {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px 18px;
    border-bottom: 1px solid var(--line);
    background: rgba(245, 241, 232, 0.03);
  }
  .chat-avatar {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: linear-gradient(135deg, var(--gold), var(--gold-l));
    color: #030D0B;
    font-family: var(--font-instrument-serif);
    font-style: italic;
    font-size: 22px;
    box-shadow: 0 0 20px rgba(212, 175, 55, 0.35);
  }
  .chat-who { display: grid; font-family: var(--font-sans); }
  .chat-who b { font-size: 14px; font-weight: 600; color: var(--ivory); }
  .chat-who small { font-size: 12px; color: #2EE59D; }
  .chat-online {
    margin-left: auto;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: #2EE59D;
    box-shadow: 0 0 0 4px rgba(46, 229, 157, 0.15);
  }
  .chat-body {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 10px;
    padding: 18px;
  }
  .chat-bubble,
  .chat-typing {
    max-width: 82%;
    padding: 11px 15px;
    border-radius: 18px;
    font-family: var(--font-sans);
    font-size: 14px;
    line-height: 1.45;
    opacity: 0;
    transform: translateY(14px) scale(0.96);
    transition: opacity 0.6s var(--ease), transform 0.6s var(--ease);
    transition-delay: calc(var(--d) * 0.55s + 0.15s);
  }
  .chat-in {
    align-self: flex-start;
    background: rgba(245, 241, 232, 0.08);
    color: var(--ivory);
    border-bottom-left-radius: 6px;
  }
  .chat-out {
    align-self: flex-end;
    background: linear-gradient(135deg, rgba(4, 120, 87, 0.85), rgba(4, 90, 66, 0.9));
    color: var(--ivory);
    border-bottom-right-radius: 6px;
  }
  .chat-typing {
    align-self: flex-start;
    display: inline-flex;
    gap: 4px;
    background: rgba(245, 241, 232, 0.08);
  }
  .chat-typing i {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--ivory-3);
    animation: difTyping 1.2s ease-in-out infinite;
  }
  .chat-typing i:nth-child(2) { animation-delay: 0.15s; }
  .chat-typing i:nth-child(3) { animation-delay: 0.3s; }
  @keyframes difTyping {
    0%, 60%, 100% { transform: translateY(0); opacity: 0.4; }
    30% { transform: translateY(-4px); opacity: 1; }
  }
  .dif-card.is-in .chat-bubble,
  .dif-card.is-in .chat-typing { opacity: 1; transform: none; }

  /* Visual 2 · Sob medida (base neutra ganha a identidade da marca) */
  .dif-visual-tailor {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 18px;
    align-items: center;
    padding: 22px;
  }
  .tailor-frame {
    --brand: 0;
    height: 100%;
    min-height: 180px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 14px;
    border-radius: 14px;
    background: color-mix(in srgb, #1B2A26 calc((1 - var(--brand)) * 100%), #041D17);
    border: 1px solid rgba(245, 241, 232, 0.1);
    transition: background 1.2s ease;
  }
  .tailor-nav { display: flex; gap: 6px; align-items: center; }
  .tailor-nav i { width: 22px; height: 4px; border-radius: 4px; background: rgba(245, 241, 232, 0.25); }
  .tailor-nav b {
    margin-left: auto;
    width: 46px;
    height: 14px;
    border-radius: 999px;
    background: rgba(245, 241, 232, 0.18);
    transition: background 1.2s ease;
  }
  .tailor-hero { flex: 1; display: flex; flex-direction: column; justify-content: center; gap: 8px; }
  .tailor-line { height: 9px; border-radius: 6px; background: rgba(245, 241, 232, 0.22); transition: background 1.2s ease; }
  .tailor-line.w70 { width: 70%; height: 14px; }
  .tailor-line.w45 { width: 45%; }
  .tailor-btn {
    margin-top: 6px;
    width: 88px;
    height: 20px;
    border-radius: 999px;
    background: rgba(245, 241, 232, 0.18);
    transition: background 1.2s ease, box-shadow 1.2s ease;
  }
  .tailor-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; }
  .tailor-grid i { height: 34px; border-radius: 8px; background: rgba(245, 241, 232, 0.08); transition: background 1.2s ease; }
  .tailor-tools { display: grid; gap: 12px; justify-items: center; }
  .tailor-swatches {
    display: grid;
    gap: 8px;
    padding: 10px;
    border-radius: 14px;
    background: rgba(245, 241, 232, 0.05);
    border: 1px solid var(--line);
  }
  .tailor-swatches i {
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: var(--c);
    box-shadow: 0 0 0 2px rgba(3, 13, 11, 0.8);
  }
  .tailor-type {
    font-family: var(--font-instrument-serif);
    font-style: italic;
    font-size: 30px;
    color: var(--gold-l);
  }
  .tailor-tag {
    padding: 5px 10px;
    border-radius: 999px;
    background: rgba(212, 175, 55, 0.14);
    border: 1px solid rgba(212, 175, 55, 0.4);
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 600;
    color: var(--gold);
    white-space: nowrap;
  }
  .dif-card.is-in .tailor-frame { --brand: 1; border-color: rgba(212, 175, 55, 0.35); }
  .dif-card.is-in .tailor-line.w70 { background: var(--ivory); }
  .dif-card.is-in .tailor-line.w45 { background: var(--gold); }
  .dif-card.is-in .tailor-btn { background: linear-gradient(135deg, var(--gold), var(--gold-l)); box-shadow: 0 0 18px rgba(212, 175, 55, 0.45); }
  .dif-card.is-in .tailor-nav b { background: rgba(212, 175, 55, 0.5); }
  .dif-card.is-in .tailor-grid i { background: rgba(4, 120, 87, 0.45); }
  .dif-card.is-in .tailor-grid i:nth-child(2) { transition-delay: 0.15s; }
  .dif-card.is-in .tailor-grid i:nth-child(3) { transition-delay: 0.3s; }

  /* Visual 3 · Fluxo conectado */
  .dif-visual-flow { min-height: 240px; }
  .flow-svg { position: absolute; inset: 0; width: 100%; height: 100%; }
  .flow-path {
    fill: none;
    stroke: rgba(245, 241, 232, 0.1);
    stroke-width: 2;
    stroke-dasharray: 4 6;
  }
  .flow-path-lit {
    stroke: url(#dif-flow-grad);
    stroke-width: 2.5;
    stroke-dasharray: 340;
    stroke-dashoffset: 340;
    filter: drop-shadow(0 0 6px rgba(212, 175, 55, 0.6));
    transition: stroke-dashoffset 2.2s var(--ease) 0.2s;
  }
  .dif-card.is-in .flow-path-lit { stroke-dashoffset: 0; }
  .flow-node {
    position: absolute;
    left: var(--x);
    top: var(--y);
    transform: translate(-50%, -50%) scale(0.85);
    padding: 8px 13px;
    border-radius: 999px;
    border: 1px solid rgba(245, 241, 232, 0.14);
    background: rgba(8, 26, 21, 0.9);
    font-family: var(--font-sans);
    font-size: 13px;
    color: var(--ivory-2);
    opacity: 0.45;
    transition: all 0.6s var(--ease);
    transition-delay: calc(var(--d) * 0.45s + 0.2s);
    white-space: nowrap;
  }
  .flow-node b { font-weight: 600; }
  .dif-card.is-in .flow-node {
    opacity: 1;
    transform: translate(-50%, -50%) scale(1);
    color: var(--ivory);
    border-color: rgba(212, 175, 55, 0.45);
  }
  .dif-card.is-in .flow-node-goal {
    background: linear-gradient(135deg, #25D366, #128C7E);
    border-color: transparent;
    color: #fff;
    box-shadow: 0 0 30px rgba(37, 211, 102, 0.4);
  }

  /* --------------------------------------------------------------------------
     RESPONSIVO
     -------------------------------------------------------------------------- */
  @media (max-width: 1024px) {
    .dif-wrap { grid-template-columns: 1fr; gap: 40px; }
    .dif-intro-inner { position: static; }
    .dif-index { display: none; }
    .dif-lead { margin-bottom: 0; }
    .dif-card { top: calc(88px + var(--i) * 14px); min-height: 0; }
  }

  @media (max-width: 640px) {
    .diferencial-section { padding: 72px 0 64px; }
    .dif-card { padding: 24px 20px; border-radius: 24px; gap: 20px; }
    .dif-visual { min-height: 190px; border-radius: 16px; }
    .dif-visual-tailor { grid-template-columns: 1fr; padding: 16px; }
    .tailor-tools { grid-auto-flow: column; justify-content: start; align-items: center; }
    .tailor-swatches { grid-auto-flow: column; }
    .flow-node { font-size: 12px; padding: 6px 10px; }
    .chat-bubble, .chat-typing { font-size: 13px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .dif-card { transform: none !important; filter: none !important; }
    .chat-bubble, .chat-typing, .flow-node, .flow-path-lit, .tailor-frame * { transition: none !important; }
    .chat-typing i { animation: none; }
  }
</style>

<script>
  // Cards empilháveis: o card de trás encolhe e escurece quando o próximo o cobre;
  // cada card "acende" (classe is-in) ao chegar ao topo; o índice lateral acompanha.
  const initDiferencial = () => {
    const section = document.getElementById('diferencial');
    if (!section) return;
    const cards = Array.from(section.querySelectorAll<HTMLElement>('.dif-card'));
    const indexItems = Array.from(section.querySelectorAll<HTMLElement>('[data-dif-index]'));
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let raf = 0;

    const update = () => {
      raf = 0;
      const vh = window.innerHeight;
      let active = 0;
      cards.forEach((card, i) => {
        const r = card.getBoundingClientRect();
        if (r.top < vh * 0.7) {
          card.classList.add('is-in');
          active = i;
        }
        const next = cards[i + 1];
        let cover = 0;
        if (next) {
          const nr = next.getBoundingClientRect();
          cover = Math.min(1, Math.max(0, (r.bottom - nr.top) / Math.max(1, r.height)));
        }
        if (!reduced) {
          card.style.setProperty('--stack-scale', (1 - cover * 0.06).toFixed(4));
          card.style.setProperty('--stack-dim', cover.toFixed(4));
        }
      });
      indexItems.forEach((li, i) => li.classList.toggle('is-active', i === active));
    };

    const schedule = () => {
      if (!raf) raf = requestAnimationFrame(update);
    };
    window.addEventListener('scroll', schedule, { passive: true });
    window.addEventListener('resize', schedule);
    update();
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initDiferencial);
  } else {
    initDiferencial();
  }
</script>
