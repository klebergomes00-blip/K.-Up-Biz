---
// src/components/NossoDiferencial.astro — Quinta Dobra: O Diferencial K. Up Biz
// Três diferenciais reais em cards que se empilham com o scroll (sticky stack).
// Cada card tem uma cena viva (conversa, marca aplicada, fluxo conectado) que só
// anima enquanto está visível. Sem vídeo e sem pinning do GSAP: leve e estável.
---

<section class="diferencial-section" id="diferencial" aria-labelledby="diferencial-title">
  <div class="dif-ambient dif-ambient-emerald" aria-hidden="true"></div>
  <div class="dif-ambient dif-ambient-gold" aria-hidden="true"></div>

  <div class="dif-wrap">
    <!-- COLUNA ESQUERDA: TEXTO FIXO -->
    <div class="dif-intro">
      <div class="dif-intro-inner">
        <div class="dif-eyebrow">
          <span class="dif-pip" aria-hidden="true"></span>
          <span>04 / NOSSO DIFERENCIAL</span>
        </div>

        <h2 class="dif-title" id="diferencial-title">
          <span class="dif-title-line">Nada de pacote genérico.</span>
          <span class="dif-title-line dif-gold">Tudo pensado para o seu negócio.</span>
        </h2>

        <div class="dif-divider" aria-hidden="true"></div>

        <p class="dif-lead">
          Cada projeto é adaptado à sua marca, ao seu público e ao seu objetivo. E quem cuida dele do começo ao fim é a mesma pessoa que conversa com você.
        </p>

        <ol class="dif-index" aria-hidden="true">
          <li data-dif-index="0"><span>01</span>Atendimento direto</li>
          <li data-dif-index="1"><span>02</span>Sob medida</li>
          <li data-dif-index="2"><span>03</span>Tudo conectado</li>
        </ol>
      </div>
    </div>

    <!-- COLUNA DIREITA: CARDS EMPILHÁVEIS -->
    <div class="dif-stack">
      <!-- Luzes coloridas atrás do vidro (o vidro precisa de algo para "refratar") -->
      <div class="dif-glass-bg" aria-hidden="true">
        <div class="dif-orbs"><i class="o1"></i><i class="o2"></i><i class="o3"></i></div>
      </div>
      <!-- CARD 1 · ATENDIMENTO DIRETO -->
      <article class="dif-card" data-dif-card="0" style="--i:0">
        <span class="dif-card-light" aria-hidden="true"></span>
        <span class="dif-card-rim" aria-hidden="true"><i></i></span>
        <span class="dif-card-mark" aria-hidden="true">01</span>
        <div class="dif-card-text">
          <span class="dif-card-num"><i aria-hidden="true"></i>01 · Atendimento direto</span>
          <h3 class="dif-card-title">Você fala direto<br/><em>com quem faz.</em></h3>
          <p class="dif-card-desc">
            Sem intermediários e sem briefing passado de mão em mão. Do primeiro contato à entrega, o atendimento é comigo, o mesmo profissional que cria o seu projeto.
          </p>
        </div>

        <div class="dif-visual dif-visual-chat" aria-hidden="true">
          <div class="chat-head">
            <span class="chat-avatar"><span class="chat-photo"></span><span class="chat-dot"></span></span>
            <span class="chat-who">
              <b>Kleber · K. Up Biz</b>
              <small class="chat-status" data-chat-status>online</small>
            </span>
            <span class="dif-illus">Exemplo de conversa</span>
          </div>
          <div class="chat-body" data-chat-body>
            <span class="chat-day">Hoje</span>
            <div class="chat-msg chat-in" data-step="0">
              Oi! Quero melhorar a presença da minha empresa.
              <time>09:41</time>
            </div>
            <div class="chat-msg chat-out" data-step="1">
              Oi! Eu mesmo cuido do seu projeto, do início ao fim. Me conta sobre o seu negócio?
              <time>09:42 <span class="chat-ticks"><svg viewBox="0 0 18 11"><path d="M1 6l3 3 6-7M7 9l1 1 8-9" /></svg></span></time>
            </div>
            <div class="chat-msg chat-in" data-step="2">
              Tenho uma loja e quero aparecer no Google.
              <time>09:43</time>
            </div>
            <div class="chat-msg chat-out" data-step="3">
              Perfeito! Vou te mostrar o caminho e acompanhar cada etapa com você.
              <time>09:43 <span class="chat-ticks"><svg viewBox="0 0 18 11"><path d="M1 6l3 3 6-7M7 9l1 1 8-9" /></svg></span></time>
            </div>
            <div class="chat-typing" data-chat-typing><i></i><i></i><i></i></div>
          </div>
        </div>
      </article>

      <!-- CARD 2 · SOB MEDIDA -->
      <article class="dif-card" data-dif-card="1" style="--i:1">
        <span class="dif-card-light" aria-hidden="true"></span>
        <span class="dif-card-rim" aria-hidden="true"><i></i></span>
        <span class="dif-card-mark" aria-hidden="true">02</span>
        <div class="dif-card-text">
          <span class="dif-card-num"><i aria-hidden="true"></i>02 · Sob medida</span>
          <h3 class="dif-card-title">Sob medida,<br/><em>no ritmo certo.</em></h3>
          <p class="dif-card-desc">
            Criado do zero ou a partir de uma base pronta quando o prazo pede: design, textos e estrutura são sempre adaptados à identidade da sua marca.
          </p>
        </div>

        <div class="dif-visual dif-visual-tailor" aria-hidden="true">
          <span class="dif-illus">Exemplo ilustrativo</span>
          <div class="tl-browser">
            <div class="tl-bar">
              <span class="tl-lights"><i></i><i></i><i></i></span>
              <span class="tl-url"><svg viewBox="0 0 12 12"><path d="M3.5 5.5V4a2.5 2.5 0 0 1 5 0v1.5M2.5 5.5h7v5h-7z" /></svg>suamarca.com.br</span>
            </div>
            <div class="tl-stage">
              <!-- Camada 1: base neutra -->
              <div class="tl-layer tl-base">
                <span class="tl-chip">Base</span>
                <div class="tl-nav"><b></b><i></i><i></i><i></i></div>
                <div class="tl-hero">
                  <span class="tl-bar-l w80"></span>
                  <span class="tl-bar-l w55"></span>
                  <span class="tl-bar-s w65"></span>
                  <span class="tl-btn"></span>
                </div>
                <div class="tl-grid"><i></i><i></i><i></i></div>
              </div>
              <!-- Camada 2: com a identidade da marca -->
              <div class="tl-clip"><div class="tl-layer tl-brand">
                <span class="tl-chip tl-chip-gold">Sua marca</span>
                <div class="tl-nav">
                  <span class="tl-logo"><em>S</em>Sua marca</span><i></i><i></i><i></i>
                </div>
                <div class="tl-hero">
                  <span class="tl-h">Do seu jeito,</span>
                  <span class="tl-h tl-h-gold">para o seu cliente.</span>
                  <span class="tl-bar-s w65"></span>
                  <span class="tl-btn">Fale conosco</span>
                </div>
                <div class="tl-grid"><i></i><i></i><i></i></div>
              </div></div>
              <span class="tl-scan"></span>
            </div>
          </div>

          <div class="tl-tools">
            <span class="tl-tool" style="--t:0">
              <span class="tl-sw"><i style="--c:#D4AF37"></i><i style="--c:#047857"></i><i style="--c:#F5F1E8"></i></span>
              Cores
            </span>
            <span class="tl-tool" style="--t:1"><span class="tl-aa">Aa</span>Tipografia</span>
            <span class="tl-tool" style="--t:2"><span class="tl-mk"><em>S</em></span>Logo</span>
          </div>
          <svg class="tl-cursor" viewBox="0 0 20 24"><path d="M2 2l15 10-7 1.5L13.5 21l-3 1.2L7 15l-5 4.5z" /></svg>
        </div>
      </article>

      <!-- CARD 3 · TUDO CONECTADO -->
      <article class="dif-card" data-dif-card="2" style="--i:2">
        <span class="dif-card-light" aria-hidden="true"></span>
        <span class="dif-card-rim" aria-hidden="true"><i></i></span>
        <span class="dif-card-mark" aria-hidden="true">03</span>
        <div class="dif-card-text">
          <span class="dif-card-num"><i aria-hidden="true"></i>03 · Tudo conectado</span>
          <h3 class="dif-card-title">Site, Google e anúncios<br/><em>trabalhando juntos.</em></h3>
          <p class="dif-card-desc">
            Em vez de três fornecedores, uma estratégia só: anúncios, Google e site trabalham juntos para atrair clientes, e todos levam ao seu WhatsApp.
          </p>
        </div>

        <div class="dif-visual dif-visual-flow" aria-hidden="true" data-flow>
          <span class="dif-illus">Exemplo ilustrativo</span>
          <span class="flow-col flow-col-in">Captação</span>
          <span class="flow-col flow-col-out">Atendimento</span>

          <svg class="flow-svg" viewBox="0 0 320 240" preserveAspectRatio="none">
            <defs>
              <linearGradient id="dif-flow-grad" x1="0" y1="0" x2="1" y2="0">
                <stop offset="0%" stop-color="#D4AF37" />
                <stop offset="100%" stop-color="#2EE59D" />
              </linearGradient>
            </defs>
            <path class="flow-path" d="M138 72 C 170 72, 166 132, 196 132" />
            <path class="flow-path" d="M138 132 C 160 132, 176 132, 196 132" />
            <path class="flow-path" d="M138 192 C 170 192, 166 132, 196 132" />
            <path class="flow-path flow-path-lit" data-flow-path d="M138 72 C 170 72, 166 132, 196 132" />
            <path class="flow-path flow-path-lit" data-flow-path d="M138 132 C 160 132, 176 132, 196 132" />
            <path class="flow-path flow-path-lit" data-flow-path d="M138 192 C 170 192, 166 132, 196 132" />
          </svg>
          <span class="flow-dot" data-flow-dot></span>

          <span class="flow-src" data-flow-src style="--y:30%">
            <span class="flow-ic"><svg viewBox="0 0 24 24"><path d="M3 10v4h3l6 4V6L6 10H3zM16 8.5a5 5 0 0 1 0 7M18.5 6a8.5 8.5 0 0 1 0 12" /></svg></span>
            <b>Tráfego pago</b>
          </span>
          <span class="flow-src" data-flow-src style="--y:55%">
            <span class="flow-ic"><svg viewBox="0 0 24 24"><path d="M12 21s-6.5-5.6-6.5-11a6.5 6.5 0 0 1 13 0C18.5 15.4 12 21 12 21z" /><circle cx="12" cy="10" r="2.3" /></svg></span>
            <b>Google</b>
          </span>
          <span class="flow-src" data-flow-src style="--y:80%">
            <span class="flow-ic"><svg viewBox="0 0 24 24"><rect x="3" y="4.5" width="18" height="15" rx="2.5" /><path d="M3 9h18M6.5 6.8h.01M9 6.8h.01" /></svg></span>
            <b>Site</b>
          </span>

          <div class="flow-hub" data-flow-hub>
            <span class="flow-hub-ring"></span>
            <span class="flow-hub-ic"><svg viewBox="0 0 24 24"><path d="M4.5 19.5l1.2-3.6A8 8 0 1 1 8.6 18.6z" /><path d="M9.2 9.3c.3 1.9 2.1 4 4.1 4.6l1.1-1.1 1.6.8-.4 1.4c-3.4.3-7-3.3-7.2-6.4l1.3-.6.8 1.6z" /></svg></span>
            <b>WhatsApp</b>
          </div>

          <div class="flow-toast" data-flow-toast>
            <b>Nova conversa</b>
            <small data-flow-msg>“Vi seu anúncio!”</small>
          </div>
        </div>
      </article>
    </div>
  </div>
</section>

<style>
  /* ==========================================================================
     K. UP BIZ — QUINTA DOBRA | NOSSO DIFERENCIAL (cards empilháveis vivos)
     Paleta: #041D17, #030D0B, #047857, #D4AF37, #F5F1E8
     ========================================================================== */

  .diferencial-section {
    --gold: #D4AF37;
    --gold-l: #F3E5AB;
    --ivory: #F5F1E8;
    --ivory-2: rgba(245, 241, 232, 0.72);
    --ivory-3: rgba(245, 241, 232, 0.64);
    --mint: #2EE59D;
    --line: rgba(245, 241, 232, 0.09);
    --ease: cubic-bezier(0.16, 1, 0.3, 1);
    position: relative;
    width: 100%;
    background: linear-gradient(180deg, #041D17 0%, #030D0B 160px, #030D0B calc(100% - 160px), #041D17 100%);
    color: var(--ivory);
    overflow: clip;
    z-index: 7;
    padding: clamp(80px, 14vh, 160px) 0 clamp(80px, 12vh, 140px);
  }

  .dif-ambient {
    position: absolute;
    border-radius: 50%;
    filter: blur(110px);
    pointer-events: none;
  }
  .dif-ambient-emerald { width: 600px; height: 600px; left: -200px; top: 20%; background: rgba(4, 120, 87, 0.22); }
  .dif-ambient-gold { width: 480px; height: 480px; right: -160px; bottom: 10%; background: rgba(212, 175, 55, 0.08); }

  .dif-wrap {
    position: relative;
    max-width: var(--max-width, 1240px);
    margin: 0 auto;
    padding: 0 clamp(20px, 5vw, 64px);
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
    gap: clamp(32px, 6vw, 96px);
    align-items: start;
  }

  /* --------------------------------------------------------------------------
     TEXTO FIXO
     -------------------------------------------------------------------------- */
  .dif-intro { position: relative; height: 100%; }
  .dif-intro-inner {
    position: sticky;
    top: clamp(96px, 16vh, 160px);
  }
  .dif-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 22px;
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.22em;
    color: var(--gold);
  }
  .dif-pip {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--mint);
    box-shadow: 0 0 10px var(--mint);
  }
  .dif-title {
    margin: 0;
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: clamp(32px, 3.5vw, 52px);
    line-height: 1.05;
    letter-spacing: -0.035em;
  }
  .dif-title-line { display: block; }
  .dif-gold {
    font-family: var(--font-instrument-serif);
    font-style: italic;
    font-weight: 400;
    letter-spacing: -0.01em;
    color: var(--gold);
  }
  .dif-divider {
    width: 56px;
    height: 1px;
    margin: 28px 0;
    background: linear-gradient(90deg, var(--gold), transparent);
  }
  .dif-lead {
    max-width: 440px;
    margin: 0 0 36px;
    font-family: var(--font-sans);
    font-size: clamp(16px, 1.25vw, 18px);
    line-height: 1.65;
    color: var(--ivory-2);
  }
  .dif-index {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 4px;
  }
  .dif-index li {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 10px 0;
    font-family: var(--font-sans);
    font-size: 15px;
    font-weight: 500;
    color: var(--ivory-3);
    transition: color 0.5s ease, transform 0.5s var(--ease);
  }
  .dif-index li span {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.14em;
    color: inherit;
  }
  .dif-index li::after {
    content: '';
    flex: 1;
    max-width: 0;
    height: 1px;
    background: linear-gradient(90deg, var(--gold), transparent);
    transition: max-width 0.7s var(--ease);
  }
  .dif-index li.is-active { color: var(--ivory); transform: translateX(6px); }
  .dif-index li.is-active span { color: var(--gold); }
  .dif-index li.is-active::after { max-width: 120px; }

  /* Luzes atrás do vidro: acompanham os cards (sticky) */
  .dif-glass-bg {
    position: absolute;
    inset: 0 -8% 0 -8%;
    pointer-events: none;
    z-index: 0;
  }
  .dif-orbs {
    position: sticky;
    top: 0;
    height: 100vh;
    height: 100svh;
  }
  .dif-orbs i {
    position: absolute;
    border-radius: 50%;
    filter: blur(60px);
    opacity: 0.85;
    animation: difOrb 18s ease-in-out infinite alternate;
    animation-play-state: paused;
  }
  .dif-orbs .o1 { width: 300px; height: 300px; left: 4%; top: 18%; background: radial-gradient(circle, rgba(212, 175, 55, 0.7), transparent 70%); }
  .dif-orbs .o2 { width: 360px; height: 360px; right: 0; top: 38%; background: radial-gradient(circle, rgba(4, 140, 100, 0.9), transparent 70%); animation-duration: 22s; animation-delay: -6s; }
  .dif-orbs .o3 { width: 240px; height: 240px; left: 32%; bottom: 6%; background: radial-gradient(circle, rgba(46, 229, 157, 0.5), transparent 70%); animation-duration: 16s; animation-delay: -10s; }
  .diferencial-section.is-visible .dif-orbs i { animation-play-state: running; }
  /* Em celulares e tablets as luzes ficam paradas: movê-las obriga o vidro
     (backdrop-filter) a recalcular o desfoque a cada quadro. */
  @media (hover: none), (max-width: 1024px) {
    .dif-orbs i { animation: none; }
  }
  @keyframes difOrb {
    0% { transform: translate(0, 0) scale(1); }
    50% { transform: translate(60px, -40px) scale(1.12); }
    100% { transform: translate(-40px, 50px) scale(0.92); }
  }
  .dif-card { z-index: 1; }

  /* --------------------------------------------------------------------------
     CARDS EMPILHÁVEIS — casca de vidro, borda de luz e holofote
     -------------------------------------------------------------------------- */
  .dif-stack {
    position: relative;
    display: grid;
    gap: clamp(24px, 8vh, 80px);
    padding-bottom: 4vh;
  }
  .dif-card {
    --stack-scale: 1;
    --stack-dim: 0;
    --rx: 0deg;
    --ry: 0deg;
    --mx: 70%;
    --my: 0%;
    --spot: 0;
    position: sticky;
    top: calc(clamp(96px, 16vh, 160px) + var(--i) * 18px);
    /* o card sempre cabe inteiro na tela abaixo do topo fixo */
    height: min(600px, calc(100svh - clamp(96px, 16vh, 160px) - var(--i) * 18px - 28px));
    display: grid;
    grid-template-rows: auto minmax(0, 1fr);
    gap: 26px;
    padding: clamp(28px, 3.2vw, 42px);
    border-radius: 32px;
    isolation: isolate;
    /* Liquid glass: vidro translúcido que desfoca e satura o que está atrás */
    background:
      linear-gradient(155deg, rgba(255, 255, 255, 0.13) 0%, rgba(255, 255, 255, 0.04) 38%, rgba(255, 255, 255, 0.02) 62%, rgba(255, 255, 255, 0.07) 100%),
      rgba(6, 26, 21, 0.44);
    -webkit-backdrop-filter: blur(26px) saturate(175%) brightness(1.04);
    backdrop-filter: blur(26px) saturate(175%) brightness(1.04);
    box-shadow:
      0 30px 70px -20px rgba(0, 0, 0, 0.65),
      0 2px 6px rgba(0, 0, 0, 0.25),
      inset 0 1px 0 rgba(255, 255, 255, 0.32),
      inset 0 -1px 0 rgba(255, 255, 255, 0.08),
      inset 1px 0 0 rgba(255, 255, 255, 0.1),
      inset 0 0 40px rgba(255, 255, 255, 0.035);
    transform: perspective(1400px) scale(var(--stack-scale)) rotateX(var(--rx)) rotateY(var(--ry));
    transform-origin: 50% 0%;
    filter: brightness(calc(1 - var(--stack-dim) * 0.45));
    overflow: hidden;
    will-change: transform;
    transition: transform 0.5s var(--ease);
  }
  .dif-card.is-tilting { transition: transform 0.12s linear; }

  /* Reflexo especular no topo do vidro */
  .dif-card::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    background:
      radial-gradient(120% 55% at 18% -12%, rgba(255, 255, 255, 0.16), transparent 55%),
      radial-gradient(70% 40% at 100% 110%, rgba(46, 229, 157, 0.10), transparent 60%);
    pointer-events: none;
  }

  /* Borda: fio de luz que percorre o contorno enquanto o card está visível */
  .dif-card::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 2;
    border-radius: inherit;
    padding: 1.2px;
    /* borda de vidro: brilho forte nas quinas, quase invisível nas laterais */
    background:
      radial-gradient(240px circle at var(--mx) var(--my), rgba(255, 255, 255, calc(0.15 + var(--spot) * 0.55)), transparent 70%),
      linear-gradient(150deg, rgba(255, 255, 255, 0.7), rgba(255, 255, 255, 0.12) 22%, rgba(255, 255, 255, 0.04) 50%, rgba(255, 255, 255, 0.1) 78%, rgba(255, 255, 255, 0.45));
    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    pointer-events: none;
  }
  /* Fio de luz que percorre a borda: um gradiente cônico que GIRA (transform),
     recortado na espessura da borda. Girar com transform é feito pela placa de
     vídeo, sem redesenhar o card a cada quadro. */
  .dif-card-rim {
    position: absolute;
    inset: 0;
    z-index: 2;
    border-radius: inherit;
    padding: 1.2px;
    overflow: hidden;
    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    pointer-events: none;
  }
  .dif-card-rim i {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 250%;
    aspect-ratio: 1;
    background: conic-gradient(
      rgba(255, 255, 255, 0) 0deg,
      rgba(243, 229, 171, 0.6) 50deg,
      rgba(255, 255, 255, 0) 120deg,
      rgba(255, 255, 255, 0) 230deg,
      rgba(46, 229, 157, 0.4) 280deg,
      rgba(255, 255, 255, 0) 330deg);
    transform: translate(-50%, -50%) rotate(0deg);
    will-change: transform;
  }
  .dif-card.is-run .dif-card-rim i { animation: difSpin 10s linear infinite; }
  @keyframes difSpin { to { transform: translate(-50%, -50%) rotate(360deg); } }

  /* Holofote que segue o cursor (desktop) */
  .dif-card-light {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: radial-gradient(520px circle at var(--mx) var(--my), rgba(212, 175, 55, 0.13), rgba(46, 229, 157, 0.05) 35%, transparent 60%);
    opacity: calc(0.35 + var(--spot) * 0.65);
    transition: opacity 0.5s ease;
    pointer-events: none;
  }

  /* Número gigante em marca d'água */
  .dif-card-mark {
    position: absolute;
    top: clamp(-18px, -1vw, -6px);
    right: clamp(14px, 2vw, 28px);
    z-index: -1;
    font-family: var(--font-instrument-serif);
    font-style: italic;
    font-size: clamp(120px, 13vw, 190px);
    line-height: 1;
    color: transparent;
    -webkit-text-stroke: 1px rgba(212, 175, 55, 0.22);
    background: linear-gradient(180deg, rgba(212, 175, 55, 0.12), transparent 75%);
    -webkit-background-clip: text;
    background-clip: text;
    pointer-events: none;
    user-select: none;
  }

  .dif-card-text { position: relative; z-index: 1; }
  .dif-card-num {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 16px;
    padding: 6px 12px 6px 8px;
    border-radius: 999px;
    border: 1px solid rgba(212, 175, 55, 0.28);
    background: rgba(212, 175, 55, 0.07);
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--gold);
  }
  .dif-card-num i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--gold);
    box-shadow: 0 0 0 3px rgba(212, 175, 55, 0.18);
    position: relative;
  }
  /* Pulsos feitos com transform/opacity (leves para o celular) */
  .dif-card-num i::after,
  .chat-dot::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    box-shadow: 0 0 0 2px rgba(212, 175, 55, 0.6);
    opacity: 0;
  }
  .chat-dot::after { inset: -2px; box-shadow: 0 0 0 2px rgba(46, 229, 157, 0.7); }
  .dif-card.is-run .dif-card-num i::after { animation: difRing 2.4s ease-out infinite; }
  .dif-card.is-run .chat-dot::after { animation: difRing 2s ease-out infinite; }
  @keyframes difRing {
    0% { transform: scale(1); opacity: 0.9; }
    70%, 100% { transform: scale(2.6); opacity: 0; }
  }
  .dif-card-title {
    margin: 0 0 14px;
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: clamp(26px, 2.6vw, 38px);
    line-height: 1.08;
    letter-spacing: -0.03em;
    color: var(--ivory);
  }
  .dif-card-title em {
    font-family: var(--font-instrument-serif);
    font-style: italic;
    font-weight: 400;
    color: var(--gold);
  }
  .dif-card-desc {
    max-width: 520px;
    margin: 0;
    font-family: var(--font-sans);
    font-size: clamp(15px, 1.15vw, 17px);
    line-height: 1.6;
    color: var(--ivory-2);
  }

  /* Palco das cenas */
  .dif-visual {
    position: relative;
    z-index: 1;
    min-height: 0;
    border-radius: 22px;
    border: 1px solid rgba(255, 255, 255, 0.12);
    background:
      linear-gradient(160deg, rgba(255, 255, 255, 0.07), rgba(255, 255, 255, 0.015) 45%),
      rgba(2, 12, 10, 0.5);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.18),
      inset 0 -1px 0 rgba(255, 255, 255, 0.04),
      0 20px 50px -30px rgba(0, 0, 0, 0.8);
    overflow: hidden;
    transform: translateZ(0);
  }
  .dif-illus {
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.02em;
    color: rgba(245, 241, 232, 0.72);
    white-space: nowrap;
  }
  .dif-visual-tailor > .dif-illus,
  .dif-visual-flow > .dif-illus {
    position: absolute;
    top: 12px;
    right: 14px;
    z-index: 4;
    padding: 3px 9px;
    border-radius: 999px;
    background: rgba(3, 13, 11, 0.7);
    border: 1px solid var(--line);
  }

  /* --------------------------------------------------------------------------
     CENA 1 · Conversa direta (estilo mensageiro)
     -------------------------------------------------------------------------- */
  .dif-visual-chat { display: flex; flex-direction: column; }
  .chat-head {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 16px;
    border-bottom: 1px solid var(--line);
    background: rgba(255, 255, 255, 0.04);
  }
  .chat-head .dif-illus { margin-left: auto; }
  .chat-avatar { position: relative; flex: none; width: 40px; height: 40px; }
  .chat-photo {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: #0B231D url('/imagens/kleber-avatar.webp') center / cover no-repeat;
    box-shadow: 0 0 0 2px rgba(212, 175, 55, 0.6), 0 0 18px rgba(212, 175, 55, 0.3);
  }
  .chat-dot {
    position: absolute;
    right: -1px;
    bottom: -1px;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--mint);
    border: 2px solid #081C17;
  }
  .chat-who { display: grid; font-family: var(--font-sans); min-width: 0; }
  .chat-who b { font-size: 14px; font-weight: 600; color: var(--ivory); white-space: nowrap; }
  .chat-status { font-size: 12px; color: var(--mint); transition: color 0.3s ease; }

  .chat-body {
    position: relative;
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 8px;
    padding: 16px;
    overflow: hidden;
    background-image: radial-gradient(rgba(245, 241, 232, 0.05) 1px, transparent 1px);
    background-size: 16px 16px;
    -webkit-mask-image: linear-gradient(180deg, transparent 0, #000 28px);
    mask-image: linear-gradient(180deg, transparent 0, #000 28px);
  }
  .chat-day {
    align-self: center;
    padding: 3px 10px;
    border-radius: 999px;
    background: rgba(245, 241, 232, 0.07);
    font-family: var(--font-sans);
    font-size: 11px;
    color: rgba(245, 241, 232, 0.72);
  }
  .chat-msg {
    position: relative;
    max-width: 80%;
    padding: 9px 13px 7px;
    border-radius: 16px;
    font-family: var(--font-sans);
    font-size: 14px;
    line-height: 1.45;
    color: var(--ivory);
    /* estado visível (sem JS / movimento reduzido) */
  }
  .chat-msg time {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: 4px;
    margin-top: 2px;
    font-size: 10.5px;
    color: rgba(245, 241, 232, 0.66);
  }
  .chat-in {
    align-self: flex-start;
    background: rgba(245, 241, 232, 0.09);
    border-bottom-left-radius: 5px;
  }
  .chat-out {
    align-self: flex-end;
    background: linear-gradient(135deg, #05775A, #045A45);
    border-bottom-right-radius: 5px;
    box-shadow: 0 8px 24px -12px rgba(46, 229, 157, 0.5);
  }
  .chat-ticks svg { width: 15px; height: 10px; fill: none; stroke: currentColor; stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
  .chat-ticks { display: inline-flex; color: rgba(245, 241, 232, 0.66); transition: color 0.4s ease; }
  .chat-msg.is-read .chat-ticks { color: #7CF0C4; }
  .chat-typing {
    align-self: flex-start;
    display: none;
    gap: 4px;
    padding: 11px 14px;
    border-radius: 16px;
    border-bottom-left-radius: 5px;
    background: rgba(245, 241, 232, 0.09);
  }
  .chat-typing i {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--ivory-3);
    animation: difTyping 1.2s ease-in-out infinite;
  }
  .chat-typing i:nth-child(2) { animation-delay: 0.15s; }
  .chat-typing i:nth-child(3) { animation-delay: 0.3s; }
  @keyframes difTyping {
    0%, 60%, 100% { transform: translateY(0); opacity: 0.4; }
    30% { transform: translateY(-4px); opacity: 1; }
  }

  /* Modo animado (ligado pelo script): mensagens entram uma a uma */
  .dif-visual-chat.is-live .chat-msg {
    display: none;
  }
  .dif-visual-chat.is-live .chat-msg.is-shown {
    display: block;
    animation: difPop 0.55s var(--ease) both;
  }
  .dif-visual-chat.is-live .chat-typing.is-shown {
    display: inline-flex;
    animation: difPop 0.4s var(--ease) both;
  }
  .chat-typing.is-out { align-self: flex-end; border-bottom-left-radius: 16px; border-bottom-right-radius: 5px; background: rgba(4, 120, 87, 0.55); }
  @keyframes difPop {
    from { opacity: 0; transform: translateY(12px) scale(0.94); }
    to { opacity: 1; transform: none; }
  }
  .chat-in.is-shown { transform-origin: 0 100%; }
  .chat-out.is-shown { transform-origin: 100% 100%; }

  /* --------------------------------------------------------------------------
     CENA 2 · Sob medida: base pronta → identidade da marca
     -------------------------------------------------------------------------- */
  .dif-visual-tailor {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 16px;
    align-items: center;
    padding: 44px 18px 18px;
  }
  /* Revelação da marca: a "janela" (tl-clip) desliza para a direita enquanto o
     conteúdo dentro dela desliza o mesmo tanto para o outro lado, ficando parado.
     Só transform: a placa de vídeo faz o trabalho, sem redesenhar a cena. */
  @keyframes difClip {
    0%, 8% { transform: translateX(-100%); }
    46%, 88% { transform: translateX(0); }
    100% { transform: translateX(-100%); }
  }
  @keyframes difClipIn {
    0%, 8% { transform: translateX(100%); }
    46%, 88% { transform: translateX(0); }
    100% { transform: translateX(100%); }
  }

  .tl-browser {
    align-self: stretch;
    display: flex;
    flex-direction: column;
    min-height: 0;
    border-radius: 14px;
    border: 1px solid rgba(245, 241, 232, 0.12);
    background: #0A1A16;
    box-shadow: 0 24px 50px -24px rgba(0, 0, 0, 0.9);
    overflow: hidden;
  }
  .tl-bar {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 10px;
    border-bottom: 1px solid var(--line);
    background: rgba(245, 241, 232, 0.04);
  }
  .tl-lights { display: inline-flex; gap: 5px; }
  .tl-lights i { width: 8px; height: 8px; border-radius: 50%; background: rgba(245, 241, 232, 0.18); }
  .tl-url {
    flex: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 5px;
    padding: 3px 8px;
    border-radius: 6px;
    background: rgba(3, 13, 11, 0.6);
    font-family: var(--font-sans);
    font-size: 11px;
    color: rgba(245, 241, 232, 0.72);
  }
  .tl-url svg { width: 10px; height: 10px; fill: none; stroke: currentColor; stroke-width: 1.2; }

  .tl-stage { position: relative; flex: 1; min-height: 0; }
  .tl-layer {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 14px 16px;
  }
  .tl-base { background: #17201E; }
  .tl-clip { position: absolute; inset: 0; overflow: hidden; }
  .tl-brand {
    background:
      radial-gradient(90% 80% at 100% 0%, rgba(4, 120, 87, 0.45), transparent 60%),
      linear-gradient(180deg, #062A21, #041D17);
  }
  .tl-scan {
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0;
  }
  .tl-scan::after {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    right: -1px;
    width: 2px;
    background: linear-gradient(180deg, transparent, var(--gold-l), var(--gold), transparent);
    box-shadow: 0 0 14px 2px rgba(212, 175, 55, 0.6), 0 0 40px 6px rgba(212, 175, 55, 0.18);
  }
  .dif-card.is-run .tl-clip,
  .dif-card.is-run .tl-scan { animation: difClip 7.5s var(--ease) infinite; will-change: transform; }
  .dif-card.is-run .tl-brand { animation: difClipIn 7.5s var(--ease) infinite; will-change: transform; }
  .dif-card.is-run .tl-scan { opacity: 1; }

  .tl-chip {
    position: absolute;
    right: 10px;
    top: 44%;
    padding: 2px 8px;
    border-radius: 999px;
    background: rgba(245, 241, 232, 0.08);
    font-family: var(--font-sans);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.06em;
    color: rgba(245, 241, 232, 0.7);
  }
  .tl-chip-gold { background: rgba(212, 175, 55, 0.18); color: var(--gold-l); }

  .tl-nav { display: flex; align-items: center; gap: 8px; }
  .tl-nav i { width: 20px; height: 4px; border-radius: 4px; background: rgba(245, 241, 232, 0.2); }
  .tl-nav i:first-of-type { margin-left: auto; }
  .tl-base .tl-nav b { width: 52px; height: 10px; border-radius: 4px; background: rgba(245, 241, 232, 0.25); }
  .tl-logo {
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.02em;
    color: var(--ivory);
  }
  .tl-logo em {
    display: inline-grid;
    place-items: center;
    width: 16px;
    height: 16px;
    margin-right: 5px;
    border-radius: 5px;
    background: linear-gradient(135deg, var(--gold), var(--gold-l));
    font-family: var(--font-instrument-serif);
    font-size: 12px;
    color: #041D17;
    vertical-align: -3px;
  }
  .tl-brand .tl-nav i { background: rgba(243, 229, 171, 0.45); }
  .tl-hero { flex: 1; display: flex; flex-direction: column; justify-content: center; gap: 7px; }
  .tl-bar-l, .tl-bar-s { display: block; border-radius: 5px; background: rgba(245, 241, 232, 0.2); }
  .tl-bar-l { height: 12px; }
  .tl-bar-s { height: 6px; background: rgba(245, 241, 232, 0.12); }
  .w80 { width: 80%; } .w55 { width: 55%; } .w65 { width: 65%; }
  .tl-h {
    font-family: var(--font-sans);
    font-size: clamp(15px, 1.35vw, 19px);
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: var(--ivory);
    white-space: nowrap;
  }
  .tl-h-gold { font-family: var(--font-instrument-serif); font-style: italic; font-weight: 400; color: var(--gold); letter-spacing: -0.01em; }
  .tl-brand .tl-bar-s { margin-top: 3px; background: rgba(245, 241, 232, 0.22); }
  .tl-btn {
    align-self: flex-start;
    margin-top: 4px;
    width: 78px;
    height: 18px;
    border-radius: 999px;
    background: rgba(245, 241, 232, 0.16);
  }
  .tl-brand .tl-btn {
    width: auto;
    height: auto;
    padding: 4px 11px;
    background: linear-gradient(135deg, var(--gold), var(--gold-l));
    font-family: var(--font-sans);
    font-size: 10px;
    font-weight: 700;
    color: #041D17;
    box-shadow: 0 0 16px rgba(212, 175, 55, 0.45);
  }
  .tl-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 7px; }
  .tl-grid i { height: 26px; border-radius: 7px; background: rgba(245, 241, 232, 0.08); }
  .tl-brand .tl-grid i { background: linear-gradient(160deg, rgba(46, 229, 157, 0.28), rgba(4, 120, 87, 0.35)); border: 1px solid rgba(46, 229, 157, 0.2); }
  .tl-brand .tl-grid i:nth-child(2) { background: linear-gradient(160deg, rgba(212, 175, 55, 0.35), rgba(212, 175, 55, 0.12)); border-color: rgba(212, 175, 55, 0.3); }

  .tl-tools { display: grid; gap: 10px; }
  .tl-tool {
    display: flex;
    align-items: center;
    gap: 9px;
    padding: 8px 12px 8px 8px;
    border-radius: 12px;
    border: 1px solid rgba(245, 241, 232, 0.1);
    background: rgba(245, 241, 232, 0.04);
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 600;
    color: var(--ivory-2);
    white-space: nowrap;
  }
  .dif-card.is-run .tl-tool { animation: difTool 7.5s var(--ease) infinite; animation-delay: calc(0.6s + var(--t) * 0.85s); }
  @keyframes difTool {
    0%, 4% { border-color: rgba(245, 241, 232, 0.1); background: rgba(245, 241, 232, 0.04); transform: none; color: rgba(245, 241, 232, 0.72); }
    8%, 22% { border-color: rgba(212, 175, 55, 0.6); background: rgba(212, 175, 55, 0.12); transform: translateX(-6px); color: #F5F1E8; box-shadow: 0 0 22px -6px rgba(212, 175, 55, 0.7); }
    34%, 100% { border-color: rgba(212, 175, 55, 0.25); background: rgba(245, 241, 232, 0.04); transform: none; color: rgba(245, 241, 232, 0.72); }
  }
  .tl-sw { display: inline-flex; }
  .tl-sw i { width: 14px; height: 14px; margin-right: -4px; border-radius: 50%; background: var(--c); box-shadow: 0 0 0 2px #0A1A16; }
  .tl-sw i:last-child { margin-right: 0; }
  .tl-aa {
    width: 22px;
    font-family: var(--font-instrument-serif);
    font-style: italic;
    font-size: 18px;
    line-height: 1;
    text-align: center;
    color: var(--gold-l);
  }
  .tl-mk {
    display: grid;
    place-items: center;
    width: 22px;
    height: 22px;
    border-radius: 7px;
    background: linear-gradient(135deg, var(--gold), var(--gold-l));
  }
  .tl-mk em { font-family: var(--font-instrument-serif); font-size: 15px; color: #041D17; }

  /* Cursor que "aplica" cada ferramenta ao site */
  .tl-cursor {
    position: absolute;
    left: 0;
    top: 0;
    z-index: 5;
    width: 18px;
    height: 22px;
    fill: #F5F1E8;
    stroke: #030D0B;
    stroke-width: 1.4;
    stroke-linejoin: round;
    filter: drop-shadow(0 4px 8px rgba(0, 0, 0, 0.6));
    opacity: 0;
    pointer-events: none;
  }
  .dif-card.is-run .tl-cursor { animation: difCursor 7.5s var(--ease) infinite; }
  @keyframes difCursor {
    0% { opacity: 0; transform: translate(calc(var(--tw, 300px) - 60px), 64px); }
    6% { opacity: 1; transform: translate(calc(var(--tw, 300px) - 80px), 70px); }
    14% { transform: translate(calc(var(--tw, 300px) * 0.32), 120px); }
    18% { transform: translate(calc(var(--tw, 300px) - 80px), 116px); }
    26% { transform: translate(calc(var(--tw, 300px) * 0.42), 150px); }
    30% { transform: translate(calc(var(--tw, 300px) - 80px), 160px); }
    40% { opacity: 1; transform: translate(calc(var(--tw, 300px) * 0.18), 96px); }
    52%, 100% { opacity: 0; transform: translate(calc(var(--tw, 300px) * 0.18), 96px); }
  }

  /* --------------------------------------------------------------------------
     CENA 3 · Duas frentes: captação (tráfego, Google, site) → WhatsApp
     -------------------------------------------------------------------------- */
  .dif-visual-flow { min-height: 0; }
  .flow-svg { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  .flow-path {
    fill: none;
    stroke: rgba(245, 241, 232, 0.16);
    stroke-width: 1.5;
    stroke-dasharray: 3 5;
    vector-effect: non-scaling-stroke;
  }
  .flow-path-lit {
    stroke: url(#dif-flow-grad);
    stroke-width: 2.4;
    stroke-linecap: round;
    stroke-dasharray: none;
    vector-effect: none;
    filter: drop-shadow(0 0 4px rgba(212, 175, 55, 0.7));
  }
  .flow-col {
    position: absolute;
    z-index: 2;
    font-family: var(--font-sans);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--gold);
  }
  .flow-col-in { left: 5%; top: 9%; }
  .flow-col-out { left: 61%; top: calc(55% - 52px); color: #7CF0C4; }

  .flow-src {
    position: absolute;
    left: 5%;
    top: var(--y);
    z-index: 2;
    width: 38%;
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 6px 10px 6px 6px;
    border-radius: 12px;
    border: 1px solid rgba(212, 175, 55, 0.45);
    background: linear-gradient(160deg, rgba(255, 255, 255, 0.1), rgba(255, 255, 255, 0.03)), rgba(6, 24, 20, 0.85);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.2), 0 10px 24px -14px rgba(0, 0, 0, 0.9);
    font-family: var(--font-sans);
    font-size: 12.5px;
    color: var(--ivory);
    white-space: nowrap;
    transform: translateY(-50%);
    transition: border-color 0.45s ease, box-shadow 0.45s ease, transform 0.45s var(--ease);
  }
  .flow-src b { font-weight: 600; overflow: hidden; text-overflow: ellipsis; }
  .flow-ic {
    flex: none;
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    border-radius: 8px;
    background: linear-gradient(135deg, var(--gold), var(--gold-l));
    color: #041D17;
    transition: background 0.45s ease, color 0.45s ease;
  }
  .flow-ic svg { width: 14px; height: 14px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }

  .flow-hub {
    position: absolute;
    left: 61%;
    top: 55%;
    z-index: 2;
    width: 34%;
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 9px 10px 9px 9px;
    border-radius: 16px;
    border: 1px solid rgba(37, 211, 102, 0.6);
    background: linear-gradient(160deg, rgba(255, 255, 255, 0.16), rgba(255, 255, 255, 0.02)), linear-gradient(135deg, #1C9E57, #0E6B5F);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.35), 0 0 30px rgba(37, 211, 102, 0.35), 0 14px 30px -14px rgba(0, 0, 0, 0.9);
    font-family: var(--font-sans);
    font-size: 13px;
    color: #fff;
    white-space: nowrap;
    transform: translateY(-50%);
  }
  .flow-hub b { font-weight: 700; }
  .flow-hub-ic {
    flex: none;
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.2);
  }
  .flow-hub-ic svg { width: 17px; height: 17px; fill: none; stroke: #fff; stroke-width: 1.8; stroke-linejoin: round; }
  .flow-hub-ring {
    position: absolute;
    inset: -1px;
    border-radius: inherit;
    border: 2px solid rgba(46, 229, 157, 0.7);
    opacity: 0;
    pointer-events: none;
  }
  .flow-hub.is-hit .flow-hub-ring { animation: difHit 0.9s ease-out; }
  .flow-hub.is-hit { animation: difHub 0.5s var(--ease); }
  @keyframes difHit {
    from { opacity: 1; transform: scale(1); }
    to { opacity: 0; transform: scale(1.25, 1.6); }
  }
  @keyframes difHub {
    40% { transform: translateY(-50%) scale(1.07); }
  }

  .flow-dot {
    position: absolute;
    left: 0;
    top: 0;
    z-index: 3;
    width: 8px;
    height: 8px;
    margin: -4px 0 0 -4px;
    border-radius: 50%;
    background: #FFF8DC;
    box-shadow: 0 0 0 4px rgba(243, 229, 171, 0.25), 0 0 16px 5px rgba(212, 175, 55, 0.8), 0 0 40px 10px rgba(46, 229, 157, 0.25);
    opacity: 0;
    pointer-events: none;
  }

  .flow-toast {
    position: absolute;
    left: 61%;
    top: calc(55% + 32px);
    z-index: 2;
    width: 34%;
    display: grid;
    gap: 1px;
    padding: 7px 10px;
    border-radius: 12px 12px 12px 4px;
    border: 1px solid rgba(255, 255, 255, 0.14);
    background: linear-gradient(160deg, rgba(255, 255, 255, 0.12), rgba(255, 255, 255, 0.03)), rgba(6, 22, 18, 0.9);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.2), 0 12px 28px -12px rgba(0, 0, 0, 0.9);
    font-family: var(--font-sans);
  }
  .flow-toast b { font-size: 11.5px; font-weight: 700; color: #7CF0C4; }
  .flow-toast small { font-size: 11.5px; line-height: 1.3; color: var(--ivory); }

  /* Com o script: frentes apagadas até a luz sair delas */
  .dif-visual-flow.is-live .flow-src { border-color: rgba(245, 241, 232, 0.14); color: rgba(245, 241, 232, 0.8); }
  .dif-visual-flow.is-live .flow-src .flow-ic { background: rgba(245, 241, 232, 0.08); color: rgba(245, 241, 232, 0.75); }
  .dif-visual-flow.is-live .flow-src.is-lit {
    border-color: rgba(212, 175, 55, 0.8);
    color: var(--ivory);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.25), 0 0 0 4px rgba(212, 175, 55, 0.1), 0 0 24px rgba(212, 175, 55, 0.35);
    transform: translateY(-50%) translateX(3px);
  }
  .dif-visual-flow.is-live .flow-src.is-lit .flow-ic { background: linear-gradient(135deg, var(--gold), var(--gold-l)); color: #041D17; }
  .dif-visual-flow.is-live .flow-toast {
    opacity: 0;
    transform: translateY(8px) scale(0.96);
    transition: opacity 0.4s var(--ease), transform 0.5s var(--ease);
  }
  .dif-visual-flow.is-live .flow-toast.is-shown { opacity: 1; transform: none; }

  /* --------------------------------------------------------------------------
     RESPONSIVO
     -------------------------------------------------------------------------- */
  /* Telas baixas (notebooks): card mais compacto para caber inteiro */
  @media (min-width: 1025px) and (max-height: 820px) {
    .dif-card { padding: 26px 30px; gap: 18px; border-radius: 26px; }
    .dif-card-num { margin-bottom: 10px; padding: 4px 10px 4px 7px; font-size: 10px; }
    .dif-card-title { font-size: clamp(24px, 2.2vw, 32px); margin-bottom: 10px; }
    .dif-card-desc { font-size: 15px; line-height: 1.5; }
    .dif-card-mark { font-size: 130px; }
    .chat-head { padding: 9px 14px; }
    .chat-avatar { width: 34px; height: 34px; }
    .chat-body { padding: 10px 14px; gap: 6px; }
    .chat-msg { font-size: 13px; padding: 7px 11px 5px; }
    .dif-visual-tailor { padding: 38px 14px 14px; }
    .tl-layer { gap: 8px; padding: 10px 14px; }
    .tl-grid i { height: 20px; }
  }
  @media (min-width: 1025px) and (max-height: 660px) {
    .dif-card-desc { font-size: 14px; }
    .dif-card-title br { display: none; }
    .dif-card-title em { margin-left: 0.25em; }
    .tl-grid { display: none; }
    .flow-col-out { top: calc(55% - 46px); }
  }
  @media (max-width: 1024px) {
    .dif-wrap { grid-template-columns: 1fr; gap: 40px; }
    .dif-intro-inner { position: static; }
    .dif-index { display: none; }
    .dif-lead { margin-bottom: 0; }
    .dif-card { top: calc(88px + var(--i) * 14px); height: auto; }
    .dif-visual-chat { height: 260px; } /* altura fixa: as mensagens entrando não mudam o tamanho do card */
    .dif-visual-flow { height: 270px; }
    .tl-stage { flex: none; height: 176px; }
  }

  @media (max-width: 640px) {
    .diferencial-section { padding: 72px 0 64px; }
    .dif-card { padding: 22px 18px; border-radius: 24px; gap: 20px; }
    .dif-card-mark { font-size: 110px; top: -10px; right: 10px; }
    .dif-visual { min-height: 230px; border-radius: 16px; }
    .chat-head { padding: 10px 12px; gap: 10px; }
    .chat-head .dif-illus { display: none; }
    .chat-who small::after { content: ' · exemplo de conversa'; color: rgba(245, 241, 232, 0.66); }
    .chat-body { padding: 12px; }
    .chat-msg { font-size: 13px; max-width: 86%; }
    .dif-visual-tailor { grid-template-columns: 1fr; padding: 42px 12px 12px; }
    .tl-tools { grid-auto-flow: column; grid-auto-columns: auto; justify-content: start; gap: 6px; padding-left: 6px; }
    .tl-tool { padding: 6px 9px 6px 6px; font-size: 11px; gap: 6px; }
    .tl-stage { height: 160px; }
    .tl-cursor { display: none; }
    .dif-visual-flow { height: 260px; }
    .flow-src { font-size: 11px; padding: 4px 7px 4px 4px; gap: 6px; border-radius: 10px; }
    .flow-ic { width: 20px; height: 20px; border-radius: 6px; }
    .flow-ic svg { width: 12px; height: 12px; }
    .flow-hub { font-size: 11.5px; padding: 6px 7px 6px 6px; gap: 6px; }
    .flow-hub-ic { width: 24px; height: 24px; border-radius: 8px; }
    .flow-hub-ic svg { width: 14px; height: 14px; }
    .flow-toast { top: calc(55% + 26px); padding: 6px 8px; }
    .flow-toast b, .flow-toast small { font-size: 10.5px; }
    .flow-col-out { top: calc(55% - 40px); }
  }

  @media (prefers-reduced-motion: reduce) {
    .dif-card { transform: none !important; filter: none !important; transition: none !important; }
    .dif-card .dif-card-rim i,
    .dif-card .dif-card-num i::after,
    .dif-card .chat-dot::after,
    .dif-card .tl-clip,
    .dif-card .tl-brand,
    .dif-card .tl-tool,
    .dif-card .tl-cursor,
    .chat-typing i { animation: none !important; }
    .tl-scan, .tl-cursor { display: none; }
  }
</style>

<script>
  // Cards empilháveis: o card de trás encolhe e escurece quando o próximo o cobre;
  // cada card "acende" (is-in) ao chegar ao topo e só anima (is-run) enquanto está na tela.
  const initDiferencial = () => {
    const section = document.getElementById('diferencial');
    if (!section) return;
    const cards = Array.from(section.querySelectorAll<HTMLElement>('.dif-card'));
    const indexItems = Array.from(section.querySelectorAll<HTMLElement>('[data-dif-index]'));
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
    let raf = 0;
    let onCover: ((card: HTMLElement) => void) | null = null;

    /* ---------- Empilhamento ---------- */
    const update = () => {
      raf = 0;
      const vh = window.innerHeight;
      let active = 0;
      cards.forEach((card, i) => {
        const r = card.getBoundingClientRect();
        if (r.top < vh * 0.7) {
          card.classList.add('is-in');
          active = i;
        }
        const next = cards[i + 1];
        let cover = 0;
        if (next) {
          const nr = next.getBoundingClientRect();
          cover = Math.min(1, Math.max(0, (r.bottom - nr.top) / Math.max(1, r.height)));
        }
        const covered = cover > 0.45 ? '1' : '0';
        if (card.dataset.cover !== covered) {
          card.dataset.cover = covered;
          onCover?.(card);
        }
        if (!reduced) {
          card.style.setProperty('--stack-scale', (1 - cover * 0.06).toFixed(4));
          card.style.setProperty('--stack-dim', cover.toFixed(4));
        }
      });
      indexItems.forEach((li, i) => li.classList.toggle('is-active', i === active));
    };
    const schedule = () => {
      if (!raf) raf = requestAnimationFrame(update);
    };
    window.addEventListener('scroll', schedule, { passive: true });
    window.addEventListener('resize', schedule);
    update();

    if (reduced) return;

    /* ---------- Holofote + leve inclinação 3D (só mouse) ---------- */
    if (finePointer) {
      cards.forEach((card) => {
        card.addEventListener('pointermove', (e) => {
          if (card.dataset.cover === '1') return;
          const r = card.getBoundingClientRect();
          const x = (e.clientX - r.left) / r.width;
          const y = (e.clientY - r.top) / r.height;
          card.classList.add('is-tilting');
          card.style.setProperty('--mx', `${(x * 100).toFixed(1)}%`);
          card.style.setProperty('--my', `${(y * 100).toFixed(1)}%`);
          card.style.setProperty('--spot', '1');
          card.style.setProperty('--ry', `${((x - 0.5) * 4).toFixed(2)}deg`);
          card.style.setProperty('--rx', `${((0.5 - y) * 3).toFixed(2)}deg`);
        });
        card.addEventListener('pointerleave', () => {
          card.classList.remove('is-tilting');
          card.style.setProperty('--spot', '0');
          card.style.setProperty('--rx', '0deg');
          card.style.setProperty('--ry', '0deg');
        });
      });
    }

    /* ---------- Cena 1: conversa que acontece em tempo real ---------- */
    const makeChat = (root: HTMLElement) => {
      const msgs = Array.from(root.querySelectorAll<HTMLElement>('.chat-msg'));
      const typing = root.querySelector<HTMLElement>('[data-chat-typing]');
      const status = root.querySelector<HTMLElement>('[data-chat-status]');
      const body = root.querySelector<HTMLElement>('[data-chat-body]');
      if (!typing || !body) return null;
      root.classList.add('is-live');
      let timers: number[] = [];
      let running = false;
      const at = (ms: number, fn: () => void) => timers.push(window.setTimeout(fn, ms));
      const clear = () => { timers.forEach(clearTimeout); timers = []; };
      const reset = () => {
        msgs.forEach((m) => m.classList.remove('is-shown', 'is-read'));
        typing.classList.remove('is-shown', 'is-out');
        if (status) status.textContent = 'online';
      };
      const showTyping = (out: boolean) => {
        typing.classList.toggle('is-out', out);
        typing.classList.remove('is-shown');
        void typing.offsetWidth;
        typing.classList.add('is-shown');
        body.appendChild(typing);
        if (status) status.textContent = out ? 'digitando…' : 'online';
      };
      const hideTyping = () => {
        typing.classList.remove('is-shown');
        if (status) status.textContent = 'online';
      };
      const show = (i: number) => {
        hideTyping();
        msgs[i]?.classList.add('is-shown');
      };
      const cycle = () => {
        clear();
        reset();
        let t = 300;
        at(t, () => show(0));
        t += 900; at(t, () => showTyping(true));
        t += 1500; at(t, () => show(1));
        t += 700; at(t, () => msgs[1]?.classList.add('is-read'));
        t += 700; at(t, () => showTyping(false));
        t += 1300; at(t, () => show(2));
        t += 800; at(t, () => showTyping(true));
        t += 1500; at(t, () => show(3));
        t += 700; at(t, () => msgs[3]?.classList.add('is-read'));
        t += 3600; at(t, () => { if (running) cycle(); });
      };
      return {
        start() { if (running) return; running = true; cycle(); },
        stop() {
          running = false;
          clear();
          // estado final completo enquanto pausado
          msgs.forEach((m) => m.classList.add('is-shown', 'is-read'));
          typing.classList.remove('is-shown');
          if (status) status.textContent = 'online';
        }
      };
    };

    /* ---------- Cena 3: cada frente de captação leva um contato ao WhatsApp ---------- */
    const makeFlow = (root: HTMLElement) => {
      const paths = Array.from(root.querySelectorAll<SVGPathElement>('[data-flow-path]'));
      const srcs = Array.from(root.querySelectorAll<HTMLElement>('[data-flow-src]'));
      const dot = root.querySelector<HTMLElement>('[data-flow-dot]');
      const hub = root.querySelector<HTMLElement>('[data-flow-hub]');
      const toast = root.querySelector<HTMLElement>('[data-flow-toast]');
      const msg = root.querySelector<HTMLElement>('[data-flow-msg]');
      if (!paths.length || !dot || !hub || !toast || !msg) return null;
      const lens = paths.map((p) => p.getTotalLength());
      const msgs = ['“Vi seu anúncio!”', '“Achei vocês no Google.”', '“Vim pelo seu site.”'];
      paths.forEach((p, i) => {
        p.style.strokeDasharray = `${lens[i]}`;
        p.style.strokeDashoffset = `${lens[i]}`;
      });
      root.classList.add('is-live');

      const TRAVEL = 1300;
      const HOLD = 1500;
      const STEP = TRAVEL + HOLD;
      const TOTAL = STEP * paths.length;
      let frame = 0;
      let t0 = 0;
      let running = false;
      let lastHit = -1;
      const ease = (x: number) => (x < 0.5 ? 2 * x * x : 1 - Math.pow(-2 * x + 2, 2) / 2);

      const draw = (now: number) => {
        if (!running) return;
        if (!t0) t0 = now;
        const t = (now - t0) % TOTAL;
        const i = Math.floor(t / STEP);
        const local = t - i * STEP;
        const p = Math.min(1, local / TRAVEL);
        const k = ease(p);
        paths.forEach((path, j) => {
          const off = j === i ? lens[j] * (1 - k) : lens[j];
          path.style.strokeDashoffset = `${off}`;
          path.style.opacity = j === i && local > TRAVEL + HOLD - 350 ? '0' : '1';
        });
        srcs.forEach((s, j) => s.classList.toggle('is-lit', j === i));
        if (p < 1) {
          const pt = paths[i].getPointAtLength(lens[i] * k);
          dot.style.left = `${((pt.x / 320) * 100).toFixed(2)}%`;
          dot.style.top = `${((pt.y / 240) * 100).toFixed(2)}%`;
          dot.style.opacity = '1';
          if (local < 80) toast.classList.remove('is-shown');
        } else {
          dot.style.opacity = '0';
          if (lastHit !== i) {
            lastHit = i;
            msg.textContent = msgs[i] || msgs[0];
            hub.classList.remove('is-hit');
            void hub.offsetWidth;
            hub.classList.add('is-hit');
            toast.classList.add('is-shown');
          }
        }
        if (p < 1 && lastHit === i) lastHit = -1;
        frame = requestAnimationFrame(draw);
      };
      return {
        start() {
          if (running) return;
          running = true;
          t0 = 0;
          lastHit = -1;
          frame = requestAnimationFrame(draw);
        },
        stop() {
          running = false;
          cancelAnimationFrame(frame);
          paths.forEach((p) => { p.style.strokeDashoffset = '0'; p.style.opacity = '1'; });
          srcs.forEach((s) => s.classList.add('is-lit'));
          dot.style.opacity = '0';
          msg.textContent = msgs[0];
          toast.classList.add('is-shown');
        }
      };
    };

    type Scene = { start(): void; stop(): void } | null;
    const scenes = new Map<HTMLElement, Scene>();
    cards.forEach((card) => {
      const chat = card.querySelector<HTMLElement>('.dif-visual-chat');
      const flow = card.querySelector<HTMLElement>('[data-flow]');
      const tailor = card.querySelector<HTMLElement>('.dif-visual-tailor');
      if (tailor) tailor.style.setProperty('--tw', `${tailor.clientWidth}px`);
      const scene = chat ? makeChat(chat) : flow ? makeFlow(flow) : null;
      scene?.stop();
      scenes.set(card, scene);
    });

    window.addEventListener('resize', () => {
      section.querySelectorAll<HTMLElement>('.dif-visual-tailor').forEach((t) => t.style.setProperty('--tw', `${t.clientWidth}px`));
    });

    const setRunning = (card: HTMLElement, on: boolean) => {
      if (card.classList.contains('is-run') === on && card.dataset.sceneInit) return;
      card.dataset.sceneInit = '1';
      card.classList.toggle('is-run', on);
      const s = scenes.get(card);
      if (on) s?.start();
      else s?.stop();
    };

    const visible = new Set<HTMLElement>();
    const refresh = (card: HTMLElement) =>
      setRunning(card, visible.has(card) && !document.hidden && card.dataset.cover !== '1');
    onCover = refresh;
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          const card = e.target as HTMLElement;
          if (e.isIntersecting && e.intersectionRatio > 0.3) visible.add(card);
          else visible.delete(card);
          refresh(card);
        });
      },
      { threshold: [0, 0.3, 0.6] }
    );
    cards.forEach((c) => io.observe(c));
    new IntersectionObserver(([e]) => section.classList.toggle('is-visible', e.isIntersecting)).observe(section);
    document.addEventListener('visibilitychange', () => {
      cards.forEach(refresh);
    });
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initDiferencial);
  } else {
    initDiferencial();
  }
</script>
